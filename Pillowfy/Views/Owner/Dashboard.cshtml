        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Bonjour, <em id="firstName">...</em> 👋</h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <div class="badge-online"><span class="badge-dot"></span> Propriétaire</div>
                    <button class="btn btn-danger" onclick="logout()">
                        <i data-lucide="log-out"></i> Déconnexion
                    </button>
                </div>
            </div>

            <!-- HERO -->
            <div class="hero-card">
                <div class="hero-text">
                    <div class="hero-tag"><i data-lucide="building-2"></i> Espace propriétaire</div>
                    <h2>Gérez vos <em>établissements</em></h2>
                    <p>Suivez vos réservations, revenus et taux d'occupation en temps réel.</p>
                </div>
                <div class="hero-actions">
                    <a href="/Owner/Hotels/Ajouter" class="btn btn-teal">
                        <i data-lucide="plus"></i> Ajouter un hôtel
                    </a>
                    <a href="/Owner/Reservations" class="btn btn-outline">
                        <i data-lucide="calendar-check"></i> Réservations
                    </a>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrap teal"><i data-lucide="building-2"></i></div>
                    <div>
                        <div class="stat-label">Mes hôtels</div>
                        <div class="stat-value" id="statHotels"><span class="skeleton" style="width:40px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Établissements actifs</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap gold"><i data-lucide="calendar-check"></i></div>
                    <div>
                        <div class="stat-label">Réservations</div>
                        <div class="stat-value" id="statReservations"><span class="skeleton" style="width:40px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Ce mois-ci</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap green"><i data-lucide="trending-up"></i></div>
                    <div>
                        <div class="stat-label">Revenus</div>
                        <div class="stat-value" id="statRevenus"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Total ce mois</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap rose"><i data-lucide="percent"></i></div>
                    <div>
                        <div class="stat-label">Taux occupation</div>
                        <div class="stat-value" id="statOccupancy"><span class="skeleton" style="width:60px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Moyenne hôtels</div>
                    </div>
                </div>
            </div>

            <!-- OCCUPATION + REVENUS + ACTIONS -->
            <div class="main-grid" style="margin-bottom:1rem;">

                <!-- OCCUPATION -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Taux d'occupation</span>
                        <a href="/Owner/Hotels" class="card-link">Détails →</a>
                    </div>
                    <div id="occupancyList">
                        <div class="skeleton" style="height:14px;width:60%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:5px;width:100%;margin-bottom:16px;"></div>
                        <div class="skeleton" style="height:14px;width:50%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:5px;width:100%;"></div>
                    </div>
                </div>

                <!-- REVENUS PAR MOIS -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Revenus mensuels</span>
                        <a href="/Owner/Revenus" class="card-link">Voir tout →</a>
                    </div>
                    <div id="revenusChart">
                        <div class="skeleton" style="height:100px;width:100%;border-radius:10px;"></div>
                    </div>
                </div>

                <!-- ACTIONS RAPIDES -->
                <div class="card">
                    <div class="card-header"><span class="card-title">Actions rapides</span></div>
                    <a href="/Owner/Hotels/Ajouter" class="quick-action">
                        <div class="qa-icon"><i data-lucide="plus-circle"></i></div>
                        <div><div class="qa-label">Ajouter un hôtel</div><div class="qa-sub">Nouvel établissement</div></div>
                        <span class="qa-arrow"><i data-lucide="chevron-right"></i></span>
                    </a>
                    <a href="/Owner/Chambres/Ajouter" class="quick-action">
                        <div class="qa-icon"><i data-lucide="bed-double"></i></div>
                        <div><div class="qa-label">Ajouter une chambre</div><div class="qa-sub">Nouvelle chambre</div></div>
                        <span class="qa-arrow"><i data-lucide="chevron-right"></i></span>
                    </a>
                    <a href="/Owner/Reservations" class="quick-action">
                        <div class="qa-icon"><i data-lucide="calendar-check"></i></div>
                        <div><div class="qa-label">Voir réservations</div><div class="qa-sub">Gérer les demandes</div></div>
                        <span class="qa-arrow"><i data-lucide="chevron-right"></i></span>
                    </a>
                    <a href="/Owner/Revenus" class="quick-action">
                        <div class="qa-icon"><i data-lucide="trending-up"></i></div>
                        <div><div class="qa-label">Mes revenus</div><div class="qa-sub">Statistiques détaillées</div></div>
                        <span class="qa-arrow"><i data-lucide="chevron-right"></i></span>
                    </a>
                    <button class="quick-action" onclick="logout()">
                        <div class="qa-icon" style="color:var(--rose);"><i data-lucide="log-out"></i></div>
                        <div><div class="qa-label" style="color:var(--rose);">Se déconnecter</div><div class="qa-sub">Fermer la session</div></div>
                        <span class="qa-arrow"><i data-lucide="chevron-right"></i></span>
                    </button>
                </div>
            </div>

            <!-- RÉSERVATIONS + CHAMBRES -->
            <div class="main-grid-wide" style="margin-bottom:1rem;">

                <!-- DERNIÈRES RÉSERVATIONS -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Dernières réservations</span>
                        <a href="/Owner/Reservations" class="card-link">Voir tout →</a>
                    </div>
                    <div id="reservationsList">
                        <div class="skeleton" style="height:42px;width:100%;margin-bottom:8px;border-radius:8px;"></div>
                        <div class="skeleton" style="height:42px;width:100%;margin-bottom:8px;border-radius:8px;"></div>
                        <div class="skeleton" style="height:42px;width:100%;border-radius:8px;"></div>
                    </div>
                </div>

                <!-- MES CHAMBRES -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Mes chambres</span>
                        <a href="/Owner/Chambres" class="card-link">Gérer →</a>
                    </div>
                    <div id="chambresList">
                        <div class="skeleton" style="height:56px;width:100%;margin-bottom:10px;border-radius:10px;"></div>
                        <div class="skeleton" style="height:56px;width:100%;margin-bottom:10px;border-radius:10px;"></div>
                        <div class="skeleton" style="height:56px;width:100%;border-radius:10px;"></div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <script>
        /* ════════════════════════════════════
           SESSION MANAGER (identique Customer)
        ════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', REFRESH_TOKEN_KEY: 'pillowfy_refresh',
            COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            REFRESH_URL: '/api/auth/refresh', REFRESH_THRESHOLD: 5 * 60,
            CHECK_INTERVAL: 60 * 1000, WARN_BEFORE: 2 * 60,
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role',
            },
            _heartbeatTimer: null, _warnShown: false,
            getToken()        { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            getRefreshToken() { return this._readCookie('refresh_token')  || localStorage.getItem(this.REFRESH_TOKEN_KEY); },
            saveToken(token)  { localStorage.setItem(this.TOKEN_KEY, token); },
            clearSession() {
                localStorage.removeItem(this.TOKEN_KEY); localStorage.removeItem(this.REFRESH_TOKEN_KEY);
                document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`;
                document.cookie = `refresh_token=; Max-Age=0; path=/; SameSite=Strict`;
                if (this._heartbeatTimer) clearInterval(this._heartbeatTimer);
            },
            parseJwt(token) {
                try { return JSON.parse(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); }
                catch { return null; }
            },
            secondsLeft(p) { if (!p?.exp) return Infinity; return p.exp - Math.floor(Date.now() / 1000); },
            async tryRefresh() {
                const rt = this.getRefreshToken(); if (!rt) return false;
                try {
                    const res = await fetch(this.REFRESH_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({refreshToken:rt}), credentials:'include' });
                    if (!res.ok) return false;
                    const data = await res.json();
                    if (data.token) { this.saveToken(data.token); return true; }
                    return false;
                } catch { return false; }
            },
            async check() {
                const token = this.getToken(); if (!token) { this.redirectLogin('no_token'); return false; }
                const p = this.parseJwt(token); if (!p) { this.redirectLogin('invalid_token'); return false; }
                // Vérification rôle Owner
                const role = p[this.CLAIMS.role];
                if (role !== 'Owner') { this.redirectLogin('unauthorized_role'); return false; }
                const left = this.secondsLeft(p);
                if (left <= 0) { const r = await this.tryRefresh(); if (!r) { this.redirectLogin('expired'); return false; } return true; }
                if (left < this.REFRESH_THRESHOLD) this.tryRefresh();
                return true;
            },
            redirectLogin(reason) {
                this.clearSession();
                const url = new URL(this.LOGIN_URL, window.location.origin);
                url.searchParams.set('reason', reason); url.searchParams.set('returnUrl', window.location.pathname);
                window.location.href = url.toString();
            },
            startHeartbeat() {
                if (this._heartbeatTimer) clearInterval(this._heartbeatTimer);
                this._heartbeatTimer = setInterval(() => this.check(), this.CHECK_INTERVAL);
                document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') this.check(); });
            },
            _readCookie(name) {
                const m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                return m ? decodeURIComponent(m[2]) : null;
            }
        };

        /* ════════════════════════════════════
           DATE
        ════════════════════════════════════ */
        (function () {
            const now = new Date();
            const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const mois  = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent =
                jours[now.getDay()] + ' ' + now.getDate() + ' ' + mois[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ════════════════════════════════════
           HELPERS
        ════════════════════════════════════ */
        const fmt = d => new Date(d).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });

        function statusBadge(status) {
            const map = {
                'Confirmed': { cls:'confirmed', label:'↗ Confirmée' },
                'Cancelled': { cls:'cancelled', label:'✕ Annulée'  },
                'Completed': { cls:'completed', label:'✓ Terminée' },
                'Pending':   { cls:'pending',   label:'⏳ En attente' },
            };
            const s = map[status] || { cls:'pending', label: status };
            return `<span class="badge ${s.cls}">${s.label}</span>`;
        }

        /* ════════════════════════════════════
           LOAD USER
        ════════════════════════════════════ */
        async function loadUser() {
            const ok = await SESSION.check(); if (!ok) return;
            const token = SESSION.getToken();
            const p = SESSION.parseJwt(token);
            const fullName  = p[SESSION.CLAIMS.name]  || '';
            const firstName = fullName.split(' ')[0]  || 'Propriétaire';
            document.getElementById('firstName').textContent     = firstName;
            document.getElementById('userName').textContent      = fullName || p[SESSION.CLAIMS.email];
            document.getElementById('avatarInitial').textContent = firstName.charAt(0).toUpperCase();
            SESSION.startHeartbeat();
            await loadOwnerData(token);
        }

        /* ════════════════════════════════════
           LOAD OWNER DATA
        ════════════════════════════════════ */
        async function loadOwnerData(token) {
            const headers = { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' };

            try {
                const [dashRes, occRes] = await Promise.all([
                    fetch('/api/owner/dashboard', { headers, credentials:'include' }),
                    fetch('/api/owner/hotels/occupancy', { headers, credentials:'include' }),
                ]);

                if (dashRes.status === 401) { SESSION.redirectLogin('unauthorized'); return; }

                /* ── DASHBOARD ── */
                if (dashRes.ok) {
                    const dash = await dashRes.json();

                    // Stats
                    document.getElementById('statHotels').textContent      = dash.hotelsTotal        ?? '—';
                    document.getElementById('statReservations').textContent = dash.reservationsMois   ?? '—';
                    document.getElementById('statRevenus').textContent      = dash.revenusMois != null
                        ? dash.revenusMois.toLocaleString('fr-FR') + ' €' : '—';
                    document.getElementById('statOccupancy').textContent    = dash.tauxOccupationMoyen != null
                        ? dash.tauxOccupationMoyen + '%' : '—';

                    // Badge sidebar
                    const badge = document.getElementById('nbReservations');
                    if (badge) {
                        const nb = dash.reservationsEnAttente ?? 0;
                        badge.textContent   = nb;
                        badge.style.display = nb > 0 ? '' : 'none';
                    }

                    /* ── RÉSERVATIONS TABLE ── */
                    const resList = document.getElementById('reservationsList');
                    if (resList) {
                        const reservations = dash.dernieresReservations ?? [];
                        if (!reservations.length) {
                            resList.innerHTML = `<div class="empty-state"><i data-lucide="calendar-x"></i><p>Aucune réservation pour le moment.</p></div>`;
                        } else {
                            resList.innerHTML = `
                                <table class="res-table">
                                    <thead>
                                        <tr>
                                            <th>Client</th>
                                            <th>Chambre</th>
                                            <th>Arrivée</th>
                                            <th>Nuits</th>
                                            <th>Montant</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${reservations.map(r => {
                                            const nights = Math.max(1, Math.round((new Date(r.checkOut) - new Date(r.checkIn)) / 86400000));
                                            return `<tr>
                                                <td style="font-weight:600;">${r.clientName || '—'}</td>
                                                <td style="color:var(--ink-60);">${r.chambreName}</td>
                                                <td style="color:var(--ink-60);">${fmt(r.checkIn)}</td>
                                                <td style="text-align:center;">${nights}</td>
                                                <td style="font-weight:700;">${r.totalPrice.toLocaleString('fr-FR')} €</td>
                                                <td>${statusBadge(r.status)}</td>
                                            </tr>`;
                                        }).join('')}
                                    </tbody>
                                </table>`;
                        }
                        lucide.createIcons();
                    }

                    /* ── REVENUS CHART ── */
                    const chartDiv = document.getElementById('revenusChart');
                    if (chartDiv && dash.revenusMensuels?.length) {
                        const maxVal = Math.max(...dash.revenusMensuels.map(m => m.montant), 1);
                        chartDiv.innerHTML = `
                            <div class="rev-bars">
                                ${dash.revenusMensuels.map(m => {
                                    const h = Math.round((m.montant / maxVal) * 100);
                                    return `<div class="rev-bar-wrap">
                                        <div class="rev-bar-val">${m.montant >= 1000 ? (m.montant/1000).toFixed(1)+'k' : m.montant}€</div>
                                        <div class="rev-bar" data-h="${h}" style="height:4px;"></div>
                                        <div class="rev-bar-lbl">${m.mois}</div>
                                    </div>`;
                                }).join('')}
                            </div>`;
                        setTimeout(() => {
                            chartDiv.querySelectorAll('.rev-bar').forEach(el => {
                                el.style.height = el.dataset.h + 'px';
                            });
                        }, 300);
                    } else if (chartDiv) {
                        chartDiv.innerHTML = `<div class="empty-state"><i data-lucide="trending-up"></i><p>Données de revenus indisponibles.</p></div>`;
                        lucide.createIcons();
                    }

                    /* ── CHAMBRES ── */
                    const chambresList = document.getElementById('chambresList');
                    if (chambresList) {
                        const chambres = dash.mesChambresDispo ?? [];
                        if (!chambres.length) {
                            chambresList.innerHTML = `<div class="empty-state"><i data-lucide="bed-double"></i><p>Aucune chambre enregistrée.</p></div>`;
                        } else {
                            chambresList.innerHTML = chambres.slice(0, 5).map(c => `
                                <div class="chambre-item" onclick="window.location='/Owner/Chambres/${c.id}'">
                                    <div class="chambre-thumb">
                                        ${c.imageUrl ? `<img src="${c.imageUrl}" alt="">` : `<span style="font-size:1.2rem;">🛏️</span>`}
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <div class="chambre-name">${c.name}</div>
                                        <div class="chambre-meta">${c.hotelName ?? '—'} · ${c.capacity} pers.</div>
                                        <span class="chambre-status ${c.isAvailable ? 'available' : 'occupied'}">
                                            ${c.isAvailable ? '✓ Disponible' : '● Occupée'}
                                        </span>
                                    </div>
                                    <div class="chambre-price">
                                        <div class="chambre-price-val">${c.pricePerNight.toLocaleString('fr-FR')} €</div>
                                        <div class="chambre-price-lbl">/ nuit</div>
                                    </div>
                                </div>`).join('');
                        }
                        lucide.createIcons();
                    }
                }

                /* ── OCCUPATION ── */
                const occList = document.getElementById('occupancyList');
                if (occList) {
                    const colors = ['teal','gold','green','rose'];
                    if (occRes.ok) {
                        const occ = await occRes.json();
                        if (!occ.length) {
                            occList.innerHTML = `<div class="empty-state"><i data-lucide="building-2"></i><p>Aucun hôtel enregistré.</p></div>`;
                        } else {
                            occList.innerHTML = occ.map((o, i) => `
                                <div class="occ-item">
                                    <div class="occ-header">
                                        <span class="occ-hotel">${o.hotelName}</span>
                                        <span class="occ-pct">${o.occupancyRate}%</span>
                                    </div>
                                    <div class="occ-bar">
                                        <div class="occ-bar-fill ${colors[i % colors.length]}" style="width:0%;" data-width="${o.occupancyRate}%"></div>
                                    </div>
                                </div>`).join('');
                            setTimeout(() => {
                                occList.querySelectorAll('.occ-bar-fill').forEach(el => { el.style.width = el.dataset.width; });
                            }, 300);
                        }
                    } else {
                        occList.innerHTML = `<div class="empty-state"><i data-lucide="wifi-off"></i><p>Données indisponibles.</p></div>`;
                    }
                    lucide.createIcons();
                }

            } catch (e) {
                console.error('[Owner Dashboard] Erreur :', e);
            }
        }

        /* ════════════════════════════════════
           DÉCONNEXION
        ════════════════════════════════════ */
        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) {
                    await fetch('/api/auth/logout', {
                        method:'POST', headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'}, credentials:'include'
                    }).catch(() => {});
                }
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        /* ════════════════════════════════════
           INIT
        ════════════════════════════════════ */
        function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();
            loadUser();
        }
        document.readyState === 'loading'
            ? document.addEventListener('DOMContentLoaded', init)
            : init();
    </script>
</body>
</html>