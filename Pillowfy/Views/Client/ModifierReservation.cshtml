@{
    ViewData["Title"] = "Modifier la réservation";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Modifier réservation</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            gap: 10px;
        }

        /* BREADCRUMB */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: var(--ink-60);
            margin-bottom: 1.6rem;
        }

            .breadcrumb a {
                color: var(--gold);
                text-decoration: none;
                font-weight: 600;
            }

                .breadcrumb a:hover {
                    text-decoration: underline;
                }

            .breadcrumb svg {
                width: 12px;
                height: 12px;
            }

        /* GRID PRINCIPAL */
        .modify-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 1.4rem;
            align-items: start;
        }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,169,110,0.3);
            }

            .btn-gold:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

        .btn-outline-ink {
            background: transparent;
            color: var(--ink-60);
            border: 1px solid rgba(15,22,33,0.15);
        }

            .btn-outline-ink:hover {
                background: rgba(15,22,33,0.05);
            }

        .btn-danger {
            background: rgba(220,38,38,0.10);
            color: #f87171;
            border: 1px solid rgba(220,38,38,0.25);
        }

            .btn-danger:hover {
                background: rgba(220,38,38,0.20);
            }

        /* CARD */
        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.6rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            margin-bottom: 1.2rem;
        }

            .card:last-child {
                margin-bottom: 0;
            }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.4rem;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .card-icon.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .card-icon.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .card-icon svg {
                width: 18px;
                height: 18px;
            }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
        }

        .card-subtitle {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* RÉSERVATION ACTUELLE */
        .current-res {
            background: var(--ink);
            border-radius: 16px;
            padding: 1.3rem;
            margin-bottom: 1.4rem;
            position: relative;
            overflow: hidden;
        }

            .current-res::before {
                content: '';
                position: absolute;
                right: -30px;
                top: -50px;
                width: 160px;
                height: 160px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.15) 0%, transparent 70%);
            }

        .current-res-label {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 6px;
        }

        .current-res-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
            margin-bottom: 4px;
        }

        .current-res-chambre {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.45);
            margin-bottom: 10px;
        }

        .current-res-dates {
            display: flex;
            gap: 16px;
        }

        .crd {
            display: flex;
            flex-direction: column;
        }

        .crd-label {
            font-size: 0.65rem;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .crd-val {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--gold);
            margin-top: 1px;
        }

        /* FORMULAIRE */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 1rem;
        }

        .form-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 0.9rem;
            border-radius: 11px;
            border: 1.5px solid rgba(15,22,33,0.10);
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.86rem;
            color: var(--ink);
            transition: all .16s;
            outline: none;
        }

            .form-input:focus {
                border-color: rgba(201,169,110,0.5);
                background: var(--white);
                box-shadow: 0 0 0 3px rgba(201,169,110,0.08);
            }

            .form-input.error {
                border-color: rgba(192,89,106,0.5);
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-error {
            font-size: 0.72rem;
            color: var(--rose);
            display: none;
            margin-top: 2px;
        }

            .form-error.show {
                display: block;
            }

        .form-hint {
            font-size: 0.7rem;
            color: var(--ink-60);
        }

        /* RÉCAP PRIX */
        .price-recap {
            background: var(--bg);
            border-radius: 14px;
            padding: 1.1rem;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.06);
        }

            .price-row:last-child {
                border-bottom: none;
            }

        .price-label {
            font-size: 0.8rem;
            color: var(--ink-60);
        }

        .price-val {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--ink);
        }

        .price-total .price-label {
            font-weight: 700;
            color: var(--ink);
            font-size: 0.9rem;
        }

        .price-total .price-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--gold);
        }

        /* ALERTE DATES */
        .alert {
            display: none;
            padding: 0.8rem 1rem;
            border-radius: 11px;
            font-size: 0.82rem;
            font-weight: 500;
            margin-bottom: 1rem;
            align-items: center;
            gap: 8px;
        }

            .alert.show {
                display: flex;
            }

            .alert svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .alert-warning {
            background: var(--gold-lt);
            color: #7A5E1A;
            border: 1px solid rgba(201,169,110,0.3);
        }

        .alert-error {
            background: var(--rose-lt);
            color: var(--rose);
            border: 1px solid rgba(192,89,106,0.25);
        }

        .alert-success {
            background: rgba(34,197,94,0.10);
            color: #15803d;
            border: 1px solid rgba(34,197,94,0.25);
        }

        /* CARD STICKY DROITE */
        .summary-card {
            position: sticky;
            top: 2rem;
        }

        .summary-section {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.4rem 1.6rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
        }

        .summary-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
            margin-bottom: 1rem;
        }

        .summary-thumb {
            width: 100%;
            height: 140px;
            border-radius: 13px;
            object-fit: cover;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin-bottom: 1rem;
            overflow: hidden;
        }

            .summary-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.45rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .summary-row:last-child {
                border-bottom: none;
            }

        .summary-lbl {
            font-size: 0.76rem;
            color: var(--ink-60);
        }

        .summary-val {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .summary-total {
            margin-top: 1rem;
            padding: 0.9rem 1rem;
            background: var(--ink);
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .summary-total-label {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.5);
        }

        .summary-total-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.25rem;
            color: var(--gold);
        }

        /* SKELETON */
        .skeleton {
            background: linear-gradient(90deg,rgba(15,22,33,0.06) 25%,rgba(15,22,33,0.10) 50%,rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 6px;
        }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            background: var(--ink);
            color: var(--white);
            border-radius: 13px;
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.84rem;
            font-weight: 500;
            box-shadow: var(--shadow-md);
            opacity: 0;
            transform: translateY(10px);
            transition: all .3s;
            pointer-events: none;
        }

            .toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .toast.success {
                border-left: 3px solid #22c55e;
            }

            .toast.error {
                border-left: 3px solid var(--rose);
            }

            .toast svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0
            }

            100% {
                background-position: -200% 0
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .main > * {
            animation: fadeUp 0.38s ease both;
        }

            .main > *:nth-child(2) {
                animation-delay: 0.05s;
            }

            .main > *:nth-child(3) {
                animation-delay: 0.10s;
            }

        @@media (max-width: 1000px) {
            .modify-grid {
                grid-template-columns: 1fr;
            }

            .summary-card {
                position: static;
            }
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }
        }

        @@media (max-width: 600px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="sidebar-content">
                <div class="sidebar-section-label">Navigation</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                    <a href="/Client/ListeHotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Hôtels</a>
                    <a href="/Client/ListeReservations" class="nav-item active"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Mes réservations</a>
                    <a href="/Client/Sejours" class="nav-item"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Historique séjours</a>
                    <a href="/Client/Factures" class="nav-item"><span class="nav-icon"><i data-lucide="receipt"></i></span> Factures</a>
                    <a href="/Client/Services" class="nav-item"><span class="nav-icon"><i data-lucide="concierge-bell"></i></span> Services</a>
                </nav>
                <div class="sidebar-section-label">Compte</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Profil" class="nav-item"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                    <a href="/Client/Fidelite" class="nav-item"><span class="nav-icon"><i data-lucide="star"></i></span> Fidélité</a>
                    <a href="/Client/Avis" class="nav-item"><span class="nav-icon"><i data-lucide="message-circle"></i></span> Mes avis</a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role" id="userRole">Client</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Modifier la <em>réservation</em></h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <a href="/Client/ListeReservations" class="btn btn-outline-ink"><i data-lucide="arrow-left"></i> Retour</a>
                    <button class="btn btn-danger" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
                </div>
            </div>

            <!-- BREADCRUMB -->
            <div class="breadcrumb">
                <a href="/Client/Dashboard">Dashboard</a>
                <i data-lucide="chevron-right"></i>
                <a href="/Client/ListeReservations">Mes réservations</a>
                <i data-lucide="chevron-right"></i>
                <span>Modifier</span>
            </div>

            <!-- ALERTE RESERVATION PASSEE -->
            <div class="alert alert-error" id="alertPast">
                <i data-lucide="alert-circle"></i>
                <span>Cette réservation est déjà passée et ne peut plus être modifiée.</span>
            </div>

            <!-- GRID -->
            <div class="modify-grid" id="mainContent" style="display:none;">

                <!-- COLONNE GAUCHE -->
                <div>

                    <!-- RÉSUMÉ ACTUEL -->
                    <div class="card">
                        <div class="card-header">
                            <div class="card-icon gold"><i data-lucide="calendar-check"></i></div>
                            <div>
                                <div class="card-title">Réservation actuelle</div>
                                <div class="card-subtitle" id="resIdLabel">—</div>
                            </div>
                        </div>
                        <div class="current-res">
                            <div class="current-res-label">Hôtel &amp; Chambre</div>
                            <div class="current-res-name" id="crHotel">—</div>
                            <div class="current-res-chambre" id="crChambre">—</div>
                            <div class="current-res-dates">
                                <div class="crd"><span class="crd-label">Arrivée</span><span class="crd-val" id="crCheckIn">—</span></div>
                                <div class="crd"><span class="crd-label">Départ</span><span class="crd-val" id="crCheckOut">—</span></div>
                                <div class="crd"><span class="crd-label">Durée</span><span class="crd-val" id="crNights">—</span></div>
                                <div class="crd"><span class="crd-label">Personnes</span><span class="crd-val" id="crGuests">—</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- FORMULAIRE MODIFICATION -->
                    <div class="card">
                        <div class="card-header">
                            <div class="card-icon teal"><i data-lucide="pencil"></i></div>
                            <div>
                                <div class="card-title">Nouvelles dates</div>
                                <div class="card-subtitle">Seules les réservations futures peuvent être modifiées</div>
                            </div>
                        </div>

                        <div class="alert alert-warning" id="alertOverlap">
                            <i data-lucide="alert-triangle"></i>
                            <span id="alertOverlapMsg">La chambre n'est pas disponible pour ces dates.</span>
                        </div>

                        <form id="modifyForm" onsubmit="submitModify(event)">
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Date d'arrivée</label>
                                    <input id="newCheckIn" class="form-input" type="date" oninput="onDatesChange()" />
                                    <span class="form-error" id="errCheckIn"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Date de départ</label>
                                    <input id="newCheckOut" class="form-input" type="date" oninput="onDatesChange()" />
                                    <span class="form-error" id="errCheckOut"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Nombre de personnes</label>
                                <input id="newGuests" class="form-input" type="number" min="1" max="10" oninput="updateSummary()" />
                                <span class="form-hint" id="guestHint"></span>
                                <span class="form-error" id="errGuests"></span>
                            </div>

                            <!-- RÉCAP PRIX -->
                            <div class="price-recap" id="priceRecap" style="display:none;">
                                <div class="price-row">
                                    <span class="price-label">Prix par nuit</span>
                                    <span class="price-val" id="pricePerNight">—</span>
                                </div>
                                <div class="price-row">
                                    <span class="price-label">Nombre de nuits</span>
                                    <span class="price-val" id="priceNights">—</span>
                                </div>
                                <div class="price-row price-total">
                                    <span class="price-label">Total estimé</span>
                                    <span class="price-val" id="priceTotal">—</span>
                                </div>
                            </div>

                            <div style="display:flex;gap:8px;margin-top:1.4rem;flex-wrap:wrap;">
                                <button type="button" class="btn btn-outline-ink" onclick="resetForm()"><i data-lucide="rotate-ccw"></i> Réinitialiser</button>
                                <button type="submit" class="btn btn-gold" id="submitBtn" disabled>
                                    <i data-lucide="save"></i> <span id="submitText">Sauvegarder</span>
                                </button>
                            </div>
                        </form>
                    </div>

                </div>

                <!-- COLONNE DROITE STICKY -->
                <div class="summary-card">
                    <div class="summary-section">
                        <div class="summary-title">Récapitulatif</div>
                        <div class="summary-thumb" id="summaryThumb">🏨</div>
                        <div class="summary-row"><span class="summary-lbl">Hôtel</span><span class="summary-val" id="sumHotel">—</span></div>
                        <div class="summary-row"><span class="summary-lbl">Chambre</span><span class="summary-val" id="sumChambre">—</span></div>
                        <div class="summary-row"><span class="summary-lbl">Arrivée</span><span class="summary-val" id="sumCheckIn">—</span></div>
                        <div class="summary-row"><span class="summary-lbl">Départ</span><span class="summary-val" id="sumCheckOut">—</span></div>
                        <div class="summary-row"><span class="summary-lbl">Personnes</span><span class="summary-val" id="sumGuests">—</span></div>
                        <div class="summary-total">
                            <span class="summary-total-label">Total</span>
                            <span class="summary-total-val" id="sumTotal">— €</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- SKELETON CHARGEMENT -->
            <div id="loadingSkeleton">
                <div class="skeleton" style="height:180px;border-radius:22px;margin-bottom:1.2rem;"></div>
                <div class="skeleton" style="height:320px;border-radius:22px;"></div>
            </div>

        </main>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast">
        <i data-lucide="check-circle" id="toastIcon"></i>
        <span id="toastMsg"></span>
    </div>

    <script>
        /* ══════════════════════════════════════
           SESSION
        ══════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role'
            },
            getToken()  { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            parseJwt(t) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); } catch { return null; } },
            clearSession() { localStorage.removeItem(this.TOKEN_KEY); document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`; },
            redirectLogin(r) { this.clearSession(); window.location.href = this.LOGIN_URL + '?reason=' + r; },
            _readCookie(n) { const m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)')); return m ? decodeURIComponent(m[2]) : null; }
        };

        /* ══════════════════════════════════════
           ÉTAT
        ══════════════════════════════════════ */
        let reservation    = null;
        let pricePerNight  = 0;
        let availabilityTimer = null;

        const fmt = d => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
        const toISO = d => d; // les inputs date retournent déjà YYYY-MM-DD
        const nights = (ci, co) => Math.max(0, Math.round((new Date(co) - new Date(ci)) / 86400000));

        /* ══════════════════════════════════════
           DATE LABEL
        ══════════════════════════════════════ */
        (function () {
            const now = new Date();
            const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const mois  = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent = jours[now.getDay()] + ' ' + now.getDate() + ' ' + mois[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ══════════════════════════════════════
           INIT
        ══════════════════════════════════════ */
        async function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();

            const token = SESSION.getToken();
            if (!token) { SESSION.redirectLogin('no_token'); return; }
            const p = SESSION.parseJwt(token);
            if (!p)    { SESSION.redirectLogin('invalid'); return; }

            const fn = (p[SESSION.CLAIMS.name] || '').split(' ')[0] || 'Client';
            document.getElementById('userName').textContent      = p[SESSION.CLAIMS.name] || p[SESSION.CLAIMS.email] || '';
            document.getElementById('userRole').textContent      = p[SESSION.CLAIMS.role] || 'Client';
            document.getElementById('avatarInitial').textContent = fn.charAt(0).toUpperCase();

            const urlId = new URLSearchParams(window.location.search).get('id');

                    if (!urlId || isNaN(Number(urlId))) {
            document.getElementById('loadingSkeleton').style.display = 'none';
            showToast('Aucun identifiant de réservation fourni.', 'error');
            setTimeout(() => window.location.href = '/Client/ListeReservations', 2500);
            return;
        }

            await loadReservation(token, Number(urlId));
        }

        /* ══════════════════════════════════════
           CHARGER RÉSERVATION
        ══════════════════════════════════════ */
        async function loadReservation(token, id) {
            try {
                const res = await fetch(`/api/client/reservations/${id}`, {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (res.status === 401) { SESSION.redirectLogin('unauthorized'); return; }
                if (res.status === 404) { showToast('Réservation introuvable.', 'error'); return; }
                if (!res.ok) throw new Error();

                reservation = await res.json();
                document.getElementById('loadingSkeleton').style.display = 'none';

                // Vérifier si la date de check-in est déjà passée
                const checkInDate = new Date(reservation.checkIn);
                checkInDate.setHours(0, 0, 0, 0);
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                if (checkInDate <= today || reservation.status === 'Cancelled' || reservation.status === 'Completed') {
                    document.getElementById('alertPast').classList.add('show');
                    lucide.createIcons();
                    return;
                }

                pricePerNight = reservation.pricePerNight || (reservation.totalPrice / Math.max(1, nights(reservation.checkIn, reservation.checkOut)));

                fillCurrentInfo();
                fillForm();
                document.getElementById('mainContent').style.display = 'grid';
                lucide.createIcons();

            } catch (e) {
                document.getElementById('loadingSkeleton').style.display = 'none';
                showToast('Impossible de charger la réservation.', 'error');
            }
        }

        /* ══════════════════════════════════════
           REMPLIR INFOS ACTUELLES
        ══════════════════════════════════════ */
        function fillCurrentInfo() {
            const n = nights(reservation.checkIn, reservation.checkOut);
            document.getElementById('resIdLabel').textContent   = '#RES-' + String(reservation.id).padStart(4, '0');
            document.getElementById('crHotel').textContent      = reservation.hotelName  || '—';
            document.getElementById('crChambre').textContent    = reservation.chambreName || '—';
            document.getElementById('crCheckIn').textContent    = fmt(reservation.checkIn);
            document.getElementById('crCheckOut').textContent   = fmt(reservation.checkOut);
            document.getElementById('crNights').textContent     = n + ' nuit' + (n > 1 ? 's' : '');
            document.getElementById('crGuests').textContent     = reservation.numberOfGuests + ' pers.';

            // Récap droite
            document.getElementById('sumHotel').textContent   = reservation.hotelName   || '—';
            document.getElementById('sumChambre').textContent = reservation.chambreName || '—';

            if (reservation.hotelImageUrl) {
                document.getElementById('summaryThumb').innerHTML = `<img src="${reservation.hotelImageUrl}" alt="">`;
            }

            document.getElementById('guestHint').textContent = 'Capacité max de la chambre : ' + (reservation.chambreCapacity || '—') + ' personnes';
        }

        /* ══════════════════════════════════════
           REMPLIR FORMULAIRE (dates actuelles)
        ══════════════════════════════════════ */
        function fillForm() {
            const ci = new Date(reservation.checkIn);
            const co = new Date(reservation.checkOut);

            // Minimum = demain
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tStr = tomorrow.toISOString().split('T')[0];

            document.getElementById('newCheckIn').min  = tStr;
            document.getElementById('newCheckOut').min = tStr;

            document.getElementById('newCheckIn').value  = ci.toISOString().split('T')[0];
            document.getElementById('newCheckOut').value = co.toISOString().split('T')[0];
            document.getElementById('newGuests').value   = reservation.numberOfGuests;
            document.getElementById('newGuests').max     = reservation.chambreCapacity || 10;

            updateSummary();
        }

        /* ══════════════════════════════════════
           RESET FORMULAIRE
        ══════════════════════════════════════ */
        function resetForm() {
            fillForm();
            hideAlert('alertOverlap');
            document.getElementById('submitBtn').disabled = false;
        }

        /* ══════════════════════════════════════
           MISE À JOUR SUMMARY EN TEMPS RÉEL
        ══════════════════════════════════════ */
        function onDatesChange() {
            updateSummary();

            // Vérification disponibilité avec debounce
            clearTimeout(availabilityTimer);
            const ci = document.getElementById('newCheckIn').value;
            const co = document.getElementById('newCheckOut').value;
            if (ci && co && ci < co) {
                availabilityTimer = setTimeout(() => checkAvailability(ci, co), 600);
            }
        }

        function updateSummary() {
            const ci = document.getElementById('newCheckIn').value;
            const co = document.getElementById('newCheckOut').value;
            const g  = parseInt(document.getElementById('newGuests').value) || 1;
            const n  = (ci && co) ? nights(ci, co) : 0;
            const total = n * pricePerNight;

            document.getElementById('sumCheckIn').textContent  = ci ? fmt(ci)  : '—';
            document.getElementById('sumCheckOut').textContent = co ? fmt(co)  : '—';
            document.getElementById('sumGuests').textContent   = g + ' personne' + (g > 1 ? 's' : '');
            document.getElementById('sumTotal').textContent    = n > 0 ? total.toLocaleString('fr-FR') + ' €' : '— €';

            if (n > 0) {
                document.getElementById('priceRecap').style.display = 'block';
                document.getElementById('pricePerNight').textContent = pricePerNight.toLocaleString('fr-FR') + ' €';
                document.getElementById('priceNights').textContent   = n + ' nuit' + (n > 1 ? 's' : '');
                document.getElementById('priceTotal').textContent    = total.toLocaleString('fr-FR') + ' €';
            } else {
                document.getElementById('priceRecap').style.display = 'none';
            }

            // Activer le bouton si les dates sont valides
            const valid = ci && co && ci < co && n > 0;
            document.getElementById('submitBtn').disabled = !valid;
        }

        /* ══════════════════════════════════════
           VÉRIFIER DISPONIBILITÉ
        ══════════════════════════════════════ */
        async function checkAvailability(ci, co) {
            if (!reservation) return;
            try {
                const token = SESSION.getToken();
                const res   = await fetch(
                    `/api/chambres/${reservation.chambreId}/disponibilite?checkIn=${ci}&checkOut=${co}&excludeReservationId=${reservation.id}`,
                    { headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' }
                );
                if (!res.ok) return;
                const data = await res.json();
                if (!data.available) {
                    document.getElementById('alertOverlapMsg').textContent = 'La chambre n\'est pas disponible du ' + fmt(ci) + ' au ' + fmt(co) + '.';
                    showAlert('alertOverlap', 'alert-error');
                    document.getElementById('submitBtn').disabled = true;
                } else {
                    hideAlert('alertOverlap');
                    document.getElementById('submitBtn').disabled = false;
                }
            } catch {}
        }

        /* ══════════════════════════════════════
           SOUMETTRE MODIFICATION
        ══════════════════════════════════════ */
        async function submitModify(e) {
            e.preventDefault();

            const ci = document.getElementById('newCheckIn').value;
            const co = document.getElementById('newCheckOut').value;
            const g  = parseInt(document.getElementById('newGuests').value);

            let ok = true;
            if (!ci) { showFieldError('errCheckIn', 'Date d\'arrivée requise.'); ok = false; } else hideFieldError('errCheckIn');
            if (!co) { showFieldError('errCheckOut', 'Date de départ requise.'); ok = false; } else hideFieldError('errCheckOut');
            if (ci && co && ci >= co) { showFieldError('errCheckOut', 'Le départ doit être après l\'arrivée.'); ok = false; }
            if (!g || g < 1) { showFieldError('errGuests', 'Nombre de personnes invalide.'); ok = false; } else hideFieldError('errGuests');
            if (!ok) return;

            const btn  = document.getElementById('submitBtn');
            const text = document.getElementById('submitText');
            btn.disabled = true;
            text.textContent = 'Sauvegarde…';

            try {
                const token = SESSION.getToken();
                const res   = await fetch(`/api/reservations/${reservation.id}`, {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ checkIn: ci, checkOut: co, numberOfGuests: g }),
                    credentials: 'include'
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.message || 'Erreur lors de la modification.');
                }

                showToast('Réservation modifiée avec succès !', 'success');
                setTimeout(() => window.location.href = '/Client/ListeReservations', 2000);

            } catch (err) {
                showToast(err.message || 'Erreur.', 'error');
                btn.disabled = false;
                text.textContent = 'Sauvegarder';
            }
        }

        /* ══════════════════════════════════════
           HELPERS UI
        ══════════════════════════════════════ */
        function showAlert(id, cls) {
            const el = document.getElementById(id);
            if (!el) return;
            el.className = 'alert ' + cls + ' show';
            lucide.createIcons();
        }
        function hideAlert(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('show');
        }
        function showFieldError(id, msg) { const el = document.getElementById(id); if (el) { el.textContent = msg; el.classList.add('show'); } }
        function hideFieldError(id)      { const el = document.getElementById(id); if (el) el.classList.remove('show'); }

        function showToast(msg, type = 'success') {
            const t    = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            document.getElementById('toastMsg').textContent = msg;
            t.className = 'toast ' + type;
            icon.setAttribute('data-lucide', type === 'success' ? 'check-circle' : 'alert-circle');
            lucide.createIcons();
            requestAnimationFrame(() => t.classList.add('show'));
            setTimeout(() => t.classList.remove('show'), 4000);
        }

        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' }).catch(() => {});
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    </script>
</body>
</html>