@{
    ViewData["Title"] = "Mon Profil — Owner";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mon Profil Owner</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(201,169,110,0.3) transparent;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        /* ── BADGE OWNER ── */
        .owner-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(26,107,107,0.18);
            border: 1px solid rgba(26,107,107,0.35);
            border-radius: 100px;
            padding: 3px 10px;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #5bbfbf;
            margin-bottom: 0.5rem;
        }

            .owner-badge svg {
                width: 10px;
                height: 10px;
            }

        /* ── MAIN ── */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
            line-height: 1.2;
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* ── BUTTONS ── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,169,110,0.3);
            }

        .btn-danger {
            background: rgba(220,38,38,0.10);
            color: #f87171;
            border: 1px solid rgba(220,38,38,0.25);
        }

            .btn-danger:hover {
                background: rgba(220,38,38,0.20);
            }

        .btn-outline-ink {
            background: transparent;
            color: var(--ink-60);
            border: 1px solid rgba(15,22,33,0.15);
        }

            .btn-outline-ink:hover {
                background: rgba(15,22,33,0.05);
                color: var(--ink);
            }

        /* ── PROFILE GRID ── */
        .profile-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 1.4rem;
        }

        /* ── CARTE GAUCHE ── */
        .profile-card {
            background: var(--ink);
            border-radius: var(--radius-xl);
            padding: 2rem 1.6rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            border: 1px solid rgba(201,169,110,0.15);
            position: relative;
            overflow: hidden;
        }

            .profile-card::before {
                content: '';
                position: absolute;
                top: -60px;
                right: -60px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.15) 0%, transparent 70%);
            }

        .profile-avatar-wrap {
            position: relative;
            margin-bottom: 1.2rem;
        }

        .profile-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 2.2rem;
            color: var(--ink);
            border: 3px solid rgba(201,169,110,0.3);
        }

        .profile-avatar-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--teal);
            border: 2px solid var(--ink);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .profile-avatar-badge svg {
                width: 10px;
                height: 10px;
                color: #fff;
            }

        .profile-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--white);
            margin-bottom: 4px;
        }

        .profile-email {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.4);
            margin-bottom: 0.6rem;
        }

        .profile-stats {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 1.4rem;
            margin-top: 1rem;
        }

        .profile-stat {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 0.8rem;
        }

        .profile-stat-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--gold);
        }

        .profile-stat-lbl {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .profile-since {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.25);
            margin-top: auto;
        }

        /* ── CARDS ── */
        .form-sections {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.6rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
        }

        .card-title-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .card-title-icon.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .card-title-icon.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .card-title-icon.rose {
                background: var(--rose-lt);
                color: var(--rose);
            }

            .card-title-icon svg {
                width: 16px;
                height: 16px;
            }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
        }

        .card-subtitle {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 1px;
        }

        /* ── FORM ── */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

        .form-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
        }

        .form-input {
            width: 100%;
            padding: 0.7rem 0.9rem;
            border-radius: 11px;
            border: 1.5px solid rgba(15,22,33,0.10);
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.86rem;
            color: var(--ink);
            transition: all .16s;
            outline: none;
        }

            .form-input:focus {
                border-color: rgba(201,169,110,0.5);
                background: var(--white);
                box-shadow: 0 0 0 3px rgba(201,169,110,0.08);
            }

            .form-input:disabled {
                opacity: 0.55;
                cursor: not-allowed;
                background: rgba(15,22,33,0.04);
            }

        .form-hint {
            font-size: 0.7rem;
            color: var(--ink-60);
        }

        .form-error {
            font-size: 0.7rem;
            color: var(--rose);
            display: none;
        }

            .form-error.show {
                display: block;
            }

        /* ── PASSWORD STRENGTH ── */
        .pwd-strength {
            display: flex;
            gap: 4px;
            margin-top: 4px;
        }

        .pwd-bar {
            flex: 1;
            height: 3px;
            border-radius: 100px;
            background: rgba(15,22,33,0.10);
            transition: background .3s;
        }

            .pwd-bar.weak {
                background: var(--rose);
            }

            .pwd-bar.medium {
                background: var(--gold);
            }

            .pwd-bar.strong {
                background: #22c55e;
            }

        .pwd-label {
            font-size: 0.68rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* ── ACTIONS ── */
        .form-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            padding-top: 0.4rem;
        }

        .form-actions-right {
            margin-left: auto;
            display: flex;
            gap: 8px;
        }

        /* ── DANGER ZONE ── */
        .danger-zone {
            background: rgba(192,89,106,0.05);
            border: 1px solid rgba(192,89,106,0.18);
            border-radius: var(--radius-xl);
            padding: 1.4rem 1.6rem;
        }

        .danger-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(192,89,106,0.10);
        }

            .danger-item:last-child {
                border-bottom: none;
            }

        .danger-label {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--rose);
        }

        .danger-sub {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* ── HOTELS SUMMARY ── */
        .hotels-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .hotel-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            background: var(--bg);
            border: 1px solid rgba(15,22,33,0.07);
        }

        .hotel-row-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .hotel-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--teal);
            flex-shrink: 0;
        }

            .hotel-dot.inactive {
                background: var(--ink-30);
            }

        .hotel-name {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--ink);
        }

        .hotel-city {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 1px;
        }

        .hotel-rooms {
            font-size: 0.78rem;
            color: var(--gold);
            font-weight: 600;
        }

        .hotels-empty {
            text-align: center;
            padding: 1.5rem;
            color: var(--ink-60);
            font-size: 0.84rem;
        }

        /* ── TOAST ── */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            background: var(--ink);
            color: var(--white);
            border-radius: 13px;
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.84rem;
            font-weight: 500;
            box-shadow: var(--shadow-md);
            opacity: 0;
            transform: translateY(10px);
            transition: all .3s;
            pointer-events: none;
            max-width: 320px;
        }

            .toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .toast.success {
                border-left: 3px solid #22c55e;
            }

            .toast.error {
                border-left: 3px solid var(--rose);
            }

            .toast svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .main > * {
            animation: fadeUp 0.38s ease both;
        }

            .main > *:nth-child(2) {
                animation-delay: 0.05s;
            }

            .main > *:nth-child(3) {
                animation-delay: 0.10s;
            }

        @@media (max-width: 1100px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }
        }

        @@media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- ── SIDEBAR ── -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="sidebar-content">
                <div class="sidebar-section-label">Navigation</div>
                <nav class="sidebar-nav">
                    <a href="/Owner/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                    <a href="/Owner/Hotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Mes hôtels</a>
                    <a href="/Owner/Chambres" class="nav-item"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Chambres</a>
                    <a href="/Owner/Reservations" class="nav-item"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Réservations</a>
                    <a href="/Owner/Revenus" class="nav-item"><span class="nav-icon"><i data-lucide="trending-up"></i></span> Revenus</a>
                    <a href="/Owner/Avis" class="nav-item"><span class="nav-icon"><i data-lucide="message-circle"></i></span> Avis clients</a>
                </nav>
                <div class="sidebar-section-label">Compte</div>
                <nav class="sidebar-nav">
                    <a href="/Owner/Profil" class="nav-item active"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                    <a href="/Owner/Parametres" class="nav-item"><span class="nav-icon"><i data-lucide="settings"></i></span> Paramètres</a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role">Owner</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>

        <!-- ── MAIN ── -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Mon <em>profil</em></h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <button class="btn btn-danger" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
                </div>
            </div>

            <!-- GRID -->
            <div class="profile-grid">

                <!-- CARTE GAUCHE -->
                <div class="profile-card">
                    <div class="profile-avatar-wrap">
                        <div class="profile-avatar" id="bigAvatar">?</div>
                        <div class="profile-avatar-badge"><i data-lucide="building-2"></i></div>
                    </div>
                    <div class="profile-name" id="profileFullName">Chargement...</div>
                    <div class="profile-email" id="profileEmail">—</div>
                    <div class="owner-badge"><i data-lucide="shield-check"></i> Owner vérifié</div>
                    <div class="profile-since" id="profileSince">Owner depuis —</div>
                </div>

                <!-- FORMULAIRES -->
                <div class="form-sections">

                    <!-- INFOS PERSONNELLES -->
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap">
                                <div class="card-title-icon gold">
                                    <i data-lucide="edit"></i>
                                <div>
                                    <div class="card-title">Informations personnelles</div>
                                    <div class="card-subtitle">Vos données d'identité</div>
                                </div>
                            </div>
                        </div>
                        <form id="profileForm" onsubmit="saveProfile(event)">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Prénom</label>
                                    <input id="firstName" class="form-input" type="text" placeholder="Votre prénom" required />
                                    <span class="form-error" id="errFirstName"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Nom</label>
                                    <input id="lastName" class="form-input" type="text" placeholder="Votre nom" required />
                                    <span class="form-error" id="errLastName"></span>
                                </div>
                                <div class="form-group full">
                                    <label class="form-label">Adresse e-mail</label>
                                    <input id="email" class="form-input" type="email" disabled />
                                    <span class="form-hint">L'email ne peut pas être modifié directement.</span>
                                </div>
                                <div class="form-group full">
                                    <label class="form-label">Téléphone</label>
                                    <input id="phoneNumber" class="form-input" type="tel" placeholder="+33 6 00 00 00 00" />
                                </div>
                            </div>
                            <div class="form-actions" style="margin-top:1.2rem;">
                                <button type="button" class="btn btn-outline-ink" onclick="loadProfile()"><i data-lucide="rotate-ccw"></i> Réinitialiser</button>
                                <div class="form-actions-right">
                                    <button type="submit" class="btn btn-gold" id="saveProfileBtn">
                                        <i data-lucide="save"></i> <span id="saveProfileText">Sauvegarder</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- MES HÔTELS (résumé) -->
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap">
                                <div class="card-title-icon teal"><i data-lucide="building-2"></i></div>
                                <div>
                                    <div class="card-title">Mes hôtels</div>
                                    <div class="card-subtitle">Aperçu de votre parc hôtelier</div>
                                </div>
                            </div>
                            <a href="/Owner/Hotels" class="btn btn-outline-ink" style="font-size:0.78rem; padding:0.4rem 0.9rem;">
                                <i data-lucide="arrow-right"></i> Gérer
                            </a>
                        </div>
                        <div class="hotels-list" id="hotelsList">
                            <div class="hotels-empty">Chargement des hôtels…</div>
                        </div>
                    </div>

                    <!-- CHANGER MOT DE PASSE -->
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap">
                                <div class="card-title-icon teal"><i data-lucide="lock"></i></div>
                                <div>
                                    <div class="card-title">Changer le mot de passe</div>
                                    <div class="card-subtitle">Sécurisez votre compte owner</div>
                                </div>
                            </div>
                        </div>
                        <form id="passwordForm" onsubmit="changePassword(event)">
                            <div class="form-grid">
                                <div class="form-group full">
                                    <label class="form-label">Mot de passe actuel</label>
                                    <input id="currentPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="current-password" />
                                    <span class="form-error" id="errCurrentPwd"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Nouveau mot de passe</label>
                                    <input id="newPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" oninput="checkStrength(this.value)" />
                                    <div class="pwd-strength">
                                        <div class="pwd-bar" id="bar1"></div><div class="pwd-bar" id="bar2"></div>
                                        <div class="pwd-bar" id="bar3"></div><div class="pwd-bar" id="bar4"></div>
                                    </div>
                                    <span class="pwd-label" id="pwdLabel"></span>
                                    <span class="form-error" id="errNewPwd"></span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Confirmer le mot de passe</label>
                                    <input id="confirmPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" />
                                    <span class="form-error" id="errConfirmPwd"></span>
                                </div>
                            </div>
                            <div class="form-actions" style="margin-top:1.2rem;">
                                <button type="submit" class="btn btn-gold" id="savePwdBtn">
                                    <i data-lucide="shield-check"></i> <span id="savePwdText">Mettre à jour</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- DANGER ZONE -->
                    <div class="danger-zone">
                        <div class="card-header" style="margin-bottom:0.6rem;">
                            <div class="card-title-wrap">
                                <div class="card-title-icon rose"><i data-lucide="alert-triangle"></i></div>
                                <div>
                                    <div class="card-title" style="color:var(--rose);">Zone dangereuse</div>
                                    <div class="card-subtitle">Actions irréversibles sur votre compte</div>
                                </div>
                            </div>
                        </div>
                        <div class="danger-item">
                            <div>
                                <div class="danger-label">Désactiver le compte owner</div>
                                <div class="danger-sub">Vos hôtels seront masqués. Contactez le support pour réactiver.</div>
                            </div>
                            <button class="btn btn-danger" onclick="deactivateAccount()"><i data-lucide="user-x"></i> Désactiver</button>
                        </div>
                    </div>

                </div>
            </div>

        </main>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast">
        <i data-lucide="check-circle" id="toastIcon"></i>
        <span id="toastMsg"></span>
    </div>

    <script>
        /* ══════════════════════════════════════
           SESSION
        ══════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role'
            },
            getToken()  { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            parseJwt(t) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); } catch { return null; } },
            clearSession() { localStorage.removeItem(this.TOKEN_KEY); document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`; },
            redirectLogin(r) { this.clearSession(); window.location.href = this.LOGIN_URL + '?reason=' + r; },
            _readCookie(n) { const m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)')); return m ? decodeURIComponent(m[2]) : null; }
        };

        /* ══════════════════════════════════════
           DATE
        ══════════════════════════════════════ */
        (function () {
            const now  = new Date();
            const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const mois  = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent = jours[now.getDay()] + ' ' + now.getDate() + ' ' + mois[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ══════════════════════════════════════
           INIT
        ══════════════════════════════════════ */
        async function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();

            const token = SESSION.getToken();
            if (!token) { SESSION.redirectLogin('no_token'); return; }
            const p = SESSION.parseJwt(token);
            if (!p)    { SESSION.redirectLogin('invalid'); return; }

            // Vérification rôle Owner
            const role = p[SESSION.CLAIMS.role] || '';
            if (!role.toLowerCase().includes('owner')) { SESSION.redirectLogin('forbidden'); return; }

            // Sidebar
            const fullName  = p[SESSION.CLAIMS.name]  || '';
            const firstName = fullName.split(' ')[0] || 'Owner';
            document.getElementById('userName').textContent      = fullName || p[SESSION.CLAIMS.email] || '';
            document.getElementById('avatarInitial').textContent = firstName.charAt(0).toUpperCase();

            await loadProfile();
            await loadOwnerStats(token);
            await loadHotels(token);
        }

        /* ══════════════════════════════════════
           CHARGER PROFIL
        ══════════════════════════════════════ */
        async function loadProfile() {
            const token = SESSION.getToken();
            try {
                const res = await fetch('/api/owner/profile', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (res.status === 401) { SESSION.redirectLogin('unauthorized'); return; }
                if (!res.ok) throw new Error();

                const u = await res.json();

                const full = ((u.firstName || '') + ' ' + (u.lastName || '')).trim();
                document.getElementById('bigAvatar').textContent      = (u.firstName || '?').charAt(0).toUpperCase();
                document.getElementById('profileFullName').textContent = full || '—';
                document.getElementById('profileEmail').textContent    = u.email || '—';
                document.getElementById('profileSince').textContent    = 'Owner depuis ' + new Date(u.createdAt).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

                document.getElementById('firstName').value   = u.firstName   || '';
                document.getElementById('lastName').value    = u.lastName    || '';
                document.getElementById('email').value       = u.email       || '';
                document.getElementById('phoneNumber').value = u.phoneNumber || '';

                lucide.createIcons();
            } catch {
                showToast('Impossible de charger le profil.', 'error');
            }
        }

        /* ══════════════════════════════════════
           CHARGER STATS OWNER
        ══════════════════════════════════════ */
        async function loadOwnerStats(token) {
            try {
                const res = await fetch('/api/owner/dashboard', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) return;
                const d = await res.json();

                document.getElementById('pStatHotels').textContent   = d.totalHotels   ?? '—';
                document.getElementById('pStatChambres').textContent = d.totalChambres  ?? '—';
                document.getElementById('pStatRes').textContent      = d.totalReservations ?? '—';
                document.getElementById('pStatRevenu').textContent   = d.totalRevenu != null
                    ? d.totalRevenu.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })
                    : '—';
            } catch {}
        }

        /* ══════════════════════════════════════
           CHARGER HOTELS
        ══════════════════════════════════════ */
        async function loadHotels(token) {
            const container = document.getElementById('hotelsList');
            try {
                const res = await fetch('/api/owner/hotels', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) throw new Error();
                const hotels = await res.json();

                if (!hotels || hotels.length === 0) {
                    container.innerHTML = '<div class="hotels-empty">Aucun hôtel enregistré pour l\'instant.</div>';
                    return;
                }

                // Affiche jusqu'à 4 hôtels
                const visible = hotels.slice(0, 4);
                container.innerHTML = visible.map(h => `
                    <div class="hotel-row">
                        <div class="hotel-row-left">
                            <div class="hotel-dot ${h.isActive === false ? 'inactive' : ''}"></div>
                            <div>
                                <div class="hotel-name">${escHtml(h.name || '—')}</div>
                                <div class="hotel-city">${escHtml(h.city || h.address || '—')}</div>
                            </div>
                        </div>
                        <div class="hotel-rooms">${h.totalChambres != null ? h.totalChambres + ' ch.' : '—'}</div>
                    </div>
                `).join('');

                if (hotels.length > 4) {
                    container.innerHTML += `<div class="hotels-empty" style="font-size:0.76rem;">+${hotels.length - 4} autre(s) — <a href="/Owner/Hotels" style="color:var(--gold);">voir tous</a></div>`;
                }
            } catch {
                container.innerHTML = '<div class="hotels-empty">Impossible de charger les hôtels.</div>';
            }
        }

        /* ══════════════════════════════════════
           SAUVEGARDER PROFIL
        ══════════════════════════════════════ */
        async function saveProfile(e) {
            e.preventDefault();
            const btn  = document.getElementById('saveProfileBtn');
            const text = document.getElementById('saveProfileText');
            btn.disabled = true;
            text.textContent = 'Sauvegarde…';

            const token = SESSION.getToken();
            const body  = {
                firstName:   document.getElementById('firstName').value.trim(),
                lastName:    document.getElementById('lastName').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim()
            };

            let ok = true;
            if (!body.firstName) { showFieldError('errFirstName', 'Prénom requis.'); ok = false; } else hideFieldError('errFirstName');
            if (!body.lastName)  { showFieldError('errLastName',  'Nom requis.');   ok = false; } else hideFieldError('errLastName');
            if (!ok) { btn.disabled = false; text.textContent = 'Sauvegarder'; return; }

            try {
                const res = await fetch('/api/owner/profile', {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                    credentials: 'include'
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.message || 'Erreur');
                }
                showToast('Profil mis à jour avec succès.', 'success');
                await loadProfile();
            } catch (err) {
                showToast(err.message || 'Erreur lors de la sauvegarde.', 'error');
            } finally {
                btn.disabled = false;
                text.textContent = 'Sauvegarder';
            }
        }

        /* ══════════════════════════════════════
           CHANGER MOT DE PASSE
        ══════════════════════════════════════ */
        async function changePassword(e) {
            e.preventDefault();
            const currentPwd = document.getElementById('currentPassword').value;
            const newPwd     = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;

            let ok = true;
            if (!currentPwd)       { showFieldError('errCurrentPwd', 'Mot de passe actuel requis.'); ok = false; } else hideFieldError('errCurrentPwd');
            if (newPwd.length < 6) { showFieldError('errNewPwd', 'Minimum 6 caractères.'); ok = false; }          else hideFieldError('errNewPwd');
            if (newPwd !== confirmPwd) { showFieldError('errConfirmPwd', 'Les mots de passe ne correspondent pas.'); ok = false; } else hideFieldError('errConfirmPwd');
            if (!ok) return;

            const btn  = document.getElementById('savePwdBtn');
            const text = document.getElementById('savePwdText');
            btn.disabled = true;
            text.textContent = 'Mise à jour…';

            try {
                const token = SESSION.getToken();
                const res   = await fetch('/api/owner/profile/password', {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword: currentPwd, newPassword: newPwd }),
                    credentials: 'include'
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    if (err.message?.includes('incorrect') || res.status === 400)
                        showFieldError('errCurrentPwd', 'Mot de passe actuel incorrect.');
                    else throw new Error(err.message || 'Erreur');
                    return;
                }
                showToast('Mot de passe mis à jour.', 'success');
                document.getElementById('passwordForm').reset();
                resetStrength();
            } catch (err) {
                showToast(err.message || 'Erreur.', 'error');
            } finally {
                btn.disabled = false;
                text.textContent = 'Mettre à jour';
            }
        }

        /* ══════════════════════════════════════
           DÉSACTIVER COMPTE
        ══════════════════════════════════════ */
        async function deactivateAccount() {
            if (!confirm('Êtes-vous sûr de vouloir désactiver votre compte owner ? Tous vos hôtels seront masqués.')) return;
            try {
                const token = SESSION.getToken();
                const res   = await fetch('/api/owner/profile/deactivate', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) throw new Error();
                showToast('Compte désactivé. Déconnexion en cours…', 'success');
                setTimeout(() => logout(), 2500);
            } catch {
                showToast('Erreur lors de la désactivation.', 'error');
            }
        }

        /* ══════════════════════════════════════
           FORCE MOT DE PASSE
        ══════════════════════════════════════ */
        function checkStrength(v) {
            const bars  = ['bar1','bar2','bar3','bar4'].map(id => document.getElementById(id));
            const label = document.getElementById('pwdLabel');
            bars.forEach(b => { b.className = 'pwd-bar'; });
            if (!v) { label.textContent = ''; return; }
            let score = 0;
            if (v.length >= 6)  score++;
            if (v.length >= 10) score++;
            if (/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;
            const cls = score <= 1 ? 'weak' : score <= 2 ? 'medium' : 'strong';
            const lbl = score <= 1 ? 'Faible' : score <= 2 ? 'Moyen' : score === 3 ? 'Bon' : 'Excellent';
            for (let i = 0; i < score; i++) bars[i].classList.add(cls);
            label.textContent = lbl;
            label.style.color = cls === 'weak' ? 'var(--rose)' : cls === 'medium' ? 'var(--gold)' : '#22c55e';
        }

        function resetStrength() {
            ['bar1','bar2','bar3','bar4'].forEach(id => { document.getElementById(id).className = 'pwd-bar'; });
            document.getElementById('pwdLabel').textContent = '';
        }

        /* ══════════════════════════════════════
           HELPERS
        ══════════════════════════════════════ */
        function showFieldError(id, msg) { const el = document.getElementById(id); if (el) { el.textContent = msg; el.classList.add('show'); } }
        function hideFieldError(id) { const el = document.getElementById(id); if (el) { el.classList.remove('show'); } }
        function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            document.getElementById('toastMsg').textContent = msg;
            t.className = 'toast ' + type;
            icon.setAttribute('data-lucide', type === 'success' ? 'check-circle' : 'alert-circle');
            lucide.createIcons();
            requestAnimationFrame(() => t.classList.add('show'));
            setTimeout(() => t.classList.remove('show'), 3500);
        }

        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' }).catch(() => {});
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    </script>
</body>
</html>

