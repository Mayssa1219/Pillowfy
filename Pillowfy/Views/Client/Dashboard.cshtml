@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mon espace</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .nav-badge {
            margin-left: auto;
            background: var(--gold);
            color: var(--ink);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 100px;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
            font-weight: 700;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding-right: 6px;
            margin-right: -6px;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(201,169,110,0.3) transparent;
        }

            .sidebar-content::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-content::-webkit-scrollbar-thumb {
                background: rgba(201,169,110,0.3);
                border-radius: 20px;
            }

                .sidebar-content::-webkit-scrollbar-thumb:hover {
                    background: var(--gold);
                }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
            line-height: 1.2;
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-online {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--white);
            border: 1px solid rgba(201,169,110,0.2);
            border-radius: 100px;
            padding: 0.38rem 0.85rem;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--teal);
            box-shadow: var(--shadow-sm);
        }

        .badge-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #22c55e;
            animation: pulse 2s infinite;
        }

        /* HERO */
        .hero-card {
            background: var(--ink);
            border-radius: var(--radius-xl);
            padding: 1.8rem 2.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
            position: relative;
            overflow: hidden;
        }

            .hero-card::before {
                content: '';
                position: absolute;
                right: -5%;
                top: -55%;
                width: 320px;
                height: 320px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.18) 0%, transparent 65%);
            }

            .hero-card::after {
                content: '';
                position: absolute;
                left: 28%;
                bottom: -45%;
                width: 180px;
                height: 180px;
                border-radius: 50%;
                border: 1px solid rgba(201,169,110,0.07);
            }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(201,169,110,0.14);
            border: 1px solid rgba(201,169,110,0.22);
            border-radius: 100px;
            padding: 3px 11px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--gold);
            margin-bottom: 8px;
        }

        .hero-text {
            position: relative;
            z-index: 1;
        }

            .hero-text h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.45rem;
                color: var(--white);
                margin-bottom: 4px;
            }

                .hero-text h2 em {
                    color: var(--gold);
                    font-style: italic;
                }

            .hero-text p {
                font-size: 0.83rem;
                color: rgba(255,255,255,0.4);
                max-width: 320px;
                line-height: 1.5;
            }

        .hero-actions {
            position: relative;
            z-index: 1;
            display: flex;
            gap: 8px;
        }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,169,110,0.3);
            }

        .btn-outline {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.65);
            border: 1px solid rgba(255,255,255,0.12);
        }

            .btn-outline:hover {
                background: rgba(255,255,255,0.12);
                color: var(--white);
            }

        .btn-danger {
            background: rgba(220,38,38,0.10);
            color: #f87171;
            border: 1px solid rgba(220,38,38,0.25);
        }

            .btn-danger:hover {
                background: rgba(220,38,38,0.20);
                color: #fca5a5;
            }

        .btn-teal {
            background: rgba(26,107,107,0.3);
            color: #4ECDC4;
            border: 1px solid rgba(26,107,107,0.45);
            border-radius: 100px;
            padding: 0.5rem 1.1rem;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .16s;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

            .btn-teal:hover {
                background: rgba(26,107,107,0.5);
            }

            .btn-teal svg {
                width: 13px;
                height: 13px;
            }

        .btn-sm-gold {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--gold-lt);
            color: #9A722E;
            border: 1px solid rgba(201,169,110,0.25);
            border-radius: 100px;
            padding: 5px 12px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .15s;
            text-decoration: none;
        }

            .btn-sm-gold:hover {
                background: var(--gold-mid);
            }

            .btn-sm-gold svg {
                width: 12px;
                height: 12px;
            }

        /* RESERVATION BANNER */
        .reservation-banner {
            background: linear-gradient(135deg, #0E2D2D 0%, #0B1120 100%);
            border-radius: var(--radius-xl);
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
            border: 1px solid rgba(26,107,107,0.3);
            position: relative;
            overflow: hidden;
        }

            .reservation-banner::before {
                content: '';
                position: absolute;
                right: 10%;
                top: -80%;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(26,107,107,0.25) 0%, transparent 70%);
            }

        .res-left {
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            z-index: 1;
        }

        .res-room-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(26,107,107,0.25);
            border: 1px solid rgba(26,107,107,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .res-room-icon svg {
                width: 22px;
                height: 22px;
                color: #4ECDC4;
            }

        .res-label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 3px;
        }

        .res-room {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

        .res-dates {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.45);
            margin-top: 2px;
        }

        .res-status-group {
            display: flex;
            gap: 16px;
            position: relative;
            z-index: 1;
        }

        .res-stat {
            text-align: center;
        }

        .res-stat-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

        .res-stat-lbl {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .res-divider {
            width: 1px;
            background: rgba(255,255,255,0.08);
        }

        .res-actions {
            display: flex;
            gap: 8px;
            position: relative;
            z-index: 1;
        }

        /* STATS */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.3rem 1.4rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: all .2s;
        }

            .stat-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
                border-color: rgba(201,169,110,0.22);
            }

        .stat-icon-wrap {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .stat-icon-wrap svg {
                width: 18px;
                height: 18px;
            }

            .stat-icon-wrap.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stat-icon-wrap.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .stat-icon-wrap.green {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stat-icon-wrap.rose {
                background: var(--rose-lt);
                color: var(--rose);
            }

        .stat-label {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
            margin-bottom: 3px;
        }

        .stat-value {
            font-family: 'DM Serif Display', serif;
            font-size: 0.95rem;
            color: var(--ink);
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* GRIDS */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .main-grid-wide {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1rem;
        }

        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.5rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.1rem;
        }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 0.98rem;
            color: var(--ink);
        }

        .card-link {
            font-size: 0.76rem;
            color: var(--gold);
            font-weight: 600;
            text-decoration: none;
        }

            .card-link:hover {
                text-decoration: underline;
            }

        /* SÉJOURS */
        .stay-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.9rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .stay-item:last-child {
                border-bottom: none;
            }

        .stay-thumb {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.2rem;
            overflow: hidden;
        }

            .stay-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .stay-hotel {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--ink);
        }

        .stay-dates {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .stay-meta {
            margin-left: auto;
            text-align: right;
        }

        .stay-price {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--ink);
        }

        .stay-nights {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .stay-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 100px;
            margin-top: 4px;
        }

            .stay-badge.done {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stay-badge.upcoming {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stay-badge.cancelled {
                background: var(--rose-lt);
                color: var(--rose);
            }

        /* OCCUPATION */
        .occ-item {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .occ-item:last-child {
                border-bottom: none;
            }

        .occ-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .occ-hotel {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink);
        }

        .occ-pct {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--ink-60);
        }

        .occ-bar {
            height: 5px;
            background: rgba(15,22,33,0.07);
            border-radius: 100px;
            overflow: hidden;
        }

        .occ-bar-fill {
            height: 100%;
            border-radius: 100px;
            transition: width 0.9s ease;
        }

            .occ-bar-fill.gold {
                background: linear-gradient(90deg, #C9A96E, #e8c080);
            }

            .occ-bar-fill.teal {
                background: linear-gradient(90deg, #1A6B6B, #4ECDC4);
            }

            .occ-bar-fill.green {
                background: linear-gradient(90deg, #16a34a, #4ade80);
            }

            .occ-bar-fill.rose {
                background: linear-gradient(90deg, #C0596A, #e87f8e);
            }

        /* FIDÉLITÉ */
        .loyalty-card {
            background: linear-gradient(135deg, #0E2D1E 0%, #0B1120 100%);
            border-radius: var(--radius-xl);
            padding: 1.4rem 1.6rem;
            border: 1px solid rgba(201,169,110,0.15);
            position: relative;
            overflow: hidden;
        }

            .loyalty-card::before {
                content: '';
                position: absolute;
                right: -40px;
                top: -40px;
                width: 180px;
                height: 180px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.08) 0%, transparent 70%);
            }

        .loyalty-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .loyalty-title {
            font-family: 'DM Serif Display', serif;
            font-size: 0.95rem;
            color: var(--white);
        }

        .loyalty-tier {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 100px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: 1px solid;
        }

            .loyalty-tier.Bronze {
                background: rgba(205,127,50,0.18);
                color: #CD7F32;
                border-color: rgba(205,127,50,0.3);
            }

            .loyalty-tier.Silver {
                background: rgba(168,169,173,0.18);
                color: #B8B9BD;
                border-color: rgba(168,169,173,0.3);
            }

            .loyalty-tier.Gold {
                background: rgba(201,169,110,0.20);
                color: var(--gold);
                border-color: rgba(201,169,110,0.3);
            }

            .loyalty-tier.Platinum {
                background: rgba(229,228,226,0.12);
                color: #d4d4d4;
                border-color: rgba(229,228,226,0.2);
            }

        .loyalty-pts {
            font-family: 'DM Serif Display', serif;
            font-size: 2.4rem;
            color: var(--gold);
            line-height: 1;
            margin-bottom: 2px;
        }

        .loyalty-pts-label {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .loyalty-bar-wrap {
            margin-top: 1rem;
        }

        .loyalty-bar-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.68rem;
            color: rgba(255,255,255,0.3);
            margin-bottom: 5px;
        }

        .loyalty-bar {
            height: 5px;
            background: rgba(255,255,255,0.08);
            border-radius: 100px;
            overflow: hidden;
        }

        .loyalty-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), #e8c080);
            border-radius: 100px;
            transition: width .8s ease;
        }

        .loyalty-remise-box {
            margin-top: 1rem;
            background: rgba(201,169,110,0.08);
            border: 1px solid rgba(201,169,110,0.18);
            border-radius: 11px;
            padding: 0.8rem 1rem;
            display: none;
        }

        .loyalty-remise-label {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.35);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }

        .loyalty-remise-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--gold);
        }

        .loyalty-remise-hint {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.25);
            margin-top: 6px;
        }

        .btn-loyalty {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(201,169,110,0.10);
            border: 1px solid rgba(201,169,110,0.25);
            color: var(--gold);
            border-radius: 100px;
            padding: 0.55rem 1.2rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.83rem;
            font-weight: 600;
            text-decoration: none;
            transition: background .16s;
            width: 100%;
            margin-top: 1rem;
        }

            .btn-loyalty:hover {
                background: rgba(201,169,110,0.20);
            }

            .btn-loyalty svg {
                width: 13px;
                height: 13px;
            }

        /* SERVICES */
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .service-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.8rem;
            border-radius: 12px;
            background: var(--bg);
            cursor: pointer;
            transition: all .16s;
            border: 1px solid transparent;
        }

            .service-item:hover {
                background: var(--gold-lt);
                border-color: rgba(201,169,110,0.2);
                transform: translateY(-1px);
            }

        .service-ic {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            font-size: 1rem;
            flex-shrink: 0;
        }

        .service-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .service-status {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-top: 1px;
        }

        /* ACTIONS RAPIDES */
        .quick-action {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 0.8rem;
            border-radius: 11px;
            background: var(--bg);
            margin-bottom: 7px;
            text-decoration: none;
            transition: all .16s;
            cursor: pointer;
            border: none;
            width: 100%;
            text-align: left;
        }

            .quick-action:hover {
                background: var(--gold-lt);
                transform: translateX(3px);
            }

            .quick-action:last-child {
                margin-bottom: 0;
            }

        .qa-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            flex-shrink: 0;
            color: var(--ink-60);
        }

            .qa-icon svg {
                width: 15px;
                height: 15px;
            }

        .qa-label {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink);
        }

        .qa-sub {
            font-size: 0.72rem;
            color: var(--ink-60);
        }

        .qa-arrow {
            margin-left: auto;
            color: var(--ink-30);
        }

            .qa-arrow svg {
                width: 15px;
                height: 15px;
            }

        /* AVIS */
        .rating-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

        .star {
            font-size: 0.9rem;
        }

        .rating-hotel {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .rating-date {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-left: auto;
        }

        .rating-comment {
            font-size: 0.78rem;
            color: var(--ink-60);
            line-height: 1.5;
        }

        /* HOTELS */
        .hotel-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.85rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
            cursor: pointer;
            transition: all .16s;
            border-radius: 8px;
        }

            .hotel-item:last-child {
                border-bottom: none;
            }

            .hotel-item:hover {
                background: var(--gold-lt);
                padding-left: 6px;
            }

        .hotel-thumb {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
        }

            .hotel-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .hotel-info {
            flex: 1;
            min-width: 0;
        }

        .hotel-name {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .hotel-location {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .hotel-rating {
            font-size: 0.72rem;
            margin-top: 3px;
        }

        .hotel-action {
            color: var(--ink-30);
            flex-shrink: 0;
        }

            .hotel-action svg {
                width: 15px;
                height: 15px;
            }

        /* CHAMBRES */
        .chambre-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.85rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
            cursor: pointer;
            transition: all .16s;
        }

            .chambre-item:last-child {
                border-bottom: none;
            }

            .chambre-item:hover {
                background: var(--gold-lt);
                padding-left: 6px;
                border-radius: 8px;
            }

        .chambre-thumb {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: var(--teal-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
        }

            .chambre-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .chambre-info {
            flex: 1;
            min-width: 0;
        }

        .chambre-name {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chambre-hotel, .chambre-capacity {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .chambre-price {
            text-align: right;
            flex-shrink: 0;
        }

        .chambre-price-val {
            font-family: 'DM Serif Display', serif;
            font-size: 0.95rem;
            color: var(--ink);
            font-weight: 700;
        }

        .chambre-price-lbl {
            font-size: 0.68rem;
            color: var(--ink-60);
            margin-top: 1px;
        }

        .chambre-book-btn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 6px;
            background: var(--gold);
            color: var(--ink);
            border: none;
            border-radius: 100px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .15s;
        }

            .chambre-book-btn:hover {
                background: #b8924f;
                transform: translateY(-1px);
            }

            .chambre-book-btn svg {
                width: 11px;
                height: 11px;
            }

        /* SKELETON */
        .skeleton {
            background: linear-gradient(90deg, rgba(15,22,33,0.06) 25%, rgba(15,22,33,0.10) 50%, rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 6px;
        }

        /* EMPTY STATE */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            gap: 8px;
        }

            .empty-state svg {
                width: 32px;
                height: 32px;
                color: var(--ink-30);
            }

            .empty-state p {
                font-size: 0.82rem;
                color: var(--ink-60);
                text-align: center;
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
            }

            50% {
                box-shadow: 0 0 0 5px rgba(34,197,94,0.07);
            }
        }

        .main > * {
            animation: fadeUp 0.38s ease both;
        }

            .main > *:nth-child(2) {
                animation-delay: 0.05s;
            }

            .main > *:nth-child(3) {
                animation-delay: 0.10s;
            }

            .main > *:nth-child(4) {
                animation-delay: 0.14s;
            }

            .main > *:nth-child(5) {
                animation-delay: 0.18s;
            }

            .main > *:nth-child(6) {
                animation-delay: 0.22s;
            }

        @@media (max-width: 1200px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .main-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 1000px) {
            .main-grid-wide {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .main-grid, .main-grid-wide {
                grid-template-columns: 1fr;
            }

            .hero-card {
                flex-direction: column;
                gap: 1.2rem;
                align-items: flex-start;
            }

            .reservation-banner {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }
        }

        @@media (max-width: 600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .main-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="sidebar-content">
                <div class="sidebar-section-label">Navigation</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Dashboard" class="nav-item active">
                        <span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard
                    </a>
                    <a href="/Client/ListeHotels" class="nav-item">
                        <span class="nav-icon"><i data-lucide="building-2"></i></span> Hôtels
                    </a>
                    <a href="/Client/ListeReservations" class="nav-item">
                        <span class="nav-icon"><i data-lucide="calendar-check"></i></span>
                        Mes réservations
                        <span class="nav-badge" id="nbReservations" style="display:none;"></span>
                    </a>
                    <a href="/Client/Sejours" class="nav-item">
                        <span class="nav-icon"><i data-lucide="bed-double"></i></span> Historique séjours
                    </a>
                    <a href="/Client/Factures" class="nav-item">
                        <span class="nav-icon"><i data-lucide="receipt"></i></span> Factures
                    </a>
                    <a href="/Client/Services" class="nav-item">
                        <span class="nav-icon"><i data-lucide="concierge-bell"></i></span> Services
                    </a>
                </nav>
                <div class="sidebar-section-label">Compte</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Profil" class="nav-item">
                        <span class="nav-icon"><i data-lucide="user"></i></span> Mon profil
                    </a>
                    <a href="/Client/Fidelite" class="nav-item">
                        <span class="nav-icon"><i data-lucide="star"></i></span> Fidélité
                    </a>
                    <a href="/Client/ListeAvis" class="nav-item">
                        <span class="nav-icon"><i data-lucide="message-circle"></i></span> Mes avis
                    </a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role" id="userRole">Client</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()">
                    <i data-lucide="log-out"></i> Déconnexion
                </button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Bonjour, <em id="firstName">...</em> 👋</h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <div class="badge-online"><span class="badge-dot"></span> En ligne</div>
                    <button class="btn btn-danger" onclick="logout()">
                        <i data-lucide="log-out"></i> Déconnexion
                    </button>
                </div>
            </div>

            <!-- HERO -->
            <div class="hero-card">
                <div class="hero-text">
                    <div class="hero-tag"><i data-lucide="sparkles"></i> Votre espace hôtelier</div>
                    <h2>Bienvenue sur <em>Pillowfy</em></h2>
                    <p>Gérez vos réservations, accédez à vos factures et profitez de tous nos services.</p>
                </div>
                <div class="hero-actions">
                    <a href="/Client/NewReservation" class="btn btn-gold">
                        <i data-lucide="plus"></i> Nouvelle réservation
                    </a>
                    <a href="/Client/ListeHotels" class="btn btn-outline">
                        <i data-lucide="building-2"></i> Voir les hôtels
                    </a>
                </div>
            </div>

            <!-- RÉSERVATION ACTIVE — FIX : HTML statique, id sur le bouton Modifier -->
            <div class="reservation-banner" id="reservationBanner" style="display:none;">
                <div class="res-left">
                    <div class="res-room-icon"><i data-lucide="bed-double"></i></div>
                    <div>
                        <div class="res-label">Réservation en cours</div>
                        <div class="res-room" id="resRoomName">—</div>
                        <div class="res-dates" id="resDates">—</div>
                    </div>
                </div>
                <div class="res-status-group">
                    <div class="res-stat">
                        <div class="res-stat-val" id="resNights">—</div>
                        <div class="res-stat-lbl">Nuits</div>
                    </div>
                    <div class="res-divider"></div>
                    <div class="res-stat">
                        <div class="res-stat-val" id="resGuests">—</div>
                        <div class="res-stat-lbl">Personnes</div>
                    </div>
                    <div class="res-divider"></div>
                    <div class="res-stat">
                        <div class="res-stat-val" id="resPrice">—</div>
                        <div class="res-stat-lbl">Total</div>
                    </div>
                </div>
                <div class="res-actions">
                    <a href="/Client/ListeReservations" class="btn-teal">
                        <i data-lucide="eye"></i> Voir détail
                    </a>
                    <a href="#" class="btn-teal" id="btnModifier">
                        <i data-lucide="pencil"></i> Modifier
                    </a>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrap gold"><i data-lucide="calendar-check"></i></div>
                    <div>
                        <div class="stat-label">Réservations</div>
                        <div class="stat-value" id="statResTotal"><span class="skeleton" style="width:40px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Total à ce jour</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap teal"><i data-lucide="bed-double"></i></div>
                    <div>
                        <div class="stat-label">Nuits passées</div>
                        <div class="stat-value" id="statNuits"><span class="skeleton" style="width:40px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Depuis votre inscription</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap green"><i data-lucide="star"></i></div>
                    <div>
                        <div class="stat-label">Points fidélité</div>
                        <div class="stat-value" id="statPoints"><span class="skeleton" style="width:60px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Niveau <span id="statTier">—</span></div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap rose"><i data-lucide="receipt"></i></div>
                    <div>
                        <div class="stat-label">Total dépensé</div>
                        <div class="stat-value" id="statDepense"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Toutes réservations</div>
                    </div>
                </div>
            </div>

            <!-- FIDÉLITÉ + OCCUPATION + SERVICES -->
            <div class="main-grid" style="margin-bottom:1rem;">

                <!-- FIDÉLITÉ — FIX : badge coloré + bloc remise -->
                <div class="loyalty-card">
                    <div class="loyalty-top">
                        <div>
                            <div class="loyalty-title">Programme Fidélité</div>
                            <div style="font-size:0.75rem;color:rgba(255,255,255,0.35);margin-top:2px;">Pillowfy Rewards</div>
                        </div>
                        <div class="loyalty-tier Bronze" id="loyaltyTier">—</div>
                    </div>
                    <div class="loyalty-pts" id="loyaltyPts">—</div>
                    <div class="loyalty-pts-label">points disponibles</div>
                    <div class="loyalty-bar-wrap">
                        <div class="loyalty-bar-labels">
                            <span id="loyaltyLvlFrom">—</span>
                            <span id="loyaltyLvlNext">—</span>
                        </div>
                        <div class="loyalty-bar">
                            <div class="loyalty-bar-fill" id="loyaltyFill" style="width:0%;"></div>
                        </div>
                    </div>

                    <!-- BLOC REMISE -->
                    <div class="loyalty-remise-box" id="loyaltyRemiseBox">
                        <div style="display:flex;align-items:center;justify-content:space-between;">
                            <div>
                                <div class="loyalty-remise-label">Remise disponible</div>
                                <div class="loyalty-remise-val" id="loyaltyRemiseDispo">—</div>
                            </div>
                            <a href="/Client/NewReservation" id="loyaltyBtnUtiliser"
                               style="background:var(--gold);color:var(--ink);border:none;border-radius:100px;padding:0.45rem 1rem;font-size:0.78rem;font-weight:700;font-family:'DM Sans',sans-serif;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:all .15s;white-space:nowrap;">
                                <i data-lucide="tag" style="width:12px;height:12px;"></i> Utiliser
                            </a>
                        </div>
                        <div class="loyalty-remise-hint">100 pts = 10 € · applicable à votre prochaine réservation</div>
                    </div>

                    <a href="/Client/Fidelite" class="btn-loyalty">
                        <i data-lucide="gift"></i> Voir mon programme
                    </a>
                </div>

                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Taux d'occupation</span>
                        <a href="/Admin/Hotels" class="card-link">Détails →</a>
                    </div>
                    <div id="occupancyList">
                        <div class="skeleton" style="height:14px;width:60%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:5px;width:100%;margin-bottom:16px;"></div>
                        <div class="skeleton" style="height:14px;width:50%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:5px;width:100%;"></div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Services disponibles</span>
                        <a href="/Client/Services" class="card-link">Voir tout →</a>
                    </div>
                    <div class="service-grid">
                        <div class="service-item" onclick="window.location='/Client/Services/SpaWellness'">
                            <div class="service-ic">🧖</div>
                            <div><div class="service-name">Spa & Bien-être</div><div class="service-status">Ouvert · 9h–21h</div></div>
                        </div>
                        <div class="service-item" onclick="window.location='/Client/Services/Restaurant'">
                            <div class="service-ic">🍽️</div>
                            <div><div class="service-name">Restaurant</div><div class="service-status">Ouvert · 12h–23h</div></div>
                        </div>
