        </main>
    </div>

    <script>
        /* ════════════════════════════════════════════════
           SESSION MANAGER
        ════════════════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', REFRESH_TOKEN_KEY: 'pillowfy_refresh',
            COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            REFRESH_URL: '/api/auth/refresh', REFRESH_THRESHOLD: 5 * 60,
            CHECK_INTERVAL: 60 * 1000, WARN_BEFORE: 2 * 60,
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role',
            },
            _heartbeatTimer: null, _warnShown: false,
            getToken()        { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            getRefreshToken() { return this._readCookie('refresh_token')  || localStorage.getItem(this.REFRESH_TOKEN_KEY); },
            saveToken(token, rememberMe = false) {
                const maxAge = rememberMe ? 30 * 24 * 3600 : 0;
                document.cookie = `${this.COOKIE_NAME}=${encodeURIComponent(token)}; path=/; SameSite=Strict${maxAge ? '; Max-Age=' + maxAge : ''}`;
                localStorage.setItem(this.TOKEN_KEY, token);
            },
            clearSession() {
                localStorage.removeItem(this.TOKEN_KEY); localStorage.removeItem(this.REFRESH_TOKEN_KEY);
                document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`;
                document.cookie = `refresh_token=; Max-Age=0; path=/; SameSite=Strict`;
                if (this._heartbeatTimer) clearInterval(this._heartbeatTimer);
            },
            parseJwt(token) {
                try { return JSON.parse(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); }
                catch { return null; }
            },
            secondsLeft(p) { if (!p?.exp) return Infinity; return p.exp - Math.floor(Date.now() / 1000); },
            async tryRefresh() {
                const rt = this.getRefreshToken(); if (!rt) return false;
                try {
                    const res = await fetch(this.REFRESH_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({refreshToken:rt}), credentials:'include' });
                    if (!res.ok) return false;
                    const data = await res.json();
                    if (data.token) { this.saveToken(data.token); if (data.refreshToken) localStorage.setItem(this.REFRESH_TOKEN_KEY, data.refreshToken); return true; }
                    return false;
                } catch { return false; }
            },
            async check() {
                const token = this.getToken(); if (!token) { this.redirectLogin('no_token'); return false; }
                const p = this.parseJwt(token); if (!p) { this.redirectLogin('invalid_token'); return false; }
                const left = this.secondsLeft(p);
                if (left <= 0) { const r = await this.tryRefresh(); if (!r) { this.redirectLogin('expired'); return false; } return true; }
                if (left < this.REFRESH_THRESHOLD) this.tryRefresh();
                if (left < this.WARN_BEFORE && !this._warnShown) { this._warnShown = true; this._showSessionWarning(Math.floor(left / 60)); }
                return true;
            },
            redirectLogin(reason) {
                this.clearSession();
                const url = new URL(this.LOGIN_URL, window.location.origin);
                url.searchParams.set('reason', reason); url.searchParams.set('returnUrl', window.location.pathname);
                window.location.href = url.toString();
            },
            _showSessionWarning(minsLeft) {
                const toast = document.getElementById('sessionWarning'); if (!toast) return;
                toast.querySelector('#warnMins').textContent = minsLeft + ' min';
                toast.style.display = 'flex';
                setTimeout(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; }, 10);
            },
            startHeartbeat() {
                if (this._heartbeatTimer) clearInterval(this._heartbeatTimer);
                this._heartbeatTimer = setInterval(() => this.check(), this.CHECK_INTERVAL);
                document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') { this._warnShown = false; this.check(); } });
                window.addEventListener('online', () => this.check());
            },
            _readCookie(name) {
                const m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                return m ? decodeURIComponent(m[2]) : null;
            }
        };

        /* ════════════════════════════════════════════════
           DATE
        ════════════════════════════════════════════════ */
        (function () {
            const now = new Date();
            const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const mois  = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent =
                jours[now.getDay()] + ' ' + now.getDate() + ' ' + mois[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ════════════════════════════════════════════════
           HELPERS
        ════════════════════════════════════════════════ */
        const fmt = date => new Date(date).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
        const nightsCount = (ci, co) => Math.max(1, Math.round((new Date(co) - new Date(ci)) / 86400000));

        function statusBadge(status) {
            const map = {
                'Confirmed': { cls:'upcoming', label:'↗ À venir' },
                'Cancelled': { cls:'cancelled', label:'✕ Annulé' },
                'Completed': { cls:'done', label:'✓ Terminé' },
            };
            const s = map[status] || { cls:'done', label: status };
            return `<div class="stay-badge ${s.cls}">${s.label}</div>`;
        }

        /* ════════════════════════════════════════════════
           CHARGEMENT UTILISATEUR
        ════════════════════════════════════════════════ */
        async function loadUser() {
            const ok = await SESSION.check(); if (!ok) return;
            const token    = SESSION.getToken();
            const p        = SESSION.parseJwt(token);
            const fullName = p[SESSION.CLAIMS.name]  || '';
            const email    = p[SESSION.CLAIMS.email] || '';
            const role     = p[SESSION.CLAIMS.role]  || 'Customer';
            const firstName = fullName.split(' ')[0] || 'Client';
            document.getElementById('firstName').textContent     = firstName;
            document.getElementById('userName').textContent      = fullName || email;
            document.getElementById('userRole').textContent      = role;
            document.getElementById('avatarInitial').textContent = firstName.charAt(0).toUpperCase();
            SESSION.startHeartbeat();
            await loadDashboardData(token);
        }

        /* ════════════════════════════════════════════════
           DONNÉES DASHBOARD
        ════════════════════════════════════════════════ */
        async function loadDashboardData(token) {
            const headers = { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' };
            try {
                const [dashRes, occRes, hotelsRes, chambresRes] = await Promise.all([
                    fetch('/api/client/dashboard',        { headers, credentials:'include' }),
                    fetch('/api/client/hotels/occupancy', { headers, credentials:'include' }),
                    fetch('/api/hotels',                  { headers, credentials:'include' }),
                    fetch('/api/chambres',                { headers, credentials:'include' })
                ]);

                if (dashRes.status === 401) { SESSION.redirectLogin('unauthorized'); return; }

                if (dashRes.ok) {
                    const dash = await dashRes.json();

                    // Stats
                    document.getElementById('statResTotal').textContent = dash.reservationsTotal ?? '—';
                    document.getElementById('statNuits').textContent    = dash.nuitsTotal        ?? '—';
                    document.getElementById('statPoints').textContent   = dash.pointsFidelite != null ? dash.pointsFidelite.toLocaleString('fr-FR') : '—';
                    document.getElementById('statTier').textContent     = dash.tier              ?? '—';
                    document.getElementById('statDepense').textContent  = dash.totalDepense      ?? '—';

                    // ── FIDÉLITÉ FIX ──────────────────────────────────
                    const tier   = dash.tier ?? 'Bronze';
                    const points = dash.pointsFidelite ?? 0;

                    const tierEl = document.getElementById('loyaltyTier');
                    tierEl.textContent = tier;
                    tierEl.className   = 'loyalty-tier ' + tier;

                    document.getElementById('loyaltyPts').textContent     = points.toLocaleString('fr-FR');
                    document.getElementById('loyaltyLvlFrom').textContent = tier;
                    document.getElementById('loyaltyLvlNext').textContent = dash.nextTierPts
                        ? dash.nextTierPts + ' pts pour ' + (dash.nextTierName ?? '') : 'Niveau max atteint ✓';

                    setTimeout(() => {
                        document.getElementById('loyaltyFill').style.width = (dash.loyaltyProgress ?? 0) + '%';
                    }, 300);

                    // Bloc remise disponible
                    const remiseMax = Math.floor(points / 100) * 10;
                    if (remiseMax > 0) {
                        const remiseBox = document.getElementById('loyaltyRemiseBox');
                        remiseBox.style.display = 'block';
                        document.getElementById('loyaltyRemiseDispo').textContent = remiseMax.toLocaleString('fr-FR') + ' €';
                        const maxPts = Math.floor(points / 100) * 100;
                        document.getElementById('loyaltyBtnUtiliser').href = `/Client/NewReservation?points=${maxPts}`;
                    }
                    // ─────────────────────────────────────────────────

                    // ── BANNER RÉSERVATION ACTIVE FIX ────────────────
                    if (dash.activeReservation) {
                        const r = dash.activeReservation;
                        const n = nightsCount(r.checkIn, r.checkOut);
                        document.getElementById('resRoomName').textContent = r.chambreName + (r.hotelName ? ' · ' + r.hotelName : '');
                        document.getElementById('resDates').textContent    = 'Arrivée : ' + fmt(r.checkIn) + ' · Départ : ' + fmt(r.checkOut);
                        document.getElementById('resNights').textContent   = n;
                        document.getElementById('resGuests').textContent   = r.numberOfGuests;
                        document.getElementById('resPrice').textContent    = r.totalPrice.toLocaleString('fr-FR') + ' €';
                        // FIX : injecter l'ID dans le href du bouton Modifier
                        document.getElementById('btnModifier').href = `/Client/ModifierReservation?id=${r.id}`;
                        document.getElementById('reservationBanner').style.display = 'flex';
                    } else {
                        document.getElementById('reservationBanner').style.display = 'none';
                    }
                    // ─────────────────────────────────────────────────

                    // Badge sidebar
                    const badge = document.getElementById('nbReservations');
                    if (badge) {
                        const nb = dash.reservationsActives ?? 0;
                        badge.textContent   = nb;
                        badge.style.display = nb > 0 ? '' : 'none';
                    }

                    // Historique séjours
                    const stayList = document.getElementById('stayList');
                    if (stayList) {
                        const reservations = dash.dernieresReservations ?? [];
                        const emojis = ['🏨','🌴','🏔️','🌆','🏖️'];
                        if (!reservations.length) {
                            stayList.innerHTML = `<div class="empty-state"><i data-lucide="calendar-x"></i><p>Aucune réservation pour le moment.</p></div>`;
                        } else {
                            stayList.innerHTML = reservations.map((r, i) => {
                                const n = nightsCount(r.checkIn, r.checkOut);
                                let displayStatus = r.status;
                                if (r.status === 'Confirmed' && new Date(r.checkOut) <= new Date()) displayStatus = 'Completed';
                                const thumb = r.hotelImageUrl ? `<img src="${r.hotelImageUrl}" alt="">` : emojis[i % emojis.length];
                                return `
                                    <div class="stay-item">
                                        <div class="stay-thumb">${thumb}</div>
                                        <div>
                                            <div class="stay-hotel">${r.hotelName || r.chambreName}</div>
                                            <div class="stay-dates">${r.chambreName} · ${fmt(r.checkIn)} – ${fmt(r.checkOut)}</div>
                                            ${statusBadge(displayStatus)}
                                        </div>
                                        <div class="stay-meta">
                                            <div class="stay-price">${r.totalPrice.toLocaleString('fr-FR')} €</div>
                                            <div class="stay-nights">${n} nuit${n > 1 ? 's' : ''} · ${r.numberOfGuests} pers.</div>
                                        </div>
                                    </div>`;
                            }).join('');
                        }
                        lucide.createIcons();
                    }

                    // Factures
                    const invoiceList = document.getElementById('invoiceList');
                    if (invoiceList) {
                        const facturables = (dash.dernieresReservations ?? []).filter(r => r.status !== 'Cancelled').slice(0, 4);
                        if (!facturables.length) {
                            invoiceList.innerHTML = `<div class="empty-state"><i data-lucide="receipt"></i><p>Aucune facture disponible.</p></div>`;
                        } else {
                            invoiceList.innerHTML = facturables.map(r => `
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:0.8rem 0;border-bottom:1px solid rgba(15,22,33,0.05);">
                                    <div>
                                        <div style="font-size:0.8rem;font-weight:600;color:var(--ink);">FAC-${new Date(r.checkOut).getFullYear()}-${String(r.id).padStart(4,'0')}</div>
                                        <div style="font-size:0.72rem;color:var(--ink-60);">${r.hotelName || r.chambreName} · ${fmt(r.checkOut)}</div>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:10px;">
                                        <div style="font-size:0.9rem;font-weight:700;color:var(--ink);">${r.totalPrice.toLocaleString('fr-FR')} €</div>
                                        <button onclick="downloadInvoice(${r.id})"
                                            style="width:28px;height:28px;border-radius:7px;background:var(--bg);border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ink-60);transition:all .15s;"
                                            onmouseover="this.style.background='var(--gold-lt)';this.style.color='var(--gold)'"
                                            onmouseout="this.style.background='var(--bg)';this.style.color='var(--ink-60)'"
                                            title="Télécharger">
                                            <i data-lucide="download" style="width:13px;height:13px;"></i>
                                        </button>
                                    </div>
                                </div>`).join('');
                        }
                        lucide.createIcons();
                    }

                    // Dernier avis
                    const avisCard = document.getElementById('dernierAvisContent');
                    if (avisCard) {
                        if (dash.dernierAvis) {
                            const a = dash.dernierAvis;
                            const stars = '⭐'.repeat(Math.min(Math.max(a.note, 1), 5));
                            const date  = new Date(a.dateAvis).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
                            avisCard.innerHTML = `
                                <div class="rating-row">
                                    <div class="stars">${stars}</div>
                                    <span class="rating-hotel">${a.hotelName}</span>
                                    <span class="rating-date">${date}</span>
                                </div>
                                <div class="rating-comment">"${a.commentaire}"</div>
                                <div style="margin-top:10px;">
                                    <a href="/Client/ListeAvis" class="btn-sm-gold"><i data-lucide="star"></i> Voir tous mes avis</a>
                                </div>`;
                        } else {
                            avisCard.innerHTML = `
                                <div class="empty-state"><i data-lucide="message-circle"></i><p>Vous n'avez pas encore laissé d'avis.</p></div>
                                <div style="margin-top:10px;">
                                    <a href="/Client/ListeAvis" class="btn-sm-gold"><i data-lucide="star"></i> Laisser un avis</a>
                                </div>`;
                        }
                        lucide.createIcons();
                    }

                    // Dernier paiement
                    const paiementCard = document.getElementById('dernierPaiementContent');
                    if (paiementCard) {
                        if (dash.dernierPaiement) {
                            const p = dash.dernierPaiement;
                            const date = new Date(p.datePaiement).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
                            const statutColor = p.statut === 'Confirme' ? '#16a34a' : p.statut === 'Rembourse' ? '#C0596A' : '#9A722E';
                            const statutLabel = p.statut === 'Confirme' ? '✓ Confirmé' : p.statut === 'Rembourse' ? '↩ Remboursé' : p.statut;
                            paiementCard.innerHTML = `
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                                    <div style="font-size:0.82rem;font-weight:600;color:var(--ink);">${p.hotelName}</div>
                                    <span style="font-size:0.72rem;font-weight:700;color:${statutColor};background:${statutColor}18;padding:2px 9px;border-radius:100px;">${statutLabel}</span>
                                </div>
                                <div style="font-size:0.75rem;color:var(--ink-60);margin-bottom:6px;">${p.chambreName} · ${date}</div>
                                <div style="font-size:1.1rem;font-weight:700;color:var(--ink);font-family:'DM Serif Display',serif;">${p.montant.toLocaleString('fr-FR')} €</div>
                                <div style="font-size:0.72rem;color:var(--ink-60);margin-top:3px;">via ${p.methode}</div>`;
                        } else {
                            paiementCard.innerHTML = `<div class="empty-state"><i data-lucide="credit-card"></i><p>Aucun paiement enregistré.</p></div>`;
                        }
                        lucide.createIcons();
                    }
                }

                // Taux d'occupation
                const occList = document.getElementById('occupancyList');
                if (occList) {
                    const colors = ['gold','teal','green','rose'];
                    if (occRes.ok) {
                        const occ = await occRes.json();
                        if (!occ.length) {
                            occList.innerHTML = `<div class="empty-state"><i data-lucide="building-2"></i><p>Aucun hôtel disponible.</p></div>`;
                        } else {
                            occList.innerHTML = occ.map((o, i) => `
                                <div class="occ-item">
                                    <div class="occ-header">
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            ${o.imageUrl ? `<img src="${o.imageUrl}" style="width:22px;height:22px;border-radius:5px;object-fit:cover;" alt="">` : `<span style="font-size:1rem;">🏨</span>`}
                                            <span class="occ-hotel">${o.hotelName}</span>
                                        </div>
                                        <span class="occ-pct">${o.occupancyRate}%</span>
                                    </div>
                                    <div class="occ-bar">
                                        <div class="occ-bar-fill ${colors[i % colors.length]}" style="width:0%;" data-width="${o.occupancyRate}%"></div>
                                    </div>
                                </div>`).join('');
                            setTimeout(() => { occList.querySelectorAll('.occ-bar-fill').forEach(el => { el.style.width = el.dataset.width; }); }, 300);
                        }
                    } else {
                        occList.innerHTML = `<div class="empty-state"><i data-lucide="wifi-off"></i><p>Données indisponibles.</p></div>`;
                    }
                    lucide.createIcons();
                }

                // Hôtels
                const hotelsList = document.getElementById('hotelsList');
                if (hotelsList) {
                    if (hotelsRes.ok) {
                        const hotels = await hotelsRes.json();
                        if (!hotels.length) {
                            hotelsList.innerHTML = `<div class="empty-state"><i data-lucide="building-2"></i><p>Aucun hôtel disponible.</p></div>`;
                        } else {
                            hotelsList.innerHTML = hotels.slice(0, 4).map(h => `
                                <div class="hotel-item" onclick="window.location='/Client/Hotels/${h.id}'">
                                    <div class="hotel-thumb">
                                        ${h.imageUrl ? `<img src="${h.imageUrl}" alt="${h.name}">` : `<span style="font-size:1.4rem;">🏨</span>`}
                                    </div>
                                    <div class="hotel-info">
                                        <div class="hotel-name">${h.name}</div>
                                        <div class="hotel-location">
                                            <i data-lucide="map-pin" style="width:11px;height:11px;"></i>
                                            ${h.city}, ${h.country}
                                        </div>
                                        ${h.rating ? `<div class="hotel-rating">${'⭐'.repeat(Math.round(h.rating))} <span style="font-size:0.7rem;color:var(--ink-60);">${h.rating.toFixed(1)}</span></div>` : ''}
                                    </div>
                                    <div class="hotel-action"><i data-lucide="chevron-right"></i></div>
                                </div>`).join('');
                        }
                    } else {
                        hotelsList.innerHTML = `<div class="empty-state"><i data-lucide="wifi-off"></i><p>Données indisponibles.</p></div>`;
                    }
                    lucide.createIcons();
                }

                // Chambres
                const chambresList = document.getElementById('chambresList');
                if (chambresList) {
                    if (chambresRes.ok) {
                        const chambres = await chambresRes.json();
                        if (!chambres.length) {
                            chambresList.innerHTML = `<div class="empty-state"><i data-lucide="bed-double"></i><p>Aucune chambre disponible.</p></div>`;
                        } else {
                            chambresList.innerHTML = chambres.slice(0, 4).map(c => `
                                <div class="chambre-item" onclick="window.location='/Client/NewReservation?chambreId=${c.id}'">
                                    <div class="chambre-thumb">
                                        ${c.imageUrl ? `<img src="${c.imageUrl}" alt="${c.name}">` : `<span style="font-size:1.2rem;">🛏️</span>`}
                                    </div>
                                    <div class="chambre-info">
                                        <div class="chambre-name">${c.name}</div>
                                        <div class="chambre-hotel"><i data-lucide="building-2" style="width:11px;height:11px;"></i> ${c.hotelName ?? '—'}</div>
                                        <div class="chambre-capacity"><i data-lucide="users" style="width:11px;height:11px;"></i> ${c.capacity} pers. max</div>
                                    </div>
                                    <div class="chambre-price">
                                        <div class="chambre-price-val">${c.pricePerNight.toLocaleString('fr-FR')} €</div>
                                        <div class="chambre-price-lbl">/ nuit</div>
                                        <button class="chambre-book-btn" onclick="event.stopPropagation();window.location='/Client/NewReservation?chambreId=${c.id}'">
                                            <i data-lucide="plus"></i> Réserver
                                        </button>
                                    </div>
                                </div>`).join('');
                        }
                    } else {
                        chambresList.innerHTML = `<div class="empty-state"><i data-lucide="wifi-off"></i><p>Données indisponibles.</p></div>`;
                    }
                    lucide.createIcons();
                }

            } catch (e) {
                console.error('[Dashboard] Erreur :', e);
            }
        }

        /* ════════════════════════════════════════════════
           TÉLÉCHARGEMENT FACTURE
        ════════════════════════════════════════════════ */
        async function downloadInvoice(reservationId) {
            const token = SESSION.getToken();
            const res   = await fetch(`/api/reservations/${reservationId}/invoice`,
                { headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' });
            if (!res.ok) { alert('Facture indisponible.'); return; }
            const blob = await res.blob();
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href = url; a.download = `facture-${reservationId}.pdf`; a.click();
            URL.revokeObjectURL(url);
        }

        /* ════════════════════════════════════════════════
           DÉCONNEXION
        ════════════════════════════════════════════════ */
        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) {
                    await fetch('/api/auth/logout', {
                        method:'POST', headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'}, credentials:'include'
                    }).catch(() => {});
                }
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        function extendSession() {
            SESSION._warnShown = false; SESSION.tryRefresh();
            const toast = document.getElementById('sessionWarning');
            if (toast) { toast.style.opacity = '0'; setTimeout(() => toast.style.display = 'none', 300); }
        }

        /* ════════════════════════════════════════════════
           TOAST SESSION
        ════════════════════════════════════════════════ */
        (function injectToast() {
            const style = document.createElement('style');
            style.textContent = `
                #sessionWarning { display:none;opacity:0;transform:translateY(10px);transition:opacity .3s,transform .3s;position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;background:#0F1621;border:1px solid rgba(201,169,110,0.3);border-radius:14px;padding:1rem 1.2rem;box-shadow:0 8px 32px rgba(15,22,33,0.28);align-items:center;gap:12px;max-width:340px;font-family:'DM Sans',sans-serif; }
                #sessionWarning .sw-ic { width:36px;height:36px;border-radius:10px;background:rgba(201,169,110,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#C9A96E; }
                #sessionWarning .sw-ic svg { width:16px;height:16px; }
                #sessionWarning .sw-body { flex:1; }
                #sessionWarning .sw-title { font-size:.83rem;font-weight:600;color:#fff; }
                #sessionWarning .sw-sub { font-size:.74rem;color:rgba(255,255,255,.4);margin-top:2px; }
                #sessionWarning .sw-sub strong { color:#C9A96E; }
                #sessionWarning .sw-btns { display:flex;gap:6px;margin-top:8px; }
                #sessionWarning .sw-extend { background:#C9A96E;color:#0F1621;border:none;border-radius:100px;padding:5px 13px;font-size:.78rem;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif; }
                #sessionWarning .sw-out { background:transparent;color:rgba(255,255,255,.38);border:1px solid rgba(255,255,255,.1);border-radius:100px;padding:5px 13px;font-size:.78rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif; }
                #sessionWarning .sw-out:hover { color:#f87171;border-color:rgba(220,38,38,.35); }
                #sessionWarning .sw-close { background:none;border:none;color:rgba(255,255,255,.22);cursor:pointer;font-size:1rem;padding:0 2px;align-self:flex-start;line-height:1; }
            `;
            document.head.appendChild(style);
            document.body.insertAdjacentHTML('beforeend', `
            <div id="sessionWarning" role="alert" aria-live="polite">
                <div class="sw-ic"><i data-lucide="clock"></i></div>
                <div class="sw-body">
                    <div class="sw-title">Session expire bientôt</div>
                    <div class="sw-sub">Il vous reste <strong id="warnMins">2 min</strong> — rester connecté ?</div>
                    <div class="sw-btns">
                        <button class="sw-extend" onclick="extendSession()">Rester connecté</button>
                        <button class="sw-out" onclick="logout()">Se déconnecter</button>
                    </div>
                </div>
                <button class="sw-close" onclick="this.closest('#sessionWarning').style.display='none'" aria-label="Fermer">✕</button>
            </div>`);
        })();

        /* ════════════════════════════════════════════════
           INIT
        ════════════════════════════════════════════════ */
        function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();
            loadUser();
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>