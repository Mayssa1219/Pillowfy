@{
    ViewData["Title"] = "Mes Chambres";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mes Chambres</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --gold-lt: rgba(201,169,110,0.12);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 0.5rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display',serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .owner-badge-side {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: 0 0.8rem 1.5rem;
            background: rgba(26,107,107,0.18);
            border: 1px solid rgba(26,107,107,0.35);
            border-radius: 8px;
            padding: 5px 10px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #4ECDC4;
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(26,107,107,0.18);
                color: #4ECDC4;
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(26,107,107,0.25);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg,#1A6B6B,#4ECDC4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display',serif;
            font-size: 0.9rem;
            color: var(--white);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: #4ECDC4;
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans',sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(26,107,107,0.4) transparent;
        }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display',serif;
            font-size: 1.6rem;
            color: var(--ink);
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--teal);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        /* FILTERS */
        .filters-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
        }

        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .search-wrap svg {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                width: 15px;
                height: 15px;
                color: var(--ink-30);
            }

        .search-input {
            width: 100%;
            padding: 0.65rem 1rem 0.65rem 2.4rem;
            background: var(--white);
            border: 1.5px solid rgba(15,22,33,0.10);
            border-radius: 100px;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.87rem;
            color: var(--ink);
            outline: none;
            transition: border-color .2s;
        }

            .search-input:focus {
                border-color: var(--teal);
            }

        .filter-select {
            padding: 0.63rem 1rem;
            background: var(--white);
            border: 1.5px solid rgba(15,22,33,0.10);
            border-radius: 100px;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.84rem;
            color: var(--ink-60);
            outline: none;
            cursor: pointer;
        }

            .filter-select:focus {
                border-color: var(--teal);
            }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .18s;
            text-decoration: none;
        }

            .btn svg {
                width: 14px;
                height: 14px;
            }

        .btn-teal {
            background: var(--teal);
            color: var(--white);
        }

            .btn-teal:hover {
                background: #155858;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(26,107,107,0.4);
            }

        .btn-danger {
            background: var(--rose-lt);
            color: var(--rose);
            border: 1px solid rgba(192,89,106,0.25);
        }

            .btn-danger:hover {
                background: rgba(192,89,106,0.2);
            }

        .btn-ghost {
            background: rgba(15,22,33,0.06);
            color: var(--ink-60);
            border: 1px solid rgba(15,22,33,0.10);
        }

            .btn-ghost:hover {
                background: rgba(15,22,33,0.10);
                color: var(--ink);
            }

        /* GRID */
        .chambres-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.2rem;
        }

        /* CARD */
        .chambre-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: all .2s;
        }

            .chambre-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-3px);
                border-color: rgba(26,107,107,0.2);
            }

            .chambre-card.inactive {
                opacity: 0.55;
            }

        .chambre-img {
            width: 100%;
            height: 150px;
            background: var(--teal-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            position: relative;
            overflow: hidden;
        }

            .chambre-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .chambre-badge-avail {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 100px;
            backdrop-filter: blur(6px);
        }

            .chambre-badge-avail.available {
                background: rgba(34,197,94,0.85);
                color: #fff;
            }

            .chambre-badge-avail.occupied {
                background: rgba(192,89,106,0.85);
                color: #fff;
            }

            .chambre-badge-avail.inactive {
                background: rgba(15,22,33,0.55);
                color: #fff;
            }

        .chambre-body {
            padding: 1.1rem;
        }

        .chambre-hotel {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--teal);
            margin-bottom: 3px;
        }

        .chambre-name {
            font-family: 'DM Serif Display',serif;
            font-size: 1rem;
            color: var(--ink);
            margin-bottom: 6px;
        }

        .chambre-meta {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .chambre-meta-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.75rem;
            color: var(--ink-60);
        }

            .chambre-meta-item svg {
                width: 12px;
                height: 12px;
            }

        .chambre-price {
            font-family: 'DM Serif Display',serif;
            font-size: 1.1rem;
            color: var(--ink);
            margin-bottom: 12px;
        }

            .chambre-price span {
                font-family: 'DM Sans',sans-serif;
                font-size: 0.72rem;
                color: var(--ink-60);
                font-weight: 400;
            }

        .chambre-actions {
            display: flex;
            gap: 8px;
        }

        /* EMPTY */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4rem 2rem;
            gap: 12px;
            background: var(--white);
            border-radius: var(--radius-xl);
            border: 2px dashed rgba(26,107,107,0.2);
            grid-column: 1/-1;
        }

            .empty-state svg {
                width: 48px;
                height: 48px;
                color: rgba(26,107,107,0.3);
            }

            .empty-state h3 {
                font-family: 'DM Serif Display',serif;
                font-size: 1.1rem;
                color: var(--ink);
            }

            .empty-state p {
                font-size: 0.84rem;
                color: var(--ink-60);
                text-align: center;
            }

        /* SKELETON */
        .skeleton {
            background: linear-gradient(90deg,rgba(15,22,33,0.06) 25%,rgba(15,22,33,0.10) 50%,rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 6px;
        }

        .skeleton-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            overflow: hidden;
            border: 1px solid rgba(201,169,110,0.10);
        }

        /* MODAL */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15,22,33,0.55);
            backdrop-filter: blur(4px);
            z-index: 200;
            display: none;
            align-items: center;
            justify-content: center;
        }

            .modal-backdrop.open {
                display: flex;
            }

        .modal {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 2rem;
            width: 100%;
            max-width: 520px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 24px 64px rgba(15,22,33,0.2);
            animation: slideUp .25s ease;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .modal-title {
            font-family: 'DM Serif Display',serif;
            font-size: 1.2rem;
            color: var(--ink);
        }

        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-30);
            font-size: 1.3rem;
            padding: 4px;
            transition: color .15s;
        }

            .modal-close:hover {
                color: var(--ink);
            }

        /* FORM */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group.full {
                grid-column: 1/-1;
            }

        .form-label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-60);
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 0.72rem 1rem;
            background: var(--bg);
            border: 1.5px solid rgba(15,22,33,0.10);
            border-radius: 12px;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.9rem;
            color: var(--ink);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .form-input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(26,107,107,0.12);
            }

            .form-input::placeholder {
                color: var(--ink-30);
            }

        .form-textarea {
            resize: vertical;
            min-height: 80px;
        }

        /* IMAGE UPLOAD */
        .image-upload-zone {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 2px dashed rgba(26,107,107,0.3);
            border-radius: 12px;
            padding: 1.2rem 1rem;
            cursor: pointer;
            background: var(--bg);
            transition: all .2s;
            width: 100%;
            position: relative;
            overflow: hidden;
            min-height: 80px;
        }

            .image-upload-zone:hover {
                border-color: var(--teal);
                background: var(--teal-lt);
            }

        .upload-icon {
            color: var(--teal);
            width: 24px;
            height: 24px;
        }

        .upload-text {
            font-size: 0.82rem;
            color: var(--ink-60);
        }

        .upload-hint {
            font-size: 0.7rem;
            color: var(--ink-30);
        }

        #chambreImagePreview {
            display: none;
            width: 100%;
            max-height: 130px;
            object-fit: cover;
            border-radius: 8px;
        }

            #chambreImagePreview.visible {
                display: block;
            }

        .image-upload-zone.has-image .upload-icon,
        .image-upload-zone.has-image .upload-text,
        .image-upload-zone.has-image .upload-hint {
            display: none;
        }

        .image-change-btn {
            display: none;
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(15,22,33,0.65);
            color: var(--white);
            border: none;
            border-radius: 8px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
        }

        .image-upload-zone.has-image .image-change-btn {
            display: block;
        }

        .modal-footer {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 1.5rem;
        }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 999;
            background: var(--ink);
            color: var(--white);
            border-radius: 12px;
            padding: 0.9rem 1.2rem;
            font-size: 0.86rem;
            font-weight: 500;
            display: none;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-md);
        }

            .toast.show {
                display: flex;
                animation: fadeUp .25s ease;
            }

            .toast.success {
                border-left: 3px solid #22c55e;
            }

            .toast.error {
                border-left: 3px solid var(--rose);
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width:900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }
        }

        @@media (max-width:600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .chambres-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="owner-badge-side">
                <i data-lucide="building-2" style="width:12px;height:12px;"></i> Espace Propriétaire
            </div>
            <div class="sidebar-content">
                <div>
                    <div class="sidebar-section-label">Navigation</div>
                    <nav class="sidebar-nav">
                        <a href="/Owner/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                        <a href="/Owner/Hotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Mes hôtels</a>
                        <a href="/Owner/Chambres" class="nav-item active"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Chambres</a>
                        <a href="/Owner/Reservations" class="nav-item"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Réservations<span class="nav-badge" id="nbReservations" style="display:none;"></span></a>
                        <a href="/Owner/Paiements" class="nav-item"><span class="nav-icon"><i data-lucide="credit-card"></i></span> Paiements</a>
                        <a href="/Owner/Revenus" class="nav-item"><span class="nav-icon"><i data-lucide="trending-up"></i></span> Revenus</a>
                        <a href="/Owner/Avis" class="nav-item"><span class="nav-icon"><i data-lucide="star"></i></span> Avis clients</a>
                    </nav>
                </div>
                <div>
                    <div class="sidebar-section-label">Compte</div>
                    <nav class="sidebar-nav">
                        <a href="/Owner/Profil" class="nav-item"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                        <a href="/Owner/Parametres" class="nav-item"><span class="nav-icon"><i data-lucide="settings"></i></span> Paramètres</a>
                    </nav>
                </div>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role">Propriétaire</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Mes <em>chambres</em></h1>
                    <p id="chambreCount">Chargement...</p>
                </div>
                <button class="btn btn-teal" onclick="openModal()">
                    <i data-lucide="plus"></i> Ajouter une chambre
                </button>
            </div>

            <!-- FILTERS -->
            <div class="filters-bar">
                <div class="search-wrap">
                    <i data-lucide="search"></i>
                    <input class="search-input" id="searchInput" placeholder="Rechercher une chambre..." oninput="applyFilters()">
                </div>
                <select class="filter-select" id="hotelFilter" onchange="applyFilters()">
                    <option value="">Tous les hôtels</option>
                </select>
                <select class="filter-select" id="availFilter" onchange="applyFilters()">
                    <option value="">Tous</option>
                    <option value="available">Disponibles</option>
                    <option value="occupied">Occupées</option>
                    <option value="inactive">Inactives</option>
                </select>
            </div>

            <div id="chambresGrid" class="chambres-grid">
                <div class="skeleton-card">
                    <div class="skeleton" style="height:150px;width:100%;border-radius:0;"></div>
                    <div style="padding:1.1rem;">
                        <div class="skeleton" style="height:14px;width:40%;margin-bottom:6px;"></div>
                        <div class="skeleton" style="height:18px;width:65%;margin-bottom:10px;"></div>
                        <div class="skeleton" style="height:40px;width:100%;border-radius:10px;"></div>
                    </div>
                </div>
                <div class="skeleton-card">
                    <div class="skeleton" style="height:150px;width:100%;border-radius:0;"></div>
                    <div style="padding:1.1rem;">
                        <div class="skeleton" style="height:14px;width:40%;margin-bottom:6px;"></div>
                        <div class="skeleton" style="height:18px;width:65%;margin-bottom:10px;"></div>
                        <div class="skeleton" style="height:40px;width:100%;border-radius:10px;"></div>
                    </div>
                </div>
                <div class="skeleton-card">
                    <div class="skeleton" style="height:150px;width:100%;border-radius:0;"></div>
                    <div style="padding:1.1rem;">
                        <div class="skeleton" style="height:14px;width:40%;margin-bottom:6px;"></div>
                        <div class="skeleton" style="height:18px;width:65%;margin-bottom:10px;"></div>
                        <div class="skeleton" style="height:40px;width:100%;border-radius:10px;"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL -->
    <div class="modal-backdrop" id="modalBackdrop" onclick="closeModalOutside(event)">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="modalTitle">Ajouter une chambre</div>
                <button class="modal-close" onclick="closeModal()">✕</button>
            </div>
            <div class="form-grid">
                <input type="hidden" id="chambreId">

                <div class="form-group full">
                    <label class="form-label">Hôtel *</label>
                    <select class="form-input" id="chambreHotel">
                        <option value="">Choisir un hôtel...</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label class="form-label">Nom de la chambre *</label>
                    <input class="form-input" id="chambreName" placeholder="Ex : Chambre Deluxe 101">
                </div>
                <div class="form-group">
                    <label class="form-label">Prix / nuit (€) *</label>
                    <input class="form-input" id="chambrePrice" type="number" min="0" step="0.01" placeholder="150">
                </div>
                <div class="form-group">
                    <label class="form-label">Capacité (personnes) *</label>
                    <input class="form-input" id="chambreCapacity" type="number" min="1" max="20" placeholder="2">
                </div>
                <div class="form-group full">
                    <label class="form-label">Description</label>
                    <textarea class="form-input form-textarea" id="chambreDesc" placeholder="Décrivez la chambre..."></textarea>
                </div>

                <!-- IMAGE UPLOAD -->
                <div class="form-group full">
                    <label class="form-label">Image de la chambre</label>
                    <label class="image-upload-zone" id="imageDropZone">
                        <i data-lucide="image-plus" class="upload-icon"></i>
                        <span class="upload-text">Cliquez pour choisir une image</span>
                        <span class="upload-hint">JPG, PNG, WEBP — max 5 Mo</span>
                        <img id="chambreImagePreview" alt="Aperçu">
                        <button type="button" class="image-change-btn" onclick="triggerFileInput(event)">Changer</button>
                        <input type="file" id="chambreImageFile" accept="image/*"
                               style="display:none;" onchange="previewImage(event)">
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="closeModal()">Annuler</button>
                <button class="btn btn-teal" id="saveBtn" onclick="saveChambre()">
                    <i data-lucide="check"></i> Enregistrer
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast"></div>

    <script>
        const SESSION = {
            TOKEN_KEY:'pillowfy_token', COOKIE_NAME:'token', LOGIN_URL:'/Login/Index',
            CLAIMS:{ name:'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name', role:'http://schemas.microsoft.com/ws/2008/06/identity/claims/role' },
            getToken(){ return this._readCookie(this.COOKIE_NAME)||localStorage.getItem(this.TOKEN_KEY); },
            parseJwt(t){ try{ return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); }catch{ return null; } },
            clearSession(){ localStorage.removeItem(this.TOKEN_KEY); document.cookie=`${this.COOKIE_NAME}=; Max-Age=0; path=/;`; },
            check(){
                const t=this.getToken(); if(!t){ this.redirect('no_token'); return null; }
                const p=this.parseJwt(t); if(!p){ this.redirect('invalid'); return null; }
                if(p[this.CLAIMS.role]!=='Owner'){ this.redirect('unauthorized'); return null; }
                return t;
            },
            redirect(r){ this.clearSession(); window.location.href=`${this.LOGIN_URL}?reason=${r}`; },
            _readCookie(n){ const m=document.cookie.match(new RegExp('(^| )'+n+'=([^;]+)')); return m?decodeURIComponent(m[2]):null; }
        };

        let chambres = [];
        let filtered  = [];
        let hotels    = [];
        let editingId = null;

        /* ── INIT ── */
        function init(){
            if(typeof lucide==='undefined'){ setTimeout(init,50); return; }
            lucide.createIcons();
            const token=SESSION.check(); if(!token) return;
            const p=SESSION.parseJwt(token);
            const name=(p[SESSION.CLAIMS.name]||'').split(' ')[0]||'Propriétaire';
            document.getElementById('userName').textContent=p[SESSION.CLAIMS.name]||name;
            document.getElementById('avatarInitial').textContent=name.charAt(0).toUpperCase();
            loadData(token);
        }

        async function loadData(token){
            token=token||SESSION.check(); if(!token) return;
            try{
                const [resH, resC] = await Promise.all([
                    fetch('/api/owner/hotels',   { headers:{'Authorization':'Bearer '+token}, credentials:'include' }),
                    fetch('/api/owner/chambres', { headers:{'Authorization':'Bearer '+token}, credentials:'include' })
                ]);
                if(resH.status===401||resC.status===401){ SESSION.redirect('unauthorized'); return; }
                hotels   = resH.ok  ? await resH.json()  : [];
                chambres = resC.ok  ? await resC.json()  : [];
                buildHotelFilters();
                applyFilters();
            }catch{
                showToast('Erreur de chargement.','error');
            }
        }

        function buildHotelFilters(){
            // filtre page
            const sel=document.getElementById('hotelFilter');
            const unique=[...new Set(chambres.map(c=>c.hotelName).filter(Boolean))];
            sel.innerHTML='<option value="">Tous les hôtels</option>';
            unique.forEach(h=>{ const o=document.createElement('option'); o.value=h; o.textContent=h; sel.appendChild(o); });

            // select dans le modal
            const mSel=document.getElementById('chambreHotel');
            mSel.innerHTML='<option value="">Choisir un hôtel...</option>';
            hotels.forEach(h=>{ const o=document.createElement('option'); o.value=h.id; o.textContent=h.name; mSel.appendChild(o); });
        }

        /* ── FILTERS ── */
        function applyFilters(){
            const search=(document.getElementById('searchInput').value||'').toLowerCase();
            const hotel=document.getElementById('hotelFilter').value;
            const avail=document.getElementById('availFilter').value;

            filtered=chambres.filter(c=>{
                const matchSearch=!search||(c.name||'').toLowerCase().includes(search)||(c.hotelName||'').toLowerCase().includes(search);
                const matchHotel=!hotel||c.hotelName===hotel;
                const matchAvail=!avail||
                    (avail==='available'&&c.isActive&&c.isAvailable)||
                    (avail==='occupied' &&c.isActive&&!c.isAvailable)||
                    (avail==='inactive' &&!c.isActive);
                return matchSearch&&matchHotel&&matchAvail;
            });

            renderChambres();
        }

        /* ── RENDER ── */
        function renderChambres(){
            const grid=document.getElementById('chambresGrid');
            const countEl=document.getElementById('chambreCount');
            countEl.textContent=chambres.length
                ? `${chambres.length} chambre${chambres.length>1?'s':''} enregistrée${chambres.length>1?'s':''}`
                : 'Aucune chambre';

            if(!filtered.length){
                grid.innerHTML=`
                    <div class="empty-state">
                        <i data-lucide="bed-double"></i>
                        <h3>Aucune chambre trouvée</h3>
                        <p>Ajoutez votre première chambre ou modifiez les filtres.</p>
                        <button class="btn btn-teal" onclick="openModal()"><i data-lucide="plus"></i> Ajouter une chambre</button>
                    </div>`;
                lucide.createIcons(); return;
            }

            grid.innerHTML=filtered.map(c=>{
                const badgeCls  = !c.isActive ? 'inactive' : c.isAvailable ? 'available' : 'occupied';
                const badgeTxt  = !c.isActive ? 'Inactive' : c.isAvailable ? 'Disponible' : 'Occupée';
                return `
                <div class="chambre-card${!c.isActive?' inactive':''}">
                    <div class="chambre-img">
                        ${c.imageUrl ? `<img src="${c.imageUrl}" alt="${c.name}">` : '🛏️'}
                        <span class="chambre-badge-avail ${badgeCls}">${badgeTxt}</span>
                    </div>
                    <div class="chambre-body">
                        <div class="chambre-hotel">${c.hotelName||'—'}</div>
                        <div class="chambre-name">${c.name}</div>
                        <div class="chambre-meta">
                            <div class="chambre-meta-item"><i data-lucide="users"></i> ${c.capacity} pers.</div>
                            <div class="chambre-meta-item"><i data-lucide="calendar"></i> ${c.reservationsCount} rés.</div>
                        </div>
                        <div class="chambre-price">${c.pricePerNight.toLocaleString('fr-FR')} € <span>/ nuit</span></div>
                        <div class="chambre-actions">
                            <button class="btn btn-ghost" style="flex:1;" onclick="editChambre(${c.id})">
                                <i data-lucide="pencil"></i> Modifier
                            </button>
                            <button class="btn btn-danger" onclick="deleteChambre(${c.id},'${c.name.replace(/'/g,"\\'")}')">
                                <i data-lucide="trash-2"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
            }).join('');
            lucide.createIcons();
        }

        /* ── IMAGE ── */
        function previewImage(event){
            const file=event.target.files[0]; if(!file) return;
            const preview=document.getElementById('chambreImagePreview');
            const zone=document.getElementById('imageDropZone');
            preview.src=URL.createObjectURL(file);
            preview.classList.add('visible');
            zone.classList.add('has-image');
            lucide.createIcons();
        }
        function triggerFileInput(event){ event.preventDefault(); event.stopPropagation(); document.getElementById('chambreImageFile').click(); }
        function resetImageZone(){
            const preview=document.getElementById('chambreImagePreview');
            const zone=document.getElementById('imageDropZone');
            preview.src=''; preview.classList.remove('visible'); zone.classList.remove('has-image');
            document.getElementById('chambreImageFile').value='';
        }

        /* ── MODAL ── */
        function openModal(chambre=null){
            editingId=chambre?chambre.id:null;
            document.getElementById('modalTitle').textContent=chambre?'Modifier la chambre':'Ajouter une chambre';
            document.getElementById('chambreId').value       = chambre?.id       ?? '';
            document.getElementById('chambreHotel').value   = chambre?.hotelId  ?? '';
            document.getElementById('chambreName').value    = chambre?.name     ?? '';
            document.getElementById('chambrePrice').value   = chambre?.pricePerNight ?? '';
            document.getElementById('chambreCapacity').value= chambre?.capacity  ?? '';
            document.getElementById('chambreDesc').value    = chambre?.description ?? '';
            resetImageZone();
            if(chambre?.imageUrl){
                const preview=document.getElementById('chambreImagePreview');
                const zone=document.getElementById('imageDropZone');
                preview.src=chambre.imageUrl; preview.classList.add('visible'); zone.classList.add('has-image');
            }
            document.getElementById('modalBackdrop').classList.add('open');
            lucide.createIcons();
        }

        function editChambre(id){ const c=chambres.find(x=>x.id===id); if(c) openModal(c); }
        function closeModal(){ document.getElementById('modalBackdrop').classList.remove('open'); }
        function closeModalOutside(e){ if(e.target===document.getElementById('modalBackdrop')) closeModal(); }

        /* ── SAVE ── */
        async function saveChambre(){
            const token=SESSION.check(); if(!token) return;
            const name    = document.getElementById('chambreName').value.trim();
            const hotelId = document.getElementById('chambreHotel').value;
            const price   = document.getElementById('chambrePrice').value;
            const capacity= document.getElementById('chambreCapacity').value;
            if(!name||!hotelId||!price||!capacity){ showToast('Nom, hôtel, prix et capacité sont obligatoires.','error'); return; }

            const btn=document.getElementById('saveBtn');
            btn.disabled=true; btn.textContent='Enregistrement...';

            try{
                const url    = editingId ? `/api/owner/chambres/${editingId}` : '/api/owner/chambres';
                const method = editingId ? 'PUT' : 'POST';

                const formData=new FormData();
                formData.append('name',        name);
                formData.append('hotelId',     hotelId);
                formData.append('pricePerNight', price);
                formData.append('capacity',    capacity);
                formData.append('description', document.getElementById('chambreDesc').value.trim());
                const file=document.getElementById('chambreImageFile').files[0];
                if(file) formData.append('image', file);

                const res=await fetch(url,{
                    method, headers:{'Authorization':'Bearer '+token},
                    body:formData, credentials:'include'
                });
                if(!res.ok){ const err=await res.json().catch(()=>({})); throw new Error(err.message||'Erreur serveur'); }

                closeModal();
                showToast(editingId?'Chambre modifiée.':'Chambre ajoutée.','success');
                await loadData(token);
            }catch(e){
                showToast(e.message,'error');
            }finally{
                btn.disabled=false;
                btn.innerHTML='<i data-lucide="check"></i> Enregistrer';
                lucide.createIcons();
            }
        }

        /* ── DELETE ── */
        async function deleteChambre(id, name){
            if(!confirm(`Supprimer "${name}" ? Cette action est irréversible.`)) return;
            const token=SESSION.check(); if(!token) return;
            try{
                const res=await fetch(`/api/owner/chambres/${id}`,{
                    method:'DELETE', headers:{'Authorization':'Bearer '+token}, credentials:'include'
                });
                if(!res.ok) throw new Error('Suppression échouée.');
                showToast('Chambre supprimée.','success');
                await loadData(token);
            }catch(e){ showToast(e.message,'error'); }
        }

        /* ── TOAST ── */
        function showToast(msg,type='success'){
            const t=document.getElementById('toast');
            t.textContent=(type==='success'?'✓ ':'⚠ ')+msg;
            t.className=`toast show ${type}`;
            setTimeout(()=>t.className='toast',3000);
        }

        /* ── LOGOUT ── */
        async function logout(){
            const token=SESSION.getToken();
            if(token) await fetch('/api/auth/logout',{method:'POST',headers:{'Authorization':'Bearer '+token},credentials:'include'}).catch(()=>{});
            SESSION.clearSession(); window.location.href=SESSION.LOGIN_URL;
        }

        document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();
    </script>
</body>
</html>