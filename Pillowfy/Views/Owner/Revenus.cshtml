@{
    ViewData["Title"] = "Revenus";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Revenus</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 0.5rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display',serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .owner-badge-side {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: 0 0.8rem 1.5rem;
            background: rgba(26,107,107,0.18);
            border: 1px solid rgba(26,107,107,0.35);
            border-radius: 8px;
            padding: 5px 10px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #4ECDC4;
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(26,107,107,0.18);
                color: #4ECDC4;
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(26,107,107,0.25);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .nav-badge {
            margin-left: auto;
            background: #4ECDC4;
            color: var(--ink);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 100px;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg,#1A6B6B,#4ECDC4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display',serif;
            font-size: 0.9rem;
            color: var(--white);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: #4ECDC4;
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans',sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(26,107,107,0.4) transparent;
        }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

            .main > * {
                animation: fadeUp 0.38s ease both;
            }

                .main > *:nth-child(2) {
                    animation-delay: .05s;
                }

                .main > *:nth-child(3) {
                    animation-delay: .10s;
                }

                .main > *:nth-child(4) {
                    animation-delay: .14s;
                }

                .main > *:nth-child(5) {
                    animation-delay: .18s;
                }

        /* TOPBAR */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display',serif;
            font-size: 1.6rem;
            color: var(--ink);
        }

            .topbar-left h1 em {
                font-style: italic;
                color: #1A6B6B;
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

        .btn-danger {
            background: rgba(220,38,38,0.10);
            color: #f87171;
            border: 1px solid rgba(220,38,38,0.25);
        }

            .btn-danger:hover {
                background: rgba(220,38,38,0.20);
            }

        /* STATS */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.3rem 1.4rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: all .2s;
        }

            .stat-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
            }

        .stat-icon-wrap {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .stat-icon-wrap svg {
                width: 18px;
                height: 18px;
            }

            .stat-icon-wrap.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stat-icon-wrap.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .stat-icon-wrap.green {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stat-icon-wrap.rose {
                background: var(--rose-lt);
                color: var(--rose);
            }

        .stat-label {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
            margin-bottom: 3px;
        }

        .stat-value {
            font-family: 'DM Serif Display',serif;
            font-size: 0.95rem;
            color: var(--ink);
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* CARD */
        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.5rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            margin-bottom: 1rem;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .card-title {
            font-family: 'DM Serif Display',serif;
            font-size: 0.98rem;
            color: var(--ink);
        }

        /* CHART */
        .chart-wrap {
            position: relative;
            width: 100%;
            height: 200px;
            display: flex;
            align-items: flex-end;
            gap: 6px;
            padding-top: 24px;
        }

        .chart-bar-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            height: 100%;
            justify-content: flex-end;
        }

        .chart-bar-val {
            font-size: 0.62rem;
            font-weight: 700;
            color: var(--teal);
            white-space: nowrap;
        }

        .chart-bar {
            width: 100%;
            border-radius: 7px 7px 0 0;
            background: linear-gradient(180deg,#4ECDC4,#1A6B6B);
            transition: height 0.9s ease;
            min-height: 4px;
            position: relative;
            cursor: pointer;
        }

            .chart-bar:hover {
                filter: brightness(1.15);
            }

        .chart-bar-lbl {
            font-size: 0.65rem;
            color: var(--ink-60);
            white-space: nowrap;
        }

        .chart-bar.gold-bar {
            background: linear-gradient(180deg,#e8c080,#C9A96E);
        }

        .chart-tooltip {
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--ink);
            color: var(--white);
            font-size: 0.7rem;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity .15s;
            z-index: 10;
        }

        .chart-bar:hover .chart-tooltip {
            opacity: 1;
        }

        /* GRID */
        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        /* HOTEL BREAKDOWN */
        .hotel-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .hotel-row:last-child {
                border-bottom: none;
            }

        .hotel-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .hotel-name {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink);
            flex: 1;
        }

        .hotel-rev {
            font-family: 'DM Serif Display',serif;
            font-size: 0.92rem;
            color: var(--ink);
        }

        .hotel-pct {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .hotel-bar-wrap {
            width: 80px;
        }

        .mini-bar {
            height: 4px;
            background: rgba(15,22,33,0.07);
            border-radius: 100px;
            overflow: hidden;
        }

        .mini-bar-fill {
            height: 100%;
            border-radius: 100px;
            transition: width 0.8s ease;
        }

        /* TABLE */
        .res-table {
            width: 100%;
            border-collapse: collapse;
        }

            .res-table th {
                font-size: 0.68rem;
                font-weight: 600;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                color: var(--ink-30);
                padding: 0.5rem 0.8rem;
                text-align: left;
                border-bottom: 1px solid rgba(15,22,33,0.07);
            }

            .res-table td {
                padding: 0.85rem 0.8rem;
                font-size: 0.83rem;
                color: var(--ink);
                border-bottom: 1px solid rgba(15,22,33,0.05);
            }

            .res-table tr:last-child td {
                border-bottom: none;
            }

            .res-table tr:hover td {
                background: rgba(26,107,107,0.03);
            }

        .badge {
            display: inline-flex;
            align-items: center;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 100px;
        }

            .badge.confirmed {
                background: rgba(26,107,107,0.10);
                color: var(--teal);
            }

            .badge.completed {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .badge.cancelled {
                background: var(--rose-lt);
                color: var(--rose);
            }

            .badge.pending {
                background: var(--gold-lt);
                color: #9A722E;
            }

        /* PERIOD SELECTOR */
        .period-btns {
            display: flex;
            gap: 4px;
        }

        .period-btn {
            padding: 0.3rem 0.85rem;
            border-radius: 100px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid rgba(15,22,33,0.12);
            background: transparent;
            color: var(--ink-60);
            transition: all .14s;
            font-family: 'DM Sans',sans-serif;
        }

            .period-btn.active {
                background: var(--teal);
                color: var(--white);
                border-color: var(--teal);
            }

        /* SKELETON / EMPTY */
        .skeleton {
            background: linear-gradient(90deg,rgba(15,22,33,0.06) 25%,rgba(15,22,33,0.10) 50%,rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 6px;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem;
            gap: 8px;
        }

            .empty-state svg {
                width: 32px;
                height: 32px;
                color: var(--ink-30);
            }

            .empty-state p {
                font-size: 0.82rem;
                color: var(--ink-60);
                text-align: center;
            }

        /* PAGINATION */
        .pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
        }

        .page-info {
            font-size: 0.78rem;
            color: var(--ink-60);
        }

        .page-btns {
            display: flex;
            gap: 4px;
        }

        .page-btn {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            border: 1px solid rgba(15,22,33,0.10);
            background: transparent;
            font-family: 'DM Sans',sans-serif;
            font-size: 0.78rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ink-60);
            transition: all .14s;
        }

            .page-btn:hover {
                background: var(--teal-lt);
                color: var(--teal);
                border-color: var(--teal);
            }

            .page-btn.active {
                background: var(--teal);
                color: var(--white);
                border-color: var(--teal);
            }

            .page-btn:disabled {
                opacity: 0.4;
                cursor: default;
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width:1200px) {
            .stats-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .two-col {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width:900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }
        }

        @@media (max-width:600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="owner-badge-side">
                <i data-lucide="building-2" style="width:12px;height:12px;"></i> Espace Propriétaire
            </div>
            <div class="sidebar-content">
                <div>
                    <div class="sidebar-section-label">Navigation</div>
                    <nav class="sidebar-nav">
                        <a href="/Owner/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                        <a href="/Owner/Hotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Mes hôtels</a>
                        <a href="/Owner/Chambres" class="nav-item"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Chambres</a>
                        <a href="/Owner/Reservations" class="nav-item"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Réservations<span class="nav-badge" id="nbReservations" style="display:none;"></span></a>
                        <a href="/Owner/Paiements" class="nav-item"><span class="nav-icon"><i data-lucide="credit-card"></i></span> Paiements</a>
                        <a href="/Owner/Revenus" class="nav-item active"><span class="nav-icon"><i data-lucide="trending-up"></i></span> Revenus</a>
                        <a href="/Owner/Avis" class="nav-item"><span class="nav-icon"><i data-lucide="star"></i></span> Avis clients</a>
                    </nav>
                </div>
                <div>
                    <div class="sidebar-section-label">Compte</div>
                    <nav class="sidebar-nav">
                        <a href="/Owner/Profil" class="nav-item"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                        <a href="/Owner/Parametres" class="nav-item"><span class="nav-icon"><i data-lucide="settings"></i></span> Paramètres</a>
                    </nav>
                </div>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role">Propriétaire</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">
                <div class="topbar-left">
                    <h1>Mes <em>Revenus</em></h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <button class="btn btn-danger" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrap green"><i data-lucide="trending-up"></i></div>
                    <div>
                        <div class="stat-label">Ce mois</div>
                        <div class="stat-value" id="statMois"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Revenus du mois</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap teal"><i data-lucide="calendar"></i></div>
                    <div>
                        <div class="stat-label">Cette année</div>
                        <div class="stat-value" id="statAnnee"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Cumul annuel</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap gold"><i data-lucide="bar-chart-2"></i></div>
                    <div>
                        <div class="stat-label">Meilleur mois</div>
                        <div class="stat-value" id="statBest"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub" id="statBestLabel">—</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap rose"><i data-lucide="activity"></i></div>
                    <div>
                        <div class="stat-label">Moyenne / mois</div>
                        <div class="stat-value" id="statAvg"><span class="skeleton" style="width:70px;height:18px;display:block;"></span></div>
                        <div class="stat-sub">Sur les 6 derniers mois</div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUE -->
            <div class="card">
                <div class="card-header">
                    <span class="card-title">Évolution des revenus</span>
                    <div class="period-btns">
                        <button class="period-btn active" onclick="setPeriod(this,6)">6 mois</button>
                        <button class="period-btn" onclick="setPeriod(this,12)">12 mois</button>
                    </div>
                </div>
                <div id="chartWrap">
                    <div class="skeleton" style="height:200px;width:100%;border-radius:10px;"></div>
                </div>
            </div>

            <!-- RÉPARTITION + DÉTAIL PAR HÔTEL -->
            <div class="two-col">
                <div class="card">
                    <div class="card-header"><span class="card-title">Répartition par hôtel</span></div>
                    <div id="hotelBreakdown">
                        <div class="skeleton" style="height:18px;width:60%;margin-bottom:12px;"></div>
                        <div class="skeleton" style="height:18px;width:80%;margin-bottom:12px;"></div>
                        <div class="skeleton" style="height:18px;width:50%;"></div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header"><span class="card-title">Résumé mensuel</span></div>
                    <div id="resumeMensuel">
                        <div class="skeleton" style="height:18px;width:100%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:18px;width:100%;margin-bottom:8px;"></div>
                        <div class="skeleton" style="height:18px;width:100%;"></div>
                    </div>
                </div>
            </div>

            <!-- TABLE DES RÉSERVATIONS GÉNÉRATRICES DE REVENUS -->
            <div class="card">
                <div class="card-header">
                    <span class="card-title">Détail des réservations</span>
                    <input class="search-input" type="text" placeholder="Rechercher…" id="searchInput" oninput="filterRevTable()" style="padding:0.4rem 1rem;border-radius:100px;border:1px solid rgba(15,22,33,0.12);font-family:'DM Sans',sans-serif;font-size:0.82rem;color:var(--ink);background:var(--bg);outline:none;width:200px;">
                </div>
                <div id="revTableWrap">
                    <div class="skeleton" style="height:42px;width:100%;margin-bottom:8px;border-radius:8px;"></div>
                    <div class="skeleton" style="height:42px;width:100%;margin-bottom:8px;border-radius:8px;"></div>
                    <div class="skeleton" style="height:42px;width:100%;border-radius:8px;"></div>
                </div>
                <div class="pagination" id="paginationWrap" style="display:none;">
                    <span class="page-info" id="pageInfo"></span>
                    <div class="page-btns" id="pageBtns"></div>
                </div>
            </div>

        </main>
    </div>

    <script>
        /* ── SESSION (identique dashboard) ── */
        const SESSION = {
            TOKEN_KEY:'pillowfy_token', REFRESH_TOKEN_KEY:'pillowfy_refresh',
            COOKIE_NAME:'token', LOGIN_URL:'/Login/Index',
            REFRESH_URL:'/api/auth/refresh', REFRESH_THRESHOLD:5*60, CHECK_INTERVAL:60*1000,
            CLAIMS:{ name:'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name', email:'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress', role:'http://schemas.microsoft.com/ws/2008/06/identity/claims/role' },
            _heartbeatTimer:null,
            getToken()        { return this._readCookie(this.COOKIE_NAME)||localStorage.getItem(this.TOKEN_KEY); },
            getRefreshToken() { return this._readCookie('refresh_token') ||localStorage.getItem(this.REFRESH_TOKEN_KEY); },
            saveToken(t)      { localStorage.setItem(this.TOKEN_KEY,t); },
            clearSession()    { localStorage.removeItem(this.TOKEN_KEY); localStorage.removeItem(this.REFRESH_TOKEN_KEY); document.cookie=`${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`; document.cookie=`refresh_token=; Max-Age=0; path=/; SameSite=Strict`; if(this._heartbeatTimer) clearInterval(this._heartbeatTimer); },
            parseJwt(t)       { try{ return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); }catch{ return null; } },
            secondsLeft(p)    { if(!p?.exp) return Infinity; return p.exp - Math.floor(Date.now()/1000); },
            async tryRefresh(){ const rt=this.getRefreshToken(); if(!rt) return false; try{ const r=await fetch(this.REFRESH_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({refreshToken:rt}),credentials:'include'}); if(!r.ok) return false; const d=await r.json(); if(d.token){this.saveToken(d.token);return true;} return false; }catch{ return false; } },
            async check()     { const t=this.getToken(); if(!t){this.redirectLogin('no_token');return false;} const p=this.parseJwt(t); if(!p){this.redirectLogin('invalid_token');return false;} if(p[this.CLAIMS.role]!=='Owner'){this.redirectLogin('unauthorized_role');return false;} const l=this.secondsLeft(p); if(l<=0){const r=await this.tryRefresh();if(!r){this.redirectLogin('expired');return false;}return true;} if(l<this.REFRESH_THRESHOLD) this.tryRefresh(); return true; },
            redirectLogin(r)  { this.clearSession(); const u=new URL(this.LOGIN_URL,window.location.origin); u.searchParams.set('reason',r); u.searchParams.set('returnUrl',window.location.pathname); window.location.href=u.toString(); },
            startHeartbeat()  { if(this._heartbeatTimer) clearInterval(this._heartbeatTimer); this._heartbeatTimer=setInterval(()=>this.check(),this.CHECK_INTERVAL); document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible') this.check();}); },
            _readCookie(n)    { const m=document.cookie.match(new RegExp('(^| )'+n+'=([^;]+)')); return m?decodeURIComponent(m[2]):null; }
        };

        /* ── DATE ── */
        (function(){
            const d=new Date();
            const j=['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const m=['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent=j[d.getDay()]+' '+d.getDate()+' '+m[d.getMonth()]+' '+d.getFullYear();
        })();

        /* ── STATE ── */
        let allData = {};
        let currentPeriod = 6;
        let allReservations = [];
        let currentPage = 1;
        const PAGE_SIZE = 10;

        const fmt  = d => new Date(d).toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'});
        const fmtM = v => v >= 1000 ? (v/1000).toFixed(1)+'k €' : v.toLocaleString('fr-FR')+' €';
        const DOT_COLORS = ['#1A6B6B','#C9A96E','#22c55e','#C0596A','#7c3aed','#f97316'];

        function statusBadge(s) {
            const map = { Confirmed:{cls:'confirmed',label:'↗ Confirmée'}, Cancelled:{cls:'cancelled',label:'✕ Annulée'}, Completed:{cls:'completed',label:'✓ Terminée'}, Pending:{cls:'pending',label:'⏳ En attente'} };
            const x = map[s]||{cls:'pending',label:s};
            return `<span class="badge ${x.cls}">${x.label}</span>`;
        }

        /* ── GRAPHIQUE ── */
        function renderChart(months) {
            const wrap = document.getElementById('chartWrap');
            if (!months?.length) {
                wrap.innerHTML = `<div class="empty-state"><i data-lucide="trending-up"></i><p>Aucune donnée disponible.</p></div>`;
                lucide.createIcons(); return;
            }
            const maxVal = Math.max(...months.map(m=>Number(m.montant)),1);
            const MAX_H  = 170;
            wrap.innerHTML = `<div class="chart-wrap">${months.map((m,i) => {
                const h   = Math.max(4, Math.round(Number(m.montant)/maxVal*MAX_H));
                const isGold = i === months.findIndex(x=>x.montant===Math.max(...months.map(z=>z.montant)));
                return `<div class="chart-bar-col">
                    <div class="chart-bar-val">${fmtM(Number(m.montant))}</div>
                    <div class="chart-bar ${isGold?'gold-bar':''}" data-h="${h}" style="height:4px;">
                        <div class="chart-tooltip">${m.mois} : ${fmtM(Number(m.montant))}</div>
                    </div>
                    <div class="chart-bar-lbl">${m.mois}</div>
                </div>`;
            }).join('')}</div>`;
            setTimeout(()=>{ wrap.querySelectorAll('.chart-bar').forEach(el=>{ el.style.height=el.dataset.h+'px'; }); }, 200);
        }

        function setPeriod(btn, n) {
            document.querySelectorAll('.period-btn').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            currentPeriod = n;
            const months = (allData.revenusMensuels||[]).slice(-n);
            renderChart(months);
        }

        /* ── HOTEL BREAKDOWN ── */
        function renderBreakdown(hotels) {
            const wrap = document.getElementById('hotelBreakdown');
            if (!hotels?.length) { wrap.innerHTML = `<div class="empty-state"><i data-lucide="building-2"></i><p>Aucun hôtel.</p></div>`; lucide.createIcons(); return; }
            const total = hotels.reduce((s,h)=>s+Number(h.revenus),0)||1;
            wrap.innerHTML = hotels.map((h,i)=>{
                const pct = Math.round(Number(h.revenus)/total*100);
                return `<div class="hotel-row">
                    <div class="hotel-dot" style="background:${DOT_COLORS[i%DOT_COLORS.length]};"></div>
                    <div style="flex:1;min-width:0;">
                        <div class="hotel-name">${h.hotelName}</div>
                        <div class="hotel-pct">${pct}% du total</div>
                    </div>
                    <div style="text-align:right;">
                        <div class="hotel-rev">${fmtM(Number(h.revenus))}</div>
                        <div class="hotel-bar-wrap" style="margin-top:4px;">
                            <div class="mini-bar"><div class="mini-bar-fill" data-w="${pct}" style="width:0%;background:${DOT_COLORS[i%DOT_COLORS.length]};"></div></div>
                        </div>
                    </div>
                </div>`;
            }).join('');
            setTimeout(()=>{ wrap.querySelectorAll('.mini-bar-fill').forEach(el=>{ el.style.width=el.dataset.w+'%'; }); }, 300);
        }

        /* ── RÉSUMÉ MENSUEL ── */
        function renderResume(months) {
            const wrap = document.getElementById('resumeMensuel');
            if (!months?.length) { wrap.innerHTML='<p style="font-size:.82rem;color:var(--ink-60);">—</p>'; return; }
            wrap.innerHTML = `<table class="res-table">
                <thead><tr><th>Mois</th><th style="text-align:right;">Revenus</th><th style="text-align:right;">Évol.</th></tr></thead>
                <tbody>
                    ${months.slice().reverse().slice(0,6).map((m,i,arr)=>{
                        const prev = arr[i+1];
                        let evol = '';
                        if (prev && prev.montant > 0) {
                            const delta = Math.round((m.montant-prev.montant)/prev.montant*100);
        evol = `<span style="color:${delta>=0 ? '#16a34a' : 'var(--rose)'};font-size:.72rem;font-weight:700;">${delta>=0 ? '▲' : '▼'} ${Math.abs(delta)}%</span>`;                        }
                        return `<tr>
                            <td style="font-weight:600;">${m.mois}</td>
                            <td style="text-align:right;font-family:'DM Serif Display',serif;">${fmtM(Number(m.montant))}</td>
                            <td style="text-align:right;">${evol||'—'}</td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>`;
        }

        /* ── TABLE RÉSERVATIONS ── */
        function filterRevTable() { currentPage = 1; renderRevTable(); }

        function renderRevTable() {
            const q = (document.getElementById('searchInput')?.value||'').toLowerCase();
            const data = allReservations.filter(r => !q ||
                (r.clientName||'').toLowerCase().includes(q) ||
                (r.chambreName||'').toLowerCase().includes(q) ||
                (r.hotelName||'').toLowerCase().includes(q));

            const total = data.length;
            const pages = Math.ceil(total/PAGE_SIZE)||1;
            const start = (currentPage-1)*PAGE_SIZE;
            const slice = data.slice(start, start+PAGE_SIZE);
            const wrap  = document.getElementById('revTableWrap');

            if (!slice.length) {
                wrap.innerHTML = `<div class="empty-state"><i data-lucide="calendar-x"></i><p>Aucune réservation trouvée.</p></div>`;
                lucide.createIcons();
                document.getElementById('paginationWrap').style.display='none';
                return;
            }

            wrap.innerHTML = `<table class="res-table">
                <thead><tr><th>Client</th><th>Hôtel</th><th>Chambre</th><th>Arrivée</th><th>Départ</th><th>Nuits</th><th>Montant</th><th>Statut</th></tr></thead>
                <tbody>${slice.map(r=>{
                    const nights = Math.max(1,Math.round((new Date(r.checkOut)-new Date(r.checkIn))/86400000));
                    return `<tr>
                        <td style="font-weight:600;">${r.clientName||'—'}</td>
                        <td style="color:var(--ink-60);">${r.hotelName||'—'}</td>
                        <td style="color:var(--ink-60);">${r.chambreName||'—'}</td>
                        <td style="color:var(--ink-60);">${fmt(r.checkIn)}</td>
                        <td style="color:var(--ink-60);">${fmt(r.checkOut)}</td>
                        <td style="text-align:center;">${nights}</td>
                        <td style="font-weight:700;font-family:'DM Serif Display',serif;">${Number(r.totalPrice).toLocaleString('fr-FR')} €</td>
                        <td>${statusBadge(r.status)}</td>
                    </tr>`;
                }).join('')}</tbody>
            </table>`;

            const pagWrap = document.getElementById('paginationWrap');
            pagWrap.style.display = 'flex';
            document.getElementById('pageInfo').textContent = `${start+1}–${Math.min(start+PAGE_SIZE,total)} sur ${total} réservations`;
            const btns = document.getElementById('pageBtns');
            btns.innerHTML = '';
            const addBtn = (label,page,disabled,active)=>{
                const b=document.createElement('button'); b.className='page-btn'+(active?' active':''); b.textContent=label; b.disabled=disabled;
                if(!disabled) b.onclick=()=>{currentPage=page;renderRevTable();};
                btns.appendChild(b);
            };
            addBtn('‹',currentPage-1,currentPage===1,false);
            for(let i=1;i<=pages;i++) addBtn(i,i,false,i===currentPage);
            addBtn('›',currentPage+1,currentPage===pages,false);
        }

        /* ── LOAD ── */
        async function loadUser() {
            const ok = await SESSION.check(); if (!ok) return;
            const token = SESSION.getToken();
            const p = SESSION.parseJwt(token);
            const fullName = p[SESSION.CLAIMS.name]||'';
            const firstName = fullName.split(' ')[0]||'Propriétaire';
            document.getElementById('userName').textContent      = fullName||p[SESSION.CLAIMS.email];
            document.getElementById('avatarInitial').textContent = firstName.charAt(0).toUpperCase();
            SESSION.startHeartbeat();
            await loadRevenus(token);
        }

        async function loadRevenus(token) {
            const headers = { 'Authorization':'Bearer '+token, 'Content-Type':'application/json' };
            try {
                const [revRes, resRes] = await Promise.all([
                    fetch('/api/owner/revenus', { headers, credentials:'include' }),
                    fetch('/api/owner/reservations', { headers, credentials:'include' }),
                ]);
                if (revRes.status===401) { SESSION.redirectLogin('unauthorized'); return; }

                if (revRes.ok) {
                    allData = await revRes.json();
                    const months = allData.revenusMensuels || [];

                    /* Stats */
                    const now = new Date();
                    const thisMois = months.find(m => m.moisIndex === now.getMonth()+1 && m.annee === now.getFullYear());
                    document.getElementById('statMois').textContent  = thisMois ? fmtM(Number(thisMois.montant)) : '—';
                    const annee = months.filter(m=>m.annee===now.getFullYear()).reduce((s,m)=>s+Number(m.montant),0);
                    document.getElementById('statAnnee').textContent = fmtM(annee);
                    const best  = months.reduce((a,b)=>Number(a.montant)>Number(b.montant)?a:b, months[0]||{montant:0});
                    document.getElementById('statBest').textContent  = fmtM(Number(best?.montant||0));
                    document.getElementById('statBestLabel').textContent = best?.mois||'—';
                    const last6 = months.slice(-6);
                    const avg   = last6.length ? last6.reduce((s,m)=>s+Number(m.montant),0)/last6.length : 0;
                    document.getElementById('statAvg').textContent   = fmtM(Math.round(avg));

                    /* Chart */
                    renderChart(months.slice(-currentPeriod));

                    /* Breakdown */
                    renderBreakdown(allData.parHotel||[]);

                    /* Résumé */
                    renderResume(months);
                }

                if (resRes.ok) {
                    const resData = await resRes.json();
                    allReservations = (Array.isArray(resData) ? resData : resData.reservations || [])
                        .filter(r => r.status !== 'Cancelled');
                    renderRevTable();
                }

            } catch(e) {
                console.error('[Revenus]', e);
            }
        }

        async function logout() {
            try { const t=SESSION.getToken(); if(t) await fetch('/api/auth/logout',{method:'POST',headers:{'Authorization':'Bearer '+t,'Content-Type':'application/json'},credentials:'include'}).catch(()=>{}); }
            finally { SESSION.clearSession(); window.location.href=SESSION.LOGIN_URL; }
        }

        function init() {
            if (typeof lucide === 'undefined') { setTimeout(init,50); return; }
            lucide.createIcons();
            loadUser();
        }
        document.readyState==='loading' ? document.addEventListener('DOMContentLoaded',init) : init();
    </script>
</body>
</html>
