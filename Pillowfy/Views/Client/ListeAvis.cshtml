@{
    ViewData["Title"] = "Mes avis";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mes avis</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@0.383.0/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            gap: 10px;
        }

        /* STATS */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.6rem;
        }

        .stat-card {
            background: var(--white);
            border-radius: 16px;
            padding: 1.2rem 1.4rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .stat-icon.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stat-icon.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .stat-icon.rose {
                background: var(--rose-lt);
                color: var(--rose);
            }

            .stat-icon svg {
                width: 20px;
                height: 20px;
            }

        .stat-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: var(--ink);
        }

        .stat-lbl {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* TOOLBAR */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .toolbar-left {
            display: flex;
            gap: 8px;
        }

        .filter-btn {
            padding: 0.45rem 1rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            border: 1.5px solid rgba(15,22,33,0.12);
            background: transparent;
            color: var(--ink-60);
            transition: all .16s;
        }

            .filter-btn.active {
                background: var(--ink);
                color: var(--white);
                border-color: var(--ink);
            }

            .filter-btn:hover:not(.active) {
                border-color: var(--gold);
                color: var(--gold);
            }

        /* BTN */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,169,110,0.3);
            }

            .btn-gold:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .btn-outline {
            background: transparent;
            color: var(--ink-60);
            border: 1px solid rgba(15,22,33,0.15);
        }

            .btn-outline:hover {
                background: rgba(15,22,33,0.05);
            }

        .btn-danger-sm {
            background: var(--rose-lt);
            color: var(--rose);
            border: 1px solid rgba(192,89,106,0.25);
            padding: 0.38rem 0.8rem;
            font-size: 0.76rem;
            border-radius: 100px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            transition: all .16s;
        }

            .btn-danger-sm:hover {
                background: rgba(192,89,106,0.18);
            }

        .btn-edit-sm {
            background: var(--gold-lt);
            color: #9A722E;
            border: 1px solid rgba(201,169,110,0.3);
            padding: 0.38rem 0.8rem;
            font-size: 0.76rem;
            border-radius: 100px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            transition: all .16s;
        }

            .btn-edit-sm:hover {
                background: rgba(201,169,110,0.22);
            }

            .btn-danger-sm svg, .btn-edit-sm svg {
                width: 12px;
                height: 12px;
            }

        /* AVIS LIST */
        .avis-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .avis-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.4rem 1.6rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            animation: fadeUp 0.3s ease both;
        }

        .avis-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }

        .avis-hotel-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avis-hotel-thumb {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            overflow: hidden;
            flex-shrink: 0;
        }

            .avis-hotel-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .avis-hotel-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
        }

        .avis-date {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .avis-actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .stars {
            display: flex;
            gap: 3px;
        }

        .star {
            font-size: 1rem;
        }

            .star.filled {
                color: var(--gold);
            }

            .star.empty {
                color: rgba(15,22,33,0.15);
            }

        .avis-note-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .note-badge {
            padding: 0.25rem 0.7rem;
            background: var(--gold-lt);
            color: #7A5E1A;
            border-radius: 100px;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .avis-commentaire {
            font-size: 0.86rem;
            color: var(--ink-60);
            line-height: 1.6;
            border-left: 3px solid var(--gold-lt);
            padding-left: 1rem;
        }

        /* EMPTY STATE */
        .empty-state {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 3rem;
            text-align: center;
            border: 1px dashed rgba(201,169,110,0.3);
        }

        .empty-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .empty-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--ink);
            margin-bottom: 0.5rem;
        }

        .empty-sub {
            font-size: 0.84rem;
            color: var(--ink-60);
            margin-bottom: 1.4rem;
        }

        /* SKELETON */
        .skeleton {
            background: linear-gradient(90deg,rgba(15,22,33,0.06) 25%,rgba(15,22,33,0.10) 50%,rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 16px;
        }

        /* MODAL */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,22,33,0.55);
            backdrop-filter: blur(4px);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 2rem;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 24px 60px rgba(15,22,33,0.18);
            animation: fadeUp 0.25s ease;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--ink);
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(15,22,33,0.06);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ink-60);
            transition: all .16s;
        }

            .modal-close:hover {
                background: rgba(15,22,33,0.12);
            }

            .modal-close svg {
                width: 15px;
                height: 15px;
            }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 1rem;
        }

        .form-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 0.9rem;
            border-radius: 11px;
            border: 1.5px solid rgba(15,22,33,0.10);
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.86rem;
            color: var(--ink);
            transition: all .16s;
            outline: none;
        }

            .form-input:focus {
                border-color: rgba(201,169,110,0.5);
                background: var(--white);
                box-shadow: 0 0 0 3px rgba(201,169,110,0.08);
            }

        textarea.form-input {
            resize: vertical;
            min-height: 100px;
        }

        .form-error {
            font-size: 0.72rem;
            color: var(--rose);
            display: none;
        }

            .form-error.show {
                display: block;
            }

        /* STAR PICKER */
        .star-picker {
            display: flex;
            gap: 6px;
        }

        .star-pick {
            font-size: 1.6rem;
            cursor: pointer;
            transition: transform .12s;
            color: rgba(15,22,33,0.15);
        }

            .star-pick.on {
                color: var(--gold);
            }

            .star-pick:hover {
                transform: scale(1.2);
            }

        /* SELECT HOTEL */
        .hotel-select-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            max-height: 260px;
            overflow-y: auto;
            margin-bottom: 1rem;
        }

        .hotel-option {
            border: 1.5px solid rgba(15,22,33,0.10);
            border-radius: 13px;
            padding: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .hotel-option:hover {
                border-color: var(--gold);
                background: var(--gold-lt);
            }

            .hotel-option.selected {
                border-color: var(--gold);
                background: var(--gold-lt);
            }

        .hotel-option-thumb {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            object-fit: cover;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            overflow: hidden;
        }

            .hotel-option-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .hotel-option-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .hotel-option-city {
            font-size: 0.7rem;
            color: var(--ink-60);
        }

        /* CONFIRM DELETE */
        .confirm-modal {
            max-width: 400px;
            text-align: center;
        }

        .confirm-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--rose-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            color: var(--rose);
        }

            .confirm-icon svg {
                width: 28px;
                height: 28px;
            }

        .confirm-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .confirm-sub {
            font-size: 0.84rem;
            color: var(--ink-60);
            margin-bottom: 1.4rem;
        }

        .confirm-btns {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            background: var(--ink);
            color: var(--white);
            border-radius: 13px;
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.84rem;
            font-weight: 500;
            box-shadow: 0 8px 32px rgba(15,22,33,0.18);
            opacity: 0;
            transform: translateY(10px);
            transition: all .3s;
            pointer-events: none;
        }

            .toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .toast.success {
                border-left: 3px solid #22c55e;
            }

            .toast.error {
                border-left: 3px solid var(--rose);
            }

            .toast svg {
                width: 16px;
                height: 16px;
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0
            }

            100% {
                background-position: -200% 0
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
            }
        }

        @@media (max-width: 600px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            .hotel-select-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="sidebar-content">
                <div class="sidebar-section-label">Navigation</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                    <a href="/Client/ListeHotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Hôtels</a>
                    <a href="/Client/ListeReservations" class="nav-item"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Mes réservations</a>
                    <a href="/Client/Sejours" class="nav-item"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Historique séjours</a>
                    <a href="/Client/Factures" class="nav-item"><span class="nav-icon"><i data-lucide="receipt"></i></span> Factures</a>
                    <a href="/Client/Services" class="nav-item"><span class="nav-icon"><i data-lucide="concierge-bell"></i></span> Services</a>
                </nav>
                <div class="sidebar-section-label">Compte</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Profil" class="nav-item"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                    <a href="/Client/Fidelite" class="nav-item"><span class="nav-icon"><i data-lucide="star"></i></span> Fidélité</a>
                    <a href="/Client/Avis" class="nav-item active"><span class="nav-icon"><i data-lucide="message-circle"></i></span> Mes avis</a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role" id="userRole">Client</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="topbar">
                <div class="topbar-left">
                    <h1>Mes <em>avis</em></h1>
                    <p id="dateLabel"></p>
                </div>
                <div class="topbar-right">
                    <button class="btn btn-gold" onclick="openAddModal()">
                        <i data-lucide="plus"></i> Ajouter un avis
                    </button>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-row" id="statsRow">
                <div class="stat-card">
                    <div class="stat-icon gold"><i data-lucide="message-circle"></i></div>
                    <div><div class="stat-val" id="statTotal">—</div><div class="stat-lbl">Avis publiés</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon teal"><i data-lucide="star"></i></div>
                    <div><div class="stat-val" id="statMoyenne">—</div><div class="stat-lbl">Note moyenne donnée</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon rose"><i data-lucide="building-2"></i></div>
                    <div><div class="stat-val" id="statHotels">—</div><div class="stat-lbl">Hôtels évalués</div></div>
                </div>
            </div>

            <!-- TOOLBAR -->
            <div class="toolbar">
                <div class="toolbar-left">
                    <button class="filter-btn active" onclick="setFilter('all', this)">Tous</button>
                    <button class="filter-btn" onclick="setFilter('5', this)">⭐ 5</button>
                    <button class="filter-btn" onclick="setFilter('4', this)">⭐ 4</button>
                    <button class="filter-btn" onclick="setFilter('3', this)">⭐ ≤3</button>
                </div>
            </div>

            <!-- SKELETON -->
            <div id="skeleton">
                <div class="skeleton" style="height:120px;margin-bottom:1rem;"></div>
                <div class="skeleton" style="height:120px;margin-bottom:1rem;"></div>
                <div class="skeleton" style="height:120px;"></div>
            </div>

            <!-- LISTE -->
            <div class="avis-list" id="avisList" style="display:none;"></div>

            <!-- EMPTY -->
            <div class="empty-state" id="emptyState" style="display:none;">
                <div class="empty-icon">💬</div>
                <div class="empty-title">Aucun avis pour le moment</div>
                <div class="empty-sub">Partagez votre expérience après vos séjours.</div>
                <button class="btn btn-gold" onclick="openAddModal()"><i data-lucide="plus"></i> Ajouter un avis</button>
            </div>

        </main>
    </div>

    <!-- ═══════════════════════════════════
         MODAL AJOUTER / MODIFIER
    ════════════════════════════════════ -->
    <div class="modal-overlay" id="modalAvis">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="modalTitle">Ajouter un avis</div>
                <button class="modal-close" onclick="closeModal('modalAvis')"><i data-lucide="x"></i></button>
            </div>

            <!-- ÉTAPE 1 : choisir hôtel (seulement en mode ajout) -->
            <div id="stepHotel">
                <div class="form-label" style="margin-bottom:0.6rem;">Choisissez un hôtel</div>
                <div class="hotel-select-grid" id="hotelGrid">
                    <div class="skeleton" style="height:60px;border-radius:13px;"></div>
                    <div class="skeleton" style="height:60px;border-radius:13px;"></div>
                    <div class="skeleton" style="height:60px;border-radius:13px;"></div>
                    <div class="skeleton" style="height:60px;border-radius:13px;"></div>
                </div>
                <span class="form-error show" id="errHotel" style="display:none;"></span>
            </div>

            <!-- NOTE -->
            <div class="form-group">
                <label class="form-label">Note</label>
                <div class="star-picker" id="starPicker">
                    <span class="star-pick" data-val="1" onclick="setNote(1)">★</span>
                    <span class="star-pick" data-val="2" onclick="setNote(2)">★</span>
                    <span class="star-pick" data-val="3" onclick="setNote(3)">★</span>
                    <span class="star-pick" data-val="4" onclick="setNote(4)">★</span>
                    <span class="star-pick" data-val="5" onclick="setNote(5)">★</span>
                </div>
                <span class="form-error" id="errNote"></span>
            </div>

            <!-- COMMENTAIRE -->
            <div class="form-group">
                <label class="form-label">Commentaire <span style="color:var(--ink-30);font-weight:400;">(10–500 caractères)</span></label>
                <textarea class="form-input" id="inputCommentaire" rows="4" placeholder="Décrivez votre expérience..." oninput="updateCharCount()"></textarea>
                <span style="font-size:0.7rem;color:var(--ink-60);" id="charCount">0 / 500</span>
                <span class="form-error" id="errCommentaire"></span>
            </div>

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:0.5rem;">
                <button class="btn btn-outline" onclick="closeModal('modalAvis')">Annuler</button>
                <button class="btn btn-gold" id="submitAvisBtn" onclick="submitAvis()">
                    <i data-lucide="send"></i> <span id="submitAvisText">Publier</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════
         MODAL CONFIRMER SUPPRESSION
    ════════════════════════════════════ -->
    <div class="modal-overlay" id="modalDelete">
        <div class="modal confirm-modal">
            <div class="confirm-icon"><i data-lucide="trash-2"></i></div>
            <div class="confirm-title">Supprimer cet avis ?</div>
            <div class="confirm-sub">Cette action est irréversible.</div>
            <div class="confirm-btns">
                <button class="btn btn-outline" onclick="closeModal('modalDelete')">Annuler</button>
                <button class="btn btn-gold" style="background:var(--rose);color:white;" onclick="confirmDelete()">
                    <i data-lucide="trash-2"></i> Supprimer
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast"><i data-lucide="check-circle" id="toastIcon"></i><span id="toastMsg"></span></div>

    <script>
        /* ══════════════════════════════════════
           SESSION
        ══════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role'
            },
            getToken()  { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            parseJwt(t) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); } catch { return null; } },
            clearSession() { localStorage.removeItem(this.TOKEN_KEY); document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`; },
            redirectLogin(r) { this.clearSession(); window.location.href = this.LOGIN_URL + '?reason=' + r; },
            _readCookie(n) { const m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)')); return m ? decodeURIComponent(m[2]) : null; }
        };

        /* ══════════════════════════════════════
           ÉTAT
        ══════════════════════════════════════ */
        let allAvis    = [];
        let hotels     = [];
        let editingId  = null;
        let deleteId   = null;
        let selectedNote  = 0;
        let selectedHotel = null;
        let currentFilter = 'all';

        const fmt = d => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

        /* DATE LABEL */
        (function () {
            const now = new Date();
            const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const mois  = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent = jours[now.getDay()] + ' ' + now.getDate() + ' ' + mois[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ══════════════════════════════════════
           INIT
        ══════════════════════════════════════ */
        async function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();

            const token = SESSION.getToken();
            if (!token) { SESSION.redirectLogin('no_token'); return; }
            const p = SESSION.parseJwt(token);
            if (!p)   { SESSION.redirectLogin('invalid'); return; }

            const fn = (p[SESSION.CLAIMS.name] || '').split(' ')[0] || 'Client';
            document.getElementById('userName').textContent      = p[SESSION.CLAIMS.name] || p[SESSION.CLAIMS.email] || '';
            document.getElementById('userRole').textContent      = p[SESSION.CLAIMS.role] || 'Client';
            document.getElementById('avatarInitial').textContent = fn.charAt(0).toUpperCase();

            await Promise.all([loadAvis(token), loadHotels(token)]);
        }

        /* ══════════════════════════════════════
           CHARGER LES AVIS
        ══════════════════════════════════════ */
        async function loadAvis(token) {
            try {
                const res = await fetch('/api/avis/mes-avis', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (res.status === 401) { SESSION.redirectLogin('unauthorized'); return; }
                allAvis = await res.json();
                renderStats();
                renderAvis();
            } catch {
                showToast('Impossible de charger les avis.', 'error');
            } finally {
                document.getElementById('skeleton').style.display = 'none';
            }
        }

        /* ══════════════════════════════════════
           CHARGER LES HÔTELS (pour le select)
        ══════════════════════════════════════ */
        async function loadHotels(token) {
            try {
                const res = await fetch('/api/hotels', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) return;
                hotels = await res.json();
            } catch {}
        }

        /* ══════════════════════════════════════
           STATS
        ══════════════════════════════════════ */
        function renderStats() {
            const total   = allAvis.length;
            const moyenne = total ? (allAvis.reduce((s, a) => s + a.note, 0) / total).toFixed(1) : '—';
            const hotels  = new Set(allAvis.map(a => a.hotelId)).size;
            document.getElementById('statTotal').textContent   = total;
            document.getElementById('statMoyenne').textContent = moyenne;
            document.getElementById('statHotels').textContent  = hotels;
        }

        /* ══════════════════════════════════════
           RENDER LISTE
        ══════════════════════════════════════ */
        function renderAvis() {
            const list = document.getElementById('avisList');
            const empty = document.getElementById('emptyState');

            let filtered = allAvis;
            if (currentFilter === '5') filtered = allAvis.filter(a => a.note === 5);
            else if (currentFilter === '4') filtered = allAvis.filter(a => a.note === 4);
            else if (currentFilter === '3') filtered = allAvis.filter(a => a.note <= 3);

            list.innerHTML = '';

            if (filtered.length === 0) {
                list.style.display = 'none';
                empty.style.display = 'block';
                lucide.createIcons();
                return;
            }

            empty.style.display = 'none';
            list.style.display  = 'flex';

            filtered.forEach((a, i) => {
                const stars = [1,2,3,4,5].map(s =>
                    `<span class="star ${s <= a.note ? 'filled' : 'empty'}">★</span>`
                ).join('');

                const thumb = a.hotelImageUrl
                    ? `<img src="${a.hotelImageUrl}" alt="">`
                    : '🏨';

                const card = document.createElement('div');
                card.className = 'avis-card';
                card.style.animationDelay = (i * 0.05) + 's';
                card.innerHTML = `
                    <div class="avis-card-top">
                        <div class="avis-hotel-info">
                            <div class="avis-hotel-thumb">${thumb}</div>
                            <div>
                                <div class="avis-hotel-name">${a.hotelName || '—'}</div>
                                <div class="avis-date">${fmt(a.dateAvis)}</div>
                            </div>
                        </div>
                        <div class="avis-actions">
                            <button class="btn-edit-sm" onclick="openEditModal(${a.id})">
                                <i data-lucide="pencil"></i> Modifier
                            </button>
                            <button class="btn-danger-sm" onclick="openDeleteModal(${a.id})">
                                <i data-lucide="trash-2"></i> Supprimer
                            </button>
                        </div>
                    </div>
                    <div class="avis-note-row">
                        <div class="stars">${stars}</div>
                        <span class="note-badge">${a.note}/5</span>
                    </div>
                    <div class="avis-commentaire">${a.commentaire}</div>
                `;
                list.appendChild(card);
            });

            lucide.createIcons();
        }

        /* ══════════════════════════════════════
           FILTRE
        ══════════════════════════════════════ */
        function setFilter(val, btn) {
            currentFilter = val;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderAvis();
        }

        /* ══════════════════════════════════════
           MODAL AJOUTER
        ══════════════════════════════════════ */
        function openAddModal() {
            editingId     = null;
            selectedHotel = null;
            selectedNote  = 0;

            document.getElementById('modalTitle').textContent      = 'Ajouter un avis';
            document.getElementById('submitAvisText').textContent  = 'Publier';
            document.getElementById('inputCommentaire').value      = '';
            document.getElementById('stepHotel').style.display     = 'block';
            document.getElementById('charCount').textContent       = '0 / 500';
            document.getElementById('errHotel').style.display      = 'none';
            document.getElementById('errNote').classList.remove('show');
            document.getElementById('errCommentaire').classList.remove('show');
            renderStarPicker(0);
            renderHotelGrid();
            openModal('modalAvis');
        }

        /* ══════════════════════════════════════
           MODAL MODIFIER
        ══════════════════════════════════════ */
        function openEditModal(id) {
            const avis = allAvis.find(a => a.id === id);
            if (!avis) return;

            editingId     = id;
            selectedNote  = avis.note;
            selectedHotel = avis.hotelId;

            document.getElementById('modalTitle').textContent     = 'Modifier l\'avis';
            document.getElementById('submitAvisText').textContent = 'Enregistrer';
            document.getElementById('inputCommentaire').value     = avis.commentaire;
            document.getElementById('stepHotel').style.display    = 'none'; // pas de changement d'hôtel
            document.getElementById('charCount').textContent      = avis.commentaire.length + ' / 500';
            document.getElementById('errNote').classList.remove('show');
            document.getElementById('errCommentaire').classList.remove('show');
            renderStarPicker(avis.note);
            openModal('modalAvis');
        }

        /* ══════════════════════════════════════
           GRILLE HÔTELS
        ══════════════════════════════════════ */
        function renderHotelGrid() {
            const grid = document.getElementById('hotelGrid');

            // Filtrer les hôtels déjà évalués
            const dejaEvalues = new Set(allAvis.map(a => a.hotelId));
            const disponibles = hotels.filter(h => !dejaEvalues.has(h.id));

            if (disponibles.length === 0) {
                grid.innerHTML = '<p style="font-size:0.82rem;color:var(--ink-60);grid-column:1/-1;">Vous avez déjà évalué tous vos hôtels.</p>';
                return;
            }

            grid.innerHTML = disponibles.map(h => {
                const thumb = h.imageUrl
                    ? `<div class="hotel-option-thumb"><img src="${h.imageUrl}" alt=""></div>`
                    : `<div class="hotel-option-thumb">🏨</div>`;
                return `
                    <div class="hotel-option" id="hotel-opt-${h.id}" onclick="selectHotel(${h.id})">
                        ${thumb}
                        <div>
                            <div class="hotel-option-name">${h.name}</div>
                            <div class="hotel-option-city">${h.city || ''}</div>
                        </div>
                    </div>`;
            }).join('');
        }

        function selectHotel(id) {
            selectedHotel = id;
            document.querySelectorAll('.hotel-option').forEach(el => el.classList.remove('selected'));
            const opt = document.getElementById('hotel-opt-' + id);
            if (opt) opt.classList.add('selected');
            document.getElementById('errHotel').style.display = 'none';
        }

        /* ══════════════════════════════════════
           STAR PICKER
        ══════════════════════════════════════ */
        function setNote(val) {
            selectedNote = val;
            renderStarPicker(val);
            document.getElementById('errNote').classList.remove('show');
        }

        function renderStarPicker(val) {
            document.querySelectorAll('.star-pick').forEach(s => {
                s.classList.toggle('on', parseInt(s.dataset.val) <= val);
            });
        }

        function updateCharCount() {
            const len = document.getElementById('inputCommentaire').value.length;
            document.getElementById('charCount').textContent = len + ' / 500';
        }

        /* ══════════════════════════════════════
           SOUMETTRE AVIS
        ══════════════════════════════════════ */
        async function submitAvis() {
            const commentaire = document.getElementById('inputCommentaire').value.trim();
            let ok = true;

            if (!editingId && !selectedHotel) {
                document.getElementById('errHotel').textContent    = 'Veuillez choisir un hôtel.';
                document.getElementById('errHotel').style.display  = 'block';
                ok = false;
            }
            if (!selectedNote) {
                document.getElementById('errNote').textContent = 'Veuillez attribuer une note.';
                document.getElementById('errNote').classList.add('show');
                ok = false;
            }
            if (commentaire.length < 10) {
                document.getElementById('errCommentaire').textContent = 'Minimum 10 caractères.';
                document.getElementById('errCommentaire').classList.add('show');
                ok = false;
            }
            if (!ok) return;

            const btn = document.getElementById('submitAvisBtn');
            btn.disabled = true;
            document.getElementById('submitAvisText').textContent = 'En cours…';

            try {
                const token = SESSION.getToken();

                if (editingId) {
                    // MODIFIER
                    const res = await fetch(`/api/avis/${editingId}`, {
                        method: 'PUT',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ note: selectedNote, commentaire }),
                        credentials: 'include'
                    });
                    if (!res.ok) {
                        const err = await res.json().catch(() => ({}));
                        throw new Error(err.message || 'Erreur.');
                    }
                    const updated = await res.json();
                    const idx = allAvis.findIndex(a => a.id === editingId);
                    if (idx !== -1) allAvis[idx] = updated;
                    showToast('Avis modifié avec succès !', 'success');
                } else {
                    // AJOUTER
                    const res = await fetch('/api/avis', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ note: selectedNote, commentaire, hotelId: selectedHotel }),
                        credentials: 'include'
                    });
                    if (!res.ok) {
                        const err = await res.json().catch(() => ({}));
                        throw new Error(err.message || 'Erreur.');
                    }
                    const created = await res.json();
                    allAvis.unshift(created);
                    showToast('Avis publié avec succès !', 'success');
                }

                closeModal('modalAvis');
                renderStats();
                renderAvis();

            } catch (err) {
                showToast(err.message || 'Erreur.', 'error');
            } finally {
                btn.disabled = false;
                document.getElementById('submitAvisText').textContent = editingId ? 'Enregistrer' : 'Publier';
            }
        }

        /* ══════════════════════════════════════
           SUPPRIMER
        ══════════════════════════════════════ */
        function openDeleteModal(id) {
            deleteId = id;
            openModal('modalDelete');
        }

        async function confirmDelete() {
            if (!deleteId) return;
            try {
                const token = SESSION.getToken();
                const res   = await fetch(`/api/avis/${deleteId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) throw new Error();
                allAvis = allAvis.filter(a => a.id !== deleteId);
                closeModal('modalDelete');
                renderStats();
                renderAvis();
                showToast('Avis supprimé.', 'success');
            } catch {
                showToast('Impossible de supprimer l\'avis.', 'error');
            }
        }

        /* ══════════════════════════════════════
           HELPERS
        ══════════════════════════════════════ */
        function openModal(id)  { document.getElementById(id).classList.add('show'); lucide.createIcons(); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); }

        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            document.getElementById('toastIcon').setAttribute('data-lucide', type === 'success' ? 'check-circle' : 'alert-circle');
            t.className = 'toast ' + type;
            lucide.createIcons();
            requestAnimationFrame(() => t.classList.add('show'));
            setTimeout(() => t.classList.remove('show'), 4000);
        }

        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' }).catch(() => {});
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    </script>
</body>
</html>