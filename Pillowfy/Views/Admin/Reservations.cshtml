@model List<Pillowfy.Models.Reservation>
@{
    ViewData["Title"] = "Gestion Réservations";
    Layout = null;
    var statusFilter = ViewBag.StatusFilter as string;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Pillowfy Admin — Réservations</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --cream: #FAF7F2;
            --cream-dk: #F0EBE1;
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --sidebar-w: 260px;
        }

        body {
            font-family: 'DM Sans',sans-serif;
            background: var(--cream);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: var(--sidebar-w);
            min-height: 100vh;
            background: var(--ink);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            padding: 2rem 1.5rem;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 3rem;
        }

            .sidebar-brand img {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display',serif;
            font-size: 1.3rem;
            color: white;
        }

        .sidebar-label {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.25);
            margin-bottom: 0.6rem;
            margin-top: 1.5rem;
            padding: 0 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.7rem 0.8rem;
            border-radius: 10px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            color: rgba(255,255,255,0.5);
            transition: all .2s;
            margin-bottom: 2px;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: white;
            }

            .nav-item.active {
                background: rgba(201,169,110,0.15);
                color: var(--gold);
            }

            .nav-item .icon {
                font-size: 1.1rem;
                width: 20px;
                text-align: center;
            }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .admin-info {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1rem;
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(201,169,110,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            color: var(--gold);
            font-weight: 600;
        }

        .admin-name {
            font-size: 0.88rem;
            font-weight: 500;
            color: white;
        }

        .admin-role {
            font-size: 0.72rem;
            color: var(--gold);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 0.65rem 0.8rem;
            background: rgba(192,57,43,0.1);
            border: 1px solid rgba(192,57,43,0.2);
            border-radius: 10px;
            color: #e74c3c;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            transition: all .2s;
        }

            .logout-btn:hover {
                background: rgba(192,57,43,0.18);
            }

        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            padding: 2.5rem;
        }

        .page-header {
            margin-bottom: 2.5rem;
        }

        .page-eyebrow {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--teal);
            margin-bottom: 0.4rem;
        }

        .page-title {
            font-family: 'DM Serif Display',serif;
            font-size: 2rem;
            color: var(--ink);
        }

            .page-title em {
                font-style: italic;
                color: var(--gold);
            }

        .filter-bar {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .filter-btn {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            border: 1.5px solid var(--cream-dk);
            background: var(--white);
            font-family: 'DM Sans',sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            color: var(--ink);
        }

            .filter-btn:hover, .filter-btn.active {
                background: var(--gold);
                color: white;
                border-color: var(--gold);
            }

        .table-card {
            background: var(--white);
            border: 1px solid rgba(201,169,110,0.12);
            border-radius: 16px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: var(--cream);
        }

        th {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--ink-60);
            text-align: left;
            padding: 0.8rem 1rem;
            border-bottom: 1px solid var(--cream-dk);
        }

        td {
            padding: 0.9rem 1rem;
            font-size: 0.88rem;
            color: var(--ink);
            border-bottom: 1px solid rgba(240,235,225,0.6);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(201,169,110,0.03);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 100px;
        }

        .pill-pending {
            background: rgba(201,169,110,0.15);
            color: #9A722E;
        }

        .pill-confirmed {
            background: rgba(26,107,107,0.1);
            color: var(--teal);
        }

        .pill-rejected {
            background: rgba(192,57,43,0.1);
            color: #c0392b;
        }

        .pill-cancelled {
            background: rgba(15,22,33,0.06);
            color: var(--ink-60);
        }

        .price-tag {
            font-weight: 600;
            color: var(--teal);
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <a href="/Admin/Dashboard" class="sidebar-brand">
            <img src="/Images/logo.png" alt="Pillowfy">
            <span class="sidebar-brand-name">Pillowfy</span>
        </a>
        <div class="sidebar-label">Principal</div>
        <a href="/Admin/Dashboard" class="nav-item @(ViewData["Title"]?.ToString() == "Dashboard Admin" ? "active" : "")">
            <span class="icon">📊</span> Dashboard
        </a>

        <div class="sidebar-label">Gestion</div>
        <a href="/Admin/Users" class="nav-item @(ViewData["Title"]?.ToString() == "Gestion Utilisateurs" ? "active" : "")">
            <span class="icon">👥</span> Utilisateurs
        </a>
        <a href="/Admin/Hotels" class="nav-item @(ViewData["Title"]?.ToString() == "Gestion Hôtels" ? "active" : "")">
            <span class="icon">🏨</span> Hôtels
        </a>
        <a href="/Admin/Reservations" class="nav-item @(ViewData["Title"]?.ToString() == "Gestion Réservations" ? "active" : "")">
            <span class="icon">📅</span> Réservations
        </a>
        <a href="/Admin/Avis" class="nav-item @(ViewData["Title"]?.ToString() == "Modération Avis" ? "active" : "")">
            <span class="icon">⭐</span> Avis
        </a>
        <a href="/Admin/Statistiques" class="nav-item @(ViewData["Title"]?.ToString() == "Statistiques" ? "active" : "")">
            <span class="icon">📈</span> Statistiques
        </a>
        <div class="sidebar-footer">
            <div class="admin-info">
                <div class="admin-avatar">A</div>
                <div><div class="admin-name">Administrateur</div><div class="admin-role">Super Admin</div></div>
            </div>
            <a href="/Admin/Logout" class="logout-btn">🚪 Se déconnecter</a>
        </div>
    </aside>

    <main class="main">
        <div class="page-header">
            <div class="page-eyebrow">Supervision</div>
            <h1 class="page-title">Gestion des <em>réservations</em></h1>
        </div>

        <div class="filter-bar">
            <a href="/Admin/Reservations" class="filter-btn @(string.IsNullOrEmpty(statusFilter) ? "active" : "")">Tous</a>
            <a href="/Admin/Reservations?status=Pending" class="filter-btn @(statusFilter == "Pending" ? "active" : "")">⏳ En attente</a>
            <a href="/Admin/Reservations?status=Confirmed" class="filter-btn @(statusFilter == "Confirmed" ? "active" : "")">✅ Confirmées</a>
            <a href="/Admin/Reservations?status=Rejected" class="filter-btn @(statusFilter == "Rejected" ? "active" : "")">❌ Rejetées</a>
            <a href="/Admin/Reservations?status=Cancelled" class="filter-btn @(statusFilter == "Cancelled" ? "active" : "")">🚫 Annulées</a>
        </div>

        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Hôtel / Chambre</th>
                        <th>Dates</th>
                        <th>Voyageurs</th>
                        <th>Prix total</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>#@r.Id</td>
                            <td>
                                <div style="font-weight:500">@r.User?.FirstName @r.User?.LastName</div>
                                <div style="font-size:0.75rem;color:var(--ink-60)">@r.User?.Email</div>
                            </td>
                            <td>
                                <div style="font-weight:500">@r.Chambre?.Hotel?.Name</div>
                                <div style="font-size:0.75rem;color:var(--ink-60)">@r.Chambre?.Name</div>
                            </td>
                            <td>
                                <div>@r.CheckIn.ToString("dd/MM/yyyy")</div>
                                <div style="font-size:0.75rem;color:var(--ink-60)">→ @r.CheckOut.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>@r.NumberOfGuests pers.</td>
                            <td class="price-tag">@r.TotalPrice.ToString("N2") TND</td>
                            <td>
                                @{
                                    var statusClass = r.Status.ToString() switch
                                    {
                                        "Pending" => "pill-pending",
                                        "Confirmed" => "pill-confirmed",
                                        "Rejected" => "pill-rejected",
                                        "Cancelled" => "pill-cancelled",
                                        _ => "pill-pending"
                                    };
                                    var statusLabel = r.Status.ToString() switch
                                    {
                                        "Pending" => "⏳ En attente",
                                        "Confirmed" => "✅ Confirmée",
                                        "Rejected" => "❌ Rejetée",
                                        "Cancelled" => "🚫 Annulée",
                                        _ => r.Status.ToString()
                                    };
                                }
                                <span class="status-pill @statusClass">@statusLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>