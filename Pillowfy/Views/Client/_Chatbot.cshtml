@* Pillowfy — Assistant Chatbot Multi-thématique
   Intégration : ajouter @await Html.PartialAsync("_Chatbot") dans le layout de l'espace client *@

<div id="pillowfy-chat-bubble" onclick="toggleChat()" title="Ouvrir l'assistant">
    <i data-lucide="message-circle"></i>
    <span id="chat-notif-dot"></span>
</div>

<div id="pillowfy-chat-panel" class="chat-panel">

    <!-- Header -->
    <div class="cp-header">
        <div class="cp-avatar">P</div>
        <div class="cp-header-info">
            <strong>Assistant Pillowfy</strong>
            <span id="cp-status">En ligne</span>
        </div>
        <div class="cp-header-actions">
            <button onclick="clearHistory()" title="Nouvelle conversation"><i data-lucide="rotate-ccw"></i></button>
            <button onclick="toggleChat()" title="Fermer"><i data-lucide="x"></i></button>
        </div>
    </div>

    <!-- Theme selector -->
    <div class="cp-themes" id="cp-themes">
        <button class="cp-theme active" data-theme="general">
            <i data-lucide="home"></i> Général
        </button>
        <button class="cp-theme" data-theme="reservations">
            <i data-lucide="calendar"></i> Réservations
        </button>
        <button class="cp-theme" data-theme="paiements">
            <i data-lucide="credit-card"></i> Paiements
        </button>
        <button class="cp-theme" data-theme="chambres">
            <i data-lucide="bed-double"></i> Chambres
        </button>
        <button class="cp-theme" data-theme="support">
            <i data-lucide="life-buoy"></i> Support
        </button>
    </div>

    <!-- Messages -->
    <div class="cp-messages" id="cp-messages">
        <div class="cp-msg bot">
            <div class="cp-bubble">
                Bonjour ! Je suis votre assistant Pillowfy. Comment puis-je vous aider aujourd'hui ?
            </div>
        </div>
        <div class="cp-suggestions" id="cp-suggestions"></div>
    </div>

    <!-- Input -->
    <div class="cp-input-area">
        <input type="text"
               id="cp-input"
               placeholder="Posez votre question..."
               autocomplete="off"
               onkeydown="if(event.key==='Enter') chatSend()" />
        <button class="cp-send-btn" onclick="chatSend()" aria-label="Envoyer">
            <i data-lucide="send"></i>
        </button>
    </div>

    <div class="cp-footer">Propulsé par <strong>Pillowfy AI</strong></div>
</div>

<style>
    /* ── BUBBLE ── */
    #pillowfy-chat-bubble {
        position: fixed;
        bottom: 28px;
        right: 28px;
        width: 56px;
        height: 56px;
        background: var(--ink, #0F1621);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 9998;
        box-shadow: 0 4px 20px rgba(15,22,33,0.28);
        transition: transform .22s cubic-bezier(.4,0,.2,1), background .2s;
    }

        #pillowfy-chat-bubble:hover {
            background: #1d2a3a;
            transform: scale(1.08);
        }

        #pillowfy-chat-bubble svg {
            width: 24px;
            height: 24px;
            color: #FAF7F2;
        }

    #chat-notif-dot {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 10px;
        height: 10px;
        background: #C9A96E;
        border-radius: 50%;
        border: 2px solid #FAF7F2;
        display: none;
    }

        #chat-notif-dot.show {
            display: block;
        }

    /* ── PANEL ── */
    .chat-panel {
        position: fixed;
        bottom: 96px;
        right: 28px;
        width: 380px;
        max-height: 600px;
        background: #FAF7F2;
        border-radius: 20px;
        border: 1px solid rgba(201,169,110,0.2);
        box-shadow: 0 20px 60px rgba(15,22,33,0.18);
        display: flex;
        flex-direction: column;
        z-index: 9999;
        overflow: hidden;
        transform: scale(0.92) translateY(16px);
        opacity: 0;
        pointer-events: none;
        transition: transform .28s cubic-bezier(.4,0,.2,1), opacity .22s ease;
        font-family: 'DM Sans', sans-serif;
    }

        .chat-panel.open {
            transform: scale(1) translateY(0);
            opacity: 1;
            pointer-events: all;
        }

    /* Header */
    .cp-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        background: #0F1621;
        color: #FAF7F2;
    }

    .cp-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #C9A96E;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'DM Serif Display', serif;
        font-size: 1rem;
        color: #0F1621;
        flex-shrink: 0;
    }

    .cp-header-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .cp-header-info strong {
            font-size: 0.88rem;
            font-weight: 600;
        }

        .cp-header-info span {
            font-size: 0.72rem;
            color: rgba(201,169,110,0.75);
        }

    .cp-header-actions {
        display: flex;
        gap: 4px;
    }

        .cp-header-actions button {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: transparent;
            border: none;
            color: rgba(250,247,242,0.55);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .15s, color .15s;
        }

            .cp-header-actions button:hover {
                background: rgba(255,255,255,0.1);
                color: #FAF7F2;
            }

        .cp-header-actions svg {
            width: 16px;
            height: 16px;
        }

    /* Themes */
    .cp-themes {
        display: flex;
        gap: 6px;
        padding: 10px 14px;
        border-bottom: 1px solid rgba(201,169,110,0.14);
        overflow-x: auto;
        scrollbar-width: none;
        background: #FAF7F2;
        flex-shrink: 0;
    }

        .cp-themes::-webkit-scrollbar {
            display: none;
        }

    .cp-theme {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 500;
        font-family: 'DM Sans', sans-serif;
        border: 1px solid rgba(15,22,33,0.15);
        background: transparent;
        color: rgba(15,22,33,0.55);
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
    }

        .cp-theme svg {
            width: 13px;
            height: 13px;
        }

        .cp-theme:hover {
            border-color: #C9A96E;
            color: #9A722E;
            background: rgba(201,169,110,0.06);
        }

        .cp-theme.active {
            background: #0F1621;
            color: #FAF7F2;
            border-color: #0F1621;
        }

    /* Messages */
    .cp-messages {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        scroll-behavior: smooth;
    }

    .cp-msg {
        display: flex;
        gap: 8px;
        align-items: flex-end;
    }

        .cp-msg.user {
            flex-direction: row-reverse;
        }

    .cp-bubble {
        max-width: 78%;
        padding: 10px 14px;
        font-size: 0.86rem;
        line-height: 1.55;
        color: #0F1621;
    }

    .cp-msg.bot .cp-bubble {
        background: #FFFFFF;
        border: 1px solid rgba(201,169,110,0.14);
        border-radius: 4px 16px 16px 16px;
    }

    .cp-msg.user .cp-bubble {
        background: #0F1621;
        color: #FAF7F2;
        border-radius: 16px 4px 16px 16px;
    }

    /* Suggestions */
    .cp-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 4px 0 8px 0;
    }

    .cp-sug {
        padding: 5px 11px;
        border-radius: 100px;
        font-size: 0.75rem;
        font-family: 'DM Sans', sans-serif;
        border: 1px solid #C9A96E;
        color: #9A722E;
        background: rgba(201,169,110,0.08);
        cursor: pointer;
        transition: background .15s;
    }

        .cp-sug:hover {
            background: rgba(201,169,110,0.18);
        }

    /* Typing animation */
    .cp-typing {
        display: flex;
        gap: 4px;
        align-items: center;
        padding: 10px 14px;
        background: #FFFFFF;
        border: 1px solid rgba(201,169,110,0.14);
        border-radius: 4px 16px 16px 16px;
        width: fit-content;
    }

        .cp-typing span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(15,22,33,0.3);
            animation: cpBlink 1.2s infinite;
        }

            .cp-typing span:nth-child(2) {
                animation-delay: .2s;
            }

            .cp-typing span:nth-child(3) {
                animation-delay: .4s;
            }

    @@keyframes cpBlink {
        0%, 80%, 100%

    {
        opacity: 0.2;
    }

    40% {
        opacity: 1;
    }

    }

    /* Input */
    .cp-input-area {
        display: flex;
        gap: 8px;
        padding: 10px 14px;
        border-top: 1px solid rgba(201,169,110,0.14);
        background: #FAF7F2;
        flex-shrink: 0;
    }

        .cp-input-area input {
            flex: 1;
            padding: 9px 14px;
            border-radius: 100px;
            border: 1px solid rgba(201,169,110,0.3);
            background: #FFFFFF;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            color: #0F1621;
            outline: none;
            transition: border-color .15s;
        }

            .cp-input-area input:focus {
                border-color: #C9A96E;
            }

    .cp-send-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #0F1621;
        border: none;
        color: #FAF7F2;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: opacity .15s;
    }

        .cp-send-btn:hover {
            opacity: 0.8;
        }

        .cp-send-btn svg {
            width: 16px;
            height: 16px;
        }

    .cp-footer {
        text-align: center;
        font-size: 0.7rem;
        color: rgba(15,22,33,0.3);
        padding: 6px;
        background: #FAF7F2;
        flex-shrink: 0;
    }

    /* Mobile */
    @@media (max-width: 500px) {
        .chat-panel {
            width: calc(100vw - 24px);
            right: 12px;
            bottom: 88px;
        }
    }
</style>

<script>
    (function () {

        // ── Configuration thèmes ──
        const THEMES = {
            general: {
                label: 'Général',
                icon: 'home',
                system: `Tu es un assistant hôtelier expert pour Pillowfy, une plateforme de gestion hôtelière SaaS.
    Réponds en français de façon concise, professionnelle et bienveillante.
    Tu peux répondre à toute question générale sur la plateforme : fonctionnalités, démarrage, compte, paramètres.
    Ne divulgue jamais de données sensibles d'autres clients.`,
                suggestions: ['Comment démarrer ?', "Modifier mon profil", "Contacter le support"]
            },
            reservations: {
                label: 'Réservations',
                icon: 'calendar',
                system: `Tu es un expert en gestion de réservations pour Pillowfy.
    Aide les hôteliers à : créer, modifier, annuler et gérer leurs réservations.
    Explique les statuts (confirmée, en attente, annulée, no-show), les processus de check-in/check-out, les politiques d'annulation.
    Réponds en français, de façon claire et structurée.`,
                suggestions: ['Créer une réservation', 'Gérer un no-show', 'Politique d\'annulation']
            },
            paiements: {
                label: 'Paiements',
                icon: 'credit-card',
                system: `Tu es un expert en gestion financière pour Pillowfy.
    Aide les hôteliers avec : les paiements, factures, acomptes, remboursements, rapports de revenus.
    Explique les flux financiers, les méthodes de paiement acceptées, la comptabilité simplifiée.
    Réponds en français, de façon précise.`,
                suggestions: ['Mes revenus du mois', 'Émettre une facture', 'Rembourser un client']
            },
            chambres: {
                label: 'Chambres',
                icon: 'bed-double',
                system: `Tu es un expert en gestion des chambres et tarification pour Pillowfy.
    Aide à : configurer les types de chambres, définir les tarifs, gérer les équipements, changer les statuts (libre, occupée, maintenance, nettoyage).
    Parle aussi du yield management et de l'optimisation tarifaire.
    Réponds en français.`,
                suggestions: ['Ajouter une chambre', 'Mettre en maintenance', 'Optimiser mes tarifs']
            },
            support: {
                label: 'Support',
                icon: 'life-buoy',
                system: `Tu es un agent de support technique Pillowfy de niveau 1.
    Aide à résoudre : problèmes de connexion, erreurs API, intégrations tierces, bugs d'interface.
    Sois méthodique : identifie le problème, propose des étapes de résolution, escalade si nécessaire.
    Si le problème est complexe, suggère d'ouvrir un ticket support.
    Réponds en français.`,
                suggestions: ['Problème de connexion', 'Erreur API', 'Réinitialiser mon mot de passe']
            }
        };

        let currentTheme = 'general';
        let history = [];
        let isTyping = false;
        let isOpen = false;

        // ── Helpers DOM ──
        const $ = id => document.getElementById(id);

        function scrollToBottom() {
            const msgs = $('cp-messages');
            msgs.scrollTop = msgs.scrollHeight;
        }

        function appendMsg(role, html) {
            const msgs = $('cp-messages');
            const div = document.createElement('div');
            div.className = 'cp-msg ' + role;
            div.innerHTML = `<div class="cp-bubble">${html}</div>`;
            msgs.appendChild(div);
            scrollToBottom();
        }

        function showTypingIndicator() {
            const msgs = $('cp-messages');
            const div = document.createElement('div');
            div.className = 'cp-msg bot';
            div.id = 'cp-typing';
            div.innerHTML = `<div class="cp-typing"><span></span><span></span><span></span></div>`;
            msgs.appendChild(div);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const t = $('cp-typing');
            if (t) t.remove();
        }

        function updateSuggestions() {
            const sugs = THEMES[currentTheme].suggestions;
            const container = $('cp-suggestions');
            if (!container) return;
            container.innerHTML = sugs.map(s =>
                `<button class="cp-sug" onclick="window.chatSendSuggestion('${s.replace(/'/g, "\\'")}')">${s}</button>`
            ).join('');
        }

        // ── Toggle panel ──
        window.toggleChat = function () {
            isOpen = !isOpen;
            const panel = document.querySelector('.chat-panel');
            panel.classList.toggle('open', isOpen);
            if (isOpen) {
                $('chat-notif-dot').classList.remove('show');
                $('cp-input').focus();
                updateSuggestions();
            }
        };

        // ── Clear history ──
        window.clearHistory = function () {
            history = [];
            const msgs = $('cp-messages');
            msgs.innerHTML = `
                <div class="cp-msg bot">
                    <div class="cp-bubble">Conversation réinitialisée. Comment puis-je vous aider ?</div>
                </div>
                <div class="cp-suggestions" id="cp-suggestions"></div>`;
            updateSuggestions();
        };

        // ── Send suggestion ──
        window.chatSendSuggestion = function (text) {
            $('cp-input').value = text;
            chatSend();
        };

        // ── Theme switch ──
        document.querySelectorAll('.cp-theme').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.cp-theme').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentTheme = btn.dataset.theme;
                history = [];
                updateSuggestions();
            });
        });

        // ── Send message ──
        window.chatSend = async function () {
            const input = $('cp-input');
            const text = input.value.trim();
            if (!text || isTyping) return;

            input.value = '';
            const sug = $('cp-suggestions');
            if (sug) sug.remove();

            appendMsg('user', escapeHtml(text));
            history.push({ role: 'user', content: text });
            isTyping = true;
            $('cp-status').textContent = 'En train de répondre...';
            showTypingIndicator();

            try {
                      const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
    Authorization: `Bearer ${token}`        },
        body: JSON.stringify({
            model: 'llama-3.3-70b-versatile',
            max_tokens: 1000,
            messages: [
                { role: 'system', content: THEMES[currentTheme].system },
                ...history
            ]
        })
    });
    const data = await res.json();
    if (!res.ok) {
        throw new Error(data.error?.message || 'Erreur API');
    }
    // ✅ Ligne corrigée (Groq = choices, pas content)
    const reply = data.choices?.[0]?.message?.content || 'Je n\'ai pas pu générer une réponse.';
    history.push({ role: 'assistant', content: reply });
    removeTypingIndicator();
    appendMsg('bot', formatReply(reply));
    } catch (err) {
        removeTypingIndicator();
        appendMsg('bot', `<span style="color:#993C1D">Une erreur est survenue. Veuillez réessayer ou <a href="/Support" style="color:#C9A96E">contacter le support</a>.</span>`);
        console.error('Pillowfy Chat Error:', err);
    }

            isTyping = false;
            $('cp-status').textContent = 'En ligne';
            scrollToBottom();
        };

        // ── Formatage réponse : markdown basique ──
        function formatReply(text) {
            return escapeHtml(text)
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`(.*?)`/g, '<code style="background:rgba(201,169,110,0.12);padding:1px 5px;border-radius:4px;font-size:0.82rem">$1</code>')
                .replace(/\n/g, '<br>');
        }

        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ── Init Lucide icons ──
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // ── Notif dot after 3s (onboarding hint) ──
        setTimeout(() => {
            if (!isOpen) $('chat-notif-dot').classList.add('show');
        }, 3000);

    })();
</script>
