@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mon espace</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.383.0/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            border-right: 1px solid rgba(255,255,255,0.04);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .nav-badge {
            margin-left: auto;
            background: var(--gold);
            color: var(--ink);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 100px;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
            font-weight: 700;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        /* ── MAIN ── */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
            line-height: 1.2;
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-online {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--white);
            border: 1px solid rgba(201,169,110,0.2);
            border-radius: 100px;
            padding: 0.38rem 0.85rem;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--teal);
            box-shadow: var(--shadow-sm);
        }

        .badge-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #22c55e;
        }

        /* ── HERO ── */
        .hero-card {
            background: var(--ink);
            border-radius: var(--radius-xl);
            padding: 1.8rem 2.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
            position: relative;
            overflow: hidden;
        }

            .hero-card::before {
                content: '';
                position: absolute;
                right: -5%;
                top: -55%;
                width: 320px;
                height: 320px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.18) 0%, transparent 65%);
            }

            .hero-card::after {
                content: '';
                position: absolute;
                left: 28%;
                bottom: -45%;
                width: 180px;
                height: 180px;
                border-radius: 50%;
                border: 1px solid rgba(201,169,110,0.07);
            }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(201,169,110,0.14);
            border: 1px solid rgba(201,169,110,0.22);
            border-radius: 100px;
            padding: 3px 11px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--gold);
            margin-bottom: 8px;
        }

        .hero-text {
            position: relative;
            z-index: 1;
        }

            .hero-text h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.45rem;
                color: var(--white);
                margin-bottom: 4px;
            }

                .hero-text h2 em {
                    color: var(--gold);
                    font-style: italic;
                }

            .hero-text p {
                font-size: 0.83rem;
                color: rgba(255,255,255,0.4);
                max-width: 320px;
                line-height: 1.5;
            }

        .hero-actions {
            position: relative;
            z-index: 1;
            display: flex;
            gap: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,169,110,0.3);
            }

        .btn-outline {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.65);
            border: 1px solid rgba(255,255,255,0.12);
        }

            .btn-outline:hover {
                background: rgba(255,255,255,0.12);
                color: var(--white);
            }

        /* ── RÉSERVATION ACTIVE ── */
        .reservation-banner {
            background: linear-gradient(135deg, #0E2D2D 0%, #0B1120 100%);
            border-radius: var(--radius-xl);
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
            border: 1px solid rgba(26,107,107,0.3);
            position: relative;
            overflow: hidden;
        }

            .reservation-banner::before {
                content: '';
                position: absolute;
                right: 10%;
                top: -80%;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(26,107,107,0.25) 0%, transparent 70%);
            }

        .res-left {
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            z-index: 1;
        }

        .res-room-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(26,107,107,0.25);
            border: 1px solid rgba(26,107,107,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .res-room-icon svg {
                width: 22px;
                height: 22px;
                color: #4ECDC4;
            }

        .res-label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 3px;
        }

        .res-room {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

        .res-dates {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.45);
            margin-top: 2px;
        }

        .res-status-group {
            display: flex;
            gap: 16px;
            position: relative;
            z-index: 1;
        }

        .res-stat {
            text-align: center;
        }

        .res-stat-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

        .res-stat-lbl {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .res-divider {
            width: 1px;
            background: rgba(255,255,255,0.08);
        }

        .res-actions {
            display: flex;
            gap: 8px;
            position: relative;
            z-index: 1;
        }

        .btn-teal {
            background: rgba(26,107,107,0.3);
            color: #4ECDC4;
            border: 1px solid rgba(26,107,107,0.45);
            border-radius: 100px;
            padding: 0.5rem 1.1rem;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .16s;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

            .btn-teal:hover {
                background: rgba(26,107,107,0.5);
            }

            .btn-teal svg {
                width: 13px;
                height: 13px;
            }

        /* ── STATS ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.3rem 1.4rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: all .2s;
        }

            .stat-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
                border-color: rgba(201,169,110,0.22);
            }

        .stat-icon-wrap {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .stat-icon-wrap svg {
                width: 18px;
                height: 18px;
            }

            .stat-icon-wrap.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stat-icon-wrap.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .stat-icon-wrap.green {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stat-icon-wrap.rose {
                background: var(--rose-lt);
                color: var(--rose);
            }

        .stat-label {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--ink-30);
            margin-bottom: 3px;
        }

        .stat-value {
            font-family: 'DM Serif Display', serif;
            font-size: 0.95rem;
            color: var(--ink);
        }

        .stat-sub {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* ── GRIDS ── */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .main-grid-wide {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1rem;
        }

        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.5rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.1rem;
        }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 0.98rem;
            color: var(--ink);
        }

        .card-link {
            font-size: 0.76rem;
            color: var(--gold);
            font-weight: 600;
            text-decoration: none;
        }

            .card-link:hover {
                text-decoration: underline;
            }

        /* ── SÉJOURS ── */
        .stay-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.9rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .stay-item:last-child {
                border-bottom: none;
            }

        .stay-thumb {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            background: var(--gold-lt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.2rem;
        }

        .stay-hotel {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--ink);
        }

        .stay-dates {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .stay-meta {
            margin-left: auto;
            text-align: right;
        }

        .stay-price {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--ink);
        }

        .stay-nights {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .stay-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 100px;
            margin-top: 4px;
        }

            .stay-badge.done {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stay-badge.upcoming {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stay-badge.cancelled {
                background: var(--rose-lt);
                color: var(--rose);
            }

        /* ── SERVICES ── */
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .service-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.8rem;
            border-radius: 12px;
            background: var(--bg);
            cursor: pointer;
            transition: all .16s;
            border: 1px solid transparent;
        }

            .service-item:hover {
                background: var(--gold-lt);
                border-color: rgba(201,169,110,0.2);
                transform: translateY(-1px);
            }

        .service-ic {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            font-size: 1rem;
            flex-shrink: 0;
        }

        .service-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .service-status {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-top: 1px;
        }

        /* ── FACTURES ── */
        .invoice-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .invoice-row:last-child {
                border-bottom: none;
            }

        .invoice-num {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--ink);
        }

        .invoice-date {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .invoice-amount {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--ink);
        }

        .invoice-dl {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .15s;
            border: none;
            color: var(--ink-60);
        }

            .invoice-dl:hover {
                background: var(--gold-lt);
                color: var(--gold);
            }

            .invoice-dl svg {
                width: 13px;
                height: 13px;
            }

        /* ── MESSAGERIE ── */
        .msg-item {
            display: flex;
            gap: 10px;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .msg-item:last-child {
                border-bottom: none;
            }

        .msg-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-top: 5px;
            flex-shrink: 0;
        }

            .msg-dot.open {
                background: var(--gold);
            }

            .msg-dot.closed {
                background: #22c55e;
            }

            .msg-dot.pending {
                background: var(--rose);
            }

        .msg-subject {
            font-size: 0.83rem;
            font-weight: 600;
            color: var(--ink);
        }

        .msg-preview {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
            line-height: 1.4;
        }

        .msg-time {
            margin-left: auto;
            font-size: 0.7rem;
            color: var(--ink-30);
            white-space: nowrap;
        }

        /* ── ACTIONS RAPIDES ── */
        .quick-action {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 0.8rem;
            border-radius: 11px;
            background: var(--bg);
            margin-bottom: 7px;
            text-decoration: none;
            transition: all .16s;
            cursor: pointer;
            border: none;
            width: 100%;
            text-align: left;
        }

            .quick-action:hover {
                background: var(--gold-lt);
                transform: translateX(3px);
            }

            .quick-action:last-child {
                margin-bottom: 0;
            }

        .qa-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            flex-shrink: 0;
            color: var(--ink-60);
        }

            .qa-icon svg {
                width: 15px;
                height: 15px;
            }

        .qa-label {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink);
        }

        .qa-sub {
            font-size: 0.72rem;
            color: var(--ink-60);
        }

        .qa-arrow {
            margin-left: auto;
            color: var(--ink-30);
        }

            .qa-arrow svg {
                width: 15px;
                height: 15px;
            }

        /* ── FIDÉLITÉ ── */
        .loyalty-card {
            background: linear-gradient(135deg, #1A3A2A 0%, #0B1120 100%);
            border-radius: var(--radius-xl);
            padding: 1.4rem 1.6rem;
            border: 1px solid rgba(201,169,110,0.15);
            margin-bottom: 1rem;
        }

        .loyalty-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .loyalty-title {
            font-family: 'DM Serif Display', serif;
            font-size: 0.95rem;
            color: var(--white);
        }

        .loyalty-tier {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 100px;
            background: rgba(201,169,110,0.2);
            color: var(--gold);
