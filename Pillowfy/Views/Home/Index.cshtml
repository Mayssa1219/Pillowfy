@{
    ViewData["Title"] = "Accueil";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Gestion hôtelière intelligente</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: #E8D5B0;
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --cream: #FAF7F2;
            --cream-dk: #F0EBE1;
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --radius-lg: 20px;
            --radius-xl: 32px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.08);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.12);
            --shadow-lg: 0 20px 60px rgba(15,22,33,0.16);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--cream);
            color: var(--ink);
            min-height: 100vh;
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
                pointer-events: none;
                z-index: 0;
            }

        /* ── NAVBAR ── */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 3.5rem;
            background: rgba(250,247,242,0.82);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(201,169,110,0.18);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            overflow: hidden;
        }

        .nav-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--ink);
            letter-spacing: 0.5px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .nav-link {
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--ink-60);
            text-decoration: none;
            transition: color .2s;
        }

            .nav-link:hover {
                color: var(--ink);
            }

        .nav-cta {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.6rem 1.4rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .22s cubic-bezier(.4,0,.2,1);
        }

        .btn-ghost {
            background: transparent;
            color: var(--ink);
            border: 1.5px solid var(--ink-30);
        }

            .btn-ghost:hover {
                border-color: var(--ink);
                background: rgba(15,22,33,0.04);
            }

        .btn-primary {
            background: var(--ink);
            color: var(--white);
        }

            .btn-primary:hover {
                background: #1d2a3a;
                box-shadow: 0 4px 20px rgba(15,22,33,0.28);
                transform: translateY(-1px);
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
        }

            .btn-gold:hover {
                background: #b8924f;
                box-shadow: 0 6px 28px rgba(201,169,110,0.40);
                transform: translateY(-2px);
            }

        .btn-outline-gold {
            background: transparent;
            color: var(--gold);
            border: 1.5px solid var(--gold);
        }

            .btn-outline-gold:hover {
                background: rgba(201,169,110,0.08);
            }

        .btn-lg {
            padding: 0.9rem 2rem;
            font-size: 0.96rem;
        }

        /* ── HERO ── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 8rem 3.5rem 5rem;
            overflow: hidden;
        }

        .hero-bg-pattern {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 70% 60% at 80% 40%, rgba(201,169,110,0.12) 0%, transparent 65%), radial-gradient(ellipse 50% 50% at 10% 80%, rgba(26,107,107,0.07) 0%, transparent 60%);
            z-index: 0;
        }

            .hero-bg-pattern::after {
                content: '';
                position: absolute;
                right: 8%;
                top: 15%;
                width: 420px;
                height: 420px;
                border-radius: 50%;
                border: 1px solid rgba(201,169,110,0.18);
                box-shadow: inset 0 0 0 40px rgba(201,169,110,0.04), inset 0 0 0 80px rgba(201,169,110,0.02);
            }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 580px;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(201,169,110,0.12);
            border: 1px solid rgba(201,169,110,0.28);
            color: #9A722E;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 100px;
            margin-bottom: 1.8rem;
            animation: fadeUp 0.6s ease both;
        }

        .hero-eyebrow-dot {
            width: 6px;
            height: 6px;
            background: var(--gold);
            border-radius: 50%;
        }

        .hero-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.8rem, 5vw, 4.2rem);
            line-height: 1.12;
            color: var(--ink);
            margin-bottom: 1.6rem;
            animation: fadeUp 0.6s 0.1s ease both;
        }

            .hero-title em {
                font-style: italic;
                color: var(--gold);
            }

        .hero-desc {
            font-size: 1.1rem;
            font-weight: 300;
            line-height: 1.75;
            color: var(--ink-60);
            max-width: 480px;
            margin-bottom: 2.6rem;
            animation: fadeUp 0.6s 0.2s ease both;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            animation: fadeUp 0.6s 0.3s ease both;
        }

        .hero-stats {
            position: absolute;
            right: 5%;
            bottom: 10%;
            z-index: 1;
            display: flex;
            gap: 1.5rem;
            animation: fadeUp 0.8s 0.5s ease both;
        }

        .stat-card {
            background: rgba(255,255,255,0.72);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(201,169,110,0.15);
            border-radius: var(--radius-lg);
            padding: 1.2rem 1.5rem;
            text-align: center;
            box-shadow: var(--shadow-sm);
        }

        .stat-number {
            font-family: 'DM Serif Display', serif;
            font-size: 1.9rem;
            color: var(--ink);
            line-height: 1;
        }

        .stat-label {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--ink-60);
            letter-spacing: 0.3px;
            margin-top: 4px;
        }

        /* ── CAROUSEL SECTION ── */
        .carousel-section {
            position: relative;
            z-index: 1;
            padding: 5rem 0;
            background: var(--ink);
            overflow: hidden;
        }

            .carousel-section::before {
                content: '';
                position: absolute;
                left: -5%;
                top: -30%;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.10) 0%, transparent 65%);
                pointer-events: none;
            }

        .carousel-header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
            z-index: 1;
        }

        .carousel-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: rgba(201,169,110,0.7);
            margin-bottom: 0.8rem;
        }

            .carousel-eyebrow::before, .carousel-eyebrow::after {
                content: '';
                display: block;
                width: 24px;
                height: 1px;
                background: rgba(201,169,110,0.4);
            }

        .carousel-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.8rem, 3vw, 2.4rem);
            color: var(--white);
            line-height: 1.2;
        }

            .carousel-title em {
                font-style: italic;
                color: var(--gold);
            }

        /* Main carousel */
        .carousel-wrapper {
            position: relative;
            z-index: 1;
        }

        .carousel-track-outer {
            overflow: hidden;
            margin: 0 3.5rem;
            border-radius: var(--radius-xl);
        }

        .carousel-track {
            display: flex;
            gap: 1.2rem;
            transition: transform 0.6s cubic-bezier(.4,0,.2,1);
        }

        .carousel-slide {
            min-width: calc(33.333% - 0.8rem);
            border-radius: var(--radius-xl);
            overflow: hidden;
            position: relative;
            aspect-ratio: 4/3;
            flex-shrink: 0;
        }

            .carousel-slide img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .carousel-slide:hover img {
                transform: scale(1.05);
            }

        .slide-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(15,22,33,0.75) 0%, transparent 55%);
        }

        .slide-info {
            position: absolute;
            bottom: 1.2rem;
            left: 1.2rem;
            right: 1.2rem;
        }

        .slide-tag {
            display: inline-block;
            background: rgba(201,169,110,0.25);
            border: 1px solid rgba(201,169,110,0.4);
            color: var(--gold-lt);
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 100px;
            margin-bottom: 0.4rem;
            backdrop-filter: blur(4px);
        }

        .slide-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--white);
            line-height: 1.3;
        }

        .slide-location {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.55);
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .slide-location svg {
                width: 11px;
                height: 11px;
            }

        /* Carousel controls */
        .carousel-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-top: 2rem;
        }

        .carousel-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s;
        }

            .carousel-btn:hover {
                background: var(--gold);
                border-color: var(--gold);
                color: var(--ink);
            }

            .carousel-btn svg {
                width: 18px;
                height: 18px;
            }

        .carousel-dots {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .carousel-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            cursor: pointer;
            transition: all .2s;
            border: none;
            padding: 0;
        }

            .carousel-dot.active {
                width: 20px;
                border-radius: 3px;
                background: var(--gold);
            }

        /* Auto-scroll strip */
        .carousel-strip {
            margin-top: 3rem;
            overflow: hidden;
            position: relative;
        }

            .carousel-strip::before,
            .carousel-strip::after {
                content: '';
                position: absolute;
                top: 0;
                bottom: 0;
                width: 120px;
                z-index: 2;
                pointer-events: none;
            }

            .carousel-strip::before {
                left: 0;
                background: linear-gradient(to right, var(--ink), transparent);
            }

            .carousel-strip::after {
                right: 0;
                background: linear-gradient(to left, var(--ink), transparent);
            }

        .strip-track {
            display: flex;
            gap: 1rem;
            animation: stripScroll 30s linear infinite;
            width: max-content;
        }

            .strip-track:hover {
                animation-play-state: paused;
            }

        @@keyframes stripScroll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        .strip-item {
            width: 220px;
            height: 130px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            flex-shrink: 0;
            position: relative;
        }

            .strip-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.4s;
            }

            .strip-item:hover img {
                transform: scale(1.08);
            }

        .strip-item-label {
            position: absolute;
            bottom: 8px;
            left: 10px;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--white);
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
        }

        /* ── SECTIONS ── */
        section {
            position: relative;
            z-index: 1;
        }

        .section-pad {
            padding: 6rem 3.5rem;
        }

        .label-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--teal);
            margin-bottom: 1rem;
        }

            .label-tag::before {
                content: '';
                display: block;
                width: 20px;
                height: 1.5px;
                background: var(--teal);
            }

        .section-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            line-height: 1.18;
            color: var(--ink);
            margin-bottom: 1rem;
        }

            .section-title em {
                font-style: italic;
                color: var(--gold);
            }

        .section-desc {
            font-size: 1.02rem;
            font-weight: 300;
            line-height: 1.72;
            color: var(--ink-60);
            max-width: 520px;
        }

        /* Features */
        .features-section {
            background: var(--white);
        }

        .features-header {
            max-width: 500px;
            margin-bottom: 4rem;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .feature-card {
            background: var(--cream);
            border: 1px solid rgba(201,169,110,0.14);
            border-radius: var(--radius-xl);
            padding: 2.2rem 1.8rem;
            transition: all .28s cubic-bezier(.4,0,.2,1);
        }

            .feature-card:hover {
                background: var(--white);
                border-color: rgba(201,169,110,0.35);
                box-shadow: var(--shadow-md);
                transform: translateY(-4px);
            }

            .feature-card.featured {
                background: var(--ink);
                border-color: var(--ink);
            }

                .feature-card.featured .feature-title {
                    color: var(--white);
                }

                .feature-card.featured .feature-desc {
                    color: rgba(255,255,255,0.55);
                }

                .feature-card.featured .feature-icon-wrap {
                    background: rgba(255,255,255,0.1);
                }

        .feature-icon-wrap {
            width: 48px;
            height: 48px;
            background: rgba(201,169,110,0.12);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.4rem;
            color: var(--gold);
        }

            .feature-icon-wrap svg {
                width: 22px;
                height: 22px;
            }

        .feature-card.featured .feature-icon-wrap {
            color: rgba(255,255,255,0.7);
        }

        .feature-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.18rem;
            color: var(--ink);
            margin-bottom: 0.6rem;
        }

        .feature-desc {
            font-size: 0.92rem;
            font-weight: 300;
            line-height: 1.65;
            color: var(--ink-60);
        }

        /* Steps */
        .steps-section {
            background: var(--cream);
        }

        .steps-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            margin-top: 4rem;
        }

        .step-item {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
            padding: 1.8rem 0;
            border-bottom: 1px solid var(--cream-dk);
            transition: all .2s;
        }

            .step-item:last-child {
                border-bottom: none;
            }

            .step-item:hover .step-num {
                background: var(--gold);
                color: var(--white);
                border-color: var(--gold);
            }

        .step-num {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            border: 1.5px solid var(--ink-30);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink-60);
            transition: all .2s;
        }

        .step-title {
            font-weight: 600;
            font-size: 1rem;
            color: var(--ink);
            margin-bottom: 0.3rem;
        }

        .step-desc {
            font-size: 0.9rem;
            font-weight: 300;
            color: var(--ink-60);
            line-height: 1.6;
        }

        .steps-visual-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 2rem;
            box-shadow: var(--shadow-lg);
            border: 1px solid rgba(201,169,110,0.12);
        }

        .dash-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .dash-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
        }

        .dash-badge {
            background: rgba(26,107,107,0.1);
            color: var(--teal);
            font-size: 0.72rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 100px;
        }

        .dash-rooms {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 1.2rem;
        }

        .dash-room {
            padding: 10px 8px;
            border-radius: 12px;
            font-size: 0.78rem;
            font-weight: 500;
            text-align: center;
        }

        .room-occ {
            background: rgba(26,107,107,0.1);
            color: var(--teal);
        }

        .room-free {
            background: rgba(201,169,110,0.12);
            color: #9A722E;
        }

        .room-maint {
            background: rgba(15,22,33,0.06);
            color: var(--ink-60);
        }

        .dash-metric-row {
            display: flex;
            gap: 10px;
        }

        .dash-metric {
            flex: 1;
            background: var(--cream);
            border-radius: 12px;
            padding: 12px;
        }

        .dash-metric-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.35rem;
            color: var(--ink);
        }

        .dash-metric-lbl {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* CTA */
        .cta-section {
            background: var(--ink);
            padding: 5rem 3.5rem;
            position: relative;
            overflow: hidden;
        }

            .cta-section::before {
                content: '';
                position: absolute;
                right: -5%;
                top: -30%;
                width: 500px;
                height: 500px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,169,110,0.12) 0%, transparent 65%);
                pointer-events: none;
            }

        .cta-inner {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 3rem;
            flex-wrap: wrap;
        }

        .cta-text .label-tag {
            color: rgba(201,169,110,0.6);
        }

            .cta-text .label-tag::before {
                background: rgba(201,169,110,0.4);
            }

        .cta-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.8rem, 3vw, 2.4rem);
            color: var(--white);
            line-height: 1.2;
        }

            .cta-title em {
                color: var(--gold);
                font-style: italic;
            }

        .cta-actions {
            display: flex;
            gap: 12px;
            flex-shrink: 0;
        }

        /* Footer */
        footer {
            background: var(--cream-dk);
            padding: 2.5rem 3.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(201,169,110,0.2);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-brand {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--ink);
        }

        .footer-copy {
            font-size: 0.82rem;
            color: var(--ink-30);
        }

        .footer-links {
            display: flex;
