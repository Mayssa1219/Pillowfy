            text-transform: uppercase;
        }

        .loyalty-pts {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--gold);
            line-height: 1;
        }

        .loyalty-pts-label {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.35);
            margin-top: 2px;
        }

        .loyalty-bar-wrap {
            margin-top: 1rem;
        }

        .loyalty-bar-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.68rem;
            color: rgba(255,255,255,0.3);
            margin-bottom: 5px;
        }

        .loyalty-bar {
            height: 5px;
            background: rgba(255,255,255,0.08);
            border-radius: 100px;
            overflow: hidden;
        }

        .loyalty-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), #e8c080);
            border-radius: 100px;
            transition: width .8s ease;
        }

        /* ── AVIS ── */
        .rating-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

        .star {
            font-size: 0.9rem;
        }

        .rating-hotel {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
        }

        .rating-date {
            font-size: 0.7rem;
            color: var(--ink-60);
            margin-left: auto;
        }

        .rating-comment {
            font-size: 0.78rem;
            color: var(--ink-60);
            line-height: 1.5;
        }

        .btn-sm-gold {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--gold-lt);
            color: #9A722E;
            border: 1px solid rgba(201,169,110,0.25);
            border-radius: 100px;
            padding: 5px 12px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .15s;
        }

            .btn-sm-gold:hover {
                background: var(--gold-mid);
            }

            .btn-sm-gold svg {
                width: 12px;
                height: 12px;
            }

        /* ── ANIMATIONS ── */
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
            }

            50% {
                box-shadow: 0 0 0 5px rgba(34,197,94,0.07);
            }
        }

        .badge-dot {
            animation: pulse 2s infinite;
        }

        .main > * {
            animation: fadeUp 0.38s ease both;
        }

            .main > *:nth-child(2) {
                animation-delay: 0.05s;
            }

            .main > *:nth-child(3) {
                animation-delay: 0.10s;
            }

            .main > *:nth-child(4) {
                animation-delay: 0.14s;
            }

            .main > *:nth-child(5) {
                animation-delay: 0.18s;
            }

            .main > *:nth-child(6) {
                animation-delay: 0.22s;
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 1100px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .main-grid-wide {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .main-grid, .main-grid-wide {
                grid-template-columns: 1fr;
            }

            .hero-card {
                flex-direction: column;
                gap: 1.2rem;
                align-items: flex-start;
            }

            .reservation-banner {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }
        }

        @@media (max-width: 600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
