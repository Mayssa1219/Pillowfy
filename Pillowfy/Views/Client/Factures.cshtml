@{
    ViewData["Title"] = "Factures";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pillowfy — Mes factures</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --gold: #C9A96E;
            --gold-lt: rgba(201,169,110,0.12);
            --gold-mid: rgba(201,169,110,0.25);
            --ink: #0F1621;
            --ink-60: rgba(15,22,33,0.60);
            --ink-30: rgba(15,22,33,0.30);
            --white: #FFFFFF;
            --teal: #1A6B6B;
            --teal-lt: rgba(26,107,107,0.10);
            --rose: #C0596A;
            --rose-lt: rgba(192,89,106,0.10);
            --sidebar: #0B1120;
            --bg: #F4F1EC;
            --radius-xl: 22px;
            --shadow-sm: 0 2px 12px rgba(15,22,33,0.06);
            --shadow-md: 0 8px 32px rgba(15,22,33,0.10);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: var(--sidebar);
            padding: 1.6rem 1.1rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            margin-bottom: 2rem;
        }

            .sidebar-brand img {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                object-fit: cover;
            }

        .sidebar-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
        }

        .sidebar-section-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 0 0.8rem;
            margin-bottom: 0.4rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 1.4rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.42);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all .16s;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.82);
            }

            .nav-item.active {
                background: rgba(201,169,110,0.14);
                color: var(--gold);
            }

        .nav-icon {
            width: 27px;
            height: 27px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            flex-shrink: 0;
        }

        .nav-item.active .nav-icon {
            background: rgba(201,169,110,0.18);
        }

        .nav-icon svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
        }

        .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1rem;
            margin-top: auto;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0.7rem 0.8rem;
            border-radius: 11px;
            background: rgba(255,255,255,0.04);
            margin-bottom: 0.55rem;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), #b8924f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.28);
            margin-top: 1px;
        }

        .btn-logout {
            width: 100%;
            padding: 0.55rem;
            border-radius: 9px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.32);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all .16s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .btn-logout:hover {
                border-color: rgba(220,38,38,0.4);
                color: #f87171;
                background: rgba(220,38,38,0.06);
            }

            .btn-logout svg {
                width: 13px;
                height: 13px;
            }

        /* MAIN */
        .main {
            margin-left: 240px;
            padding: 2rem 2.4rem;
            flex: 1;
            max-width: calc(100vw - 240px);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .topbar-left h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--ink);
        }

            .topbar-left h1 em {
                font-style: italic;
                color: var(--gold);
            }

        .topbar-left p {
            font-size: 0.83rem;
            color: var(--ink-60);
            margin-top: 3px;
        }

        /* STATS */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .stat-card {
            background: var(--white);
            border-radius: 16px;
            padding: 1.2rem 1.4rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .stat-icon.gold {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .stat-icon.teal {
                background: var(--teal-lt);
                color: var(--teal);
            }

            .stat-icon.green {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .stat-icon svg {
                width: 20px;
                height: 20px;
            }

        .stat-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--ink);
        }

        .stat-lbl {
            font-size: 0.74rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        /* TOOLBAR */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .filter-group {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 0.42rem 1rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            border: 1.5px solid rgba(15,22,33,0.12);
            background: transparent;
            color: var(--ink-60);
            transition: all .16s;
        }

            .filter-btn.active {
                background: var(--ink);
                color: var(--white);
                border-color: var(--ink);
            }

            .filter-btn:hover:not(.active) {
                border-color: var(--gold);
                color: var(--gold);
            }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--white);
            border: 1.5px solid rgba(15,22,33,0.10);
            border-radius: 100px;
            padding: 0.4rem 1rem;
        }

            .search-box input {
                border: none;
                background: transparent;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.82rem;
                color: var(--ink);
                outline: none;
                width: 160px;
            }

            .search-box svg {
                width: 14px;
                height: 14px;
                color: var(--ink-30);
                flex-shrink: 0;
            }

        /* TABLE */
        .card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: 1.5rem;
            border: 1px solid rgba(201,169,110,0.10);
            box-shadow: var(--shadow-sm);
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--ink-30);
            padding: 0.6rem 1rem;
            text-align: left;
            border-bottom: 1.5px solid rgba(15,22,33,0.07);
            white-space: nowrap;
        }

        tbody tr {
            transition: background .12s;
        }

            tbody tr:hover {
                background: var(--bg);
            }

        tbody td {
            padding: 1rem 1rem;
            border-bottom: 1px solid rgba(15,22,33,0.05);
            font-size: 0.84rem;
            color: var(--ink);
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .facture-num {
            font-family: 'DM Serif Display', serif;
            font-size: 0.9rem;
            color: var(--ink);
        }

        .facture-hotel {
            font-weight: 600;
            color: var(--ink);
            font-size: 0.84rem;
        }

        .facture-chambre {
            font-size: 0.72rem;
            color: var(--ink-60);
            margin-top: 2px;
        }

        .facture-date {
            font-size: 0.82rem;
            color: var(--ink-60);
            white-space: nowrap;
        }

        .facture-montant {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--ink);
            white-space: nowrap;
        }

        /* STATUT BADGE */
        .statut-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }

            .statut-badge.Confirme {
                background: rgba(34,197,94,0.10);
                color: #16a34a;
            }

            .statut-badge.EnAttente {
                background: var(--gold-lt);
                color: #9A722E;
            }

            .statut-badge.Echoue {
                background: var(--rose-lt);
                color: var(--rose);
            }

            .statut-badge.Rembourse {
                background: var(--teal-lt);
                color: var(--teal);
            }

        /* MÉTHODE */
        .methode-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.78rem;
            color: var(--ink-60);
        }

        .methode-ic {
            font-size: 0.9rem;
        }

        /* ACTIONS */
        .action-btn {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all .15s;
            background: var(--bg);
            color: var(--ink-60);
        }

            .action-btn:hover {
                background: var(--gold-lt);
                color: var(--gold);
            }

            .action-btn svg {
                width: 14px;
                height: 14px;
            }

        /* EMPTY */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            gap: 10px;
        }

        .empty-icon {
            font-size: 2.5rem;
        }

        .empty-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--ink);
        }

        .empty-sub {
            font-size: 0.82rem;
            color: var(--ink-60);
        }

        /* SKELETON */
        .skeleton {
            background: linear-gradient(90deg,rgba(15,22,33,0.06) 25%,rgba(15,22,33,0.10) 50%,rgba(15,22,33,0.06) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 8px;
        }

        /* MODAL DÉTAIL */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,22,33,0.55);
            backdrop-filter: blur(4px);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal {
            background: var(--white);
            border-radius: var(--radius-xl);
            width: 100%;
            max-width: 480px;
            box-shadow: 0 24px 60px rgba(15,22,33,0.18);
            animation: fadeUp 0.25s ease;
            overflow: hidden;
        }

        .modal-header {
            background: var(--ink);
            padding: 1.6rem 1.8rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-header-left {
        }

        .modal-fac-num {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

        .modal-fac-date {
            font-size: 0.74rem;
            color: rgba(255,255,255,0.38);
            margin-top: 3px;
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.5);
            transition: all .16s;
        }

            .modal-close:hover {
                background: rgba(255,255,255,0.15);
                color: var(--white);
            }

            .modal-close svg {
                width: 15px;
                height: 15px;
            }

        .modal-body {
            padding: 1.6rem 1.8rem;
        }

        .modal-section-title {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--ink-30);
            margin-bottom: 0.8rem;
        }

        .modal-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.55rem 0;
            border-bottom: 1px solid rgba(15,22,33,0.05);
        }

            .modal-row:last-child {
                border-bottom: none;
            }

        .modal-lbl {
            font-size: 0.8rem;
            color: var(--ink-60);
        }

        .modal-val {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink);
        }

        .modal-total {
            background: var(--bg);
            border-radius: 13px;
            padding: 1rem 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }

        .modal-total-lbl {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--ink);
        }

        .modal-total-val {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--gold);
        }

        .modal-footer {
            padding: 1rem 1.8rem 1.6rem;
            display: flex;
            gap: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.58rem 1.2rem;
            border-radius: 100px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .18s;
            text-decoration: none;
        }

            .btn svg {
                width: 13px;
                height: 13px;
            }

        .btn-gold {
            background: var(--gold);
            color: var(--ink);
            flex: 1;
            justify-content: center;
        }

            .btn-gold:hover {
                background: #b8924f;
            }

        .btn-outline {
            background: transparent;
            color: var(--ink-60);
            border: 1px solid rgba(15,22,33,0.15);
        }

            .btn-outline:hover {
                background: rgba(15,22,33,0.05);
            }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            background: var(--ink);
            color: var(--white);
            border-radius: 13px;
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.84rem;
            font-weight: 500;
            box-shadow: var(--shadow-md);
            opacity: 0;
            transform: translateY(10px);
            transition: all .3s;
            pointer-events: none;
        }

            .toast.show {
                opacity: 1;
                transform: translateY(0);
            }

            .toast.success {
                border-left: 3px solid #22c55e;
            }

            .toast.error {
                border-left: 3px solid var(--rose);
            }

            .toast svg {
                width: 16px;
                height: 16px;
            }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0
            }

            100% {
                background-position: -200% 0
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .main > * {
            animation: fadeUp 0.38s ease both;
        }

            .main > *:nth-child(2) {
                animation-delay: 0.05s;
            }

            .main > *:nth-child(3) {
                animation-delay: 0.10s;
            }

            .main > *:nth-child(4) {
                animation-delay: 0.14s;
            }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.4rem;
                max-width: 100vw;
            }
        }

        @@media (max-width: 600px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            thead th:nth-child(3), tbody td:nth-child(3) {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <img src="/Images/logo.png" alt="Pillowfy">
                <span class="sidebar-brand-name">Pillowfy</span>
            </a>
            <div class="sidebar-content">
                <div class="sidebar-section-label">Navigation</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Dashboard" class="nav-item"><span class="nav-icon"><i data-lucide="layout-dashboard"></i></span> Dashboard</a>
                    <a href="/Client/ListeHotels" class="nav-item"><span class="nav-icon"><i data-lucide="building-2"></i></span> Hôtels</a>
                    <a href="/Client/ListeReservations" class="nav-item"><span class="nav-icon"><i data-lucide="calendar-check"></i></span> Mes réservations</a>
                    <a href="/Client/Sejours" class="nav-item"><span class="nav-icon"><i data-lucide="bed-double"></i></span> Historique séjours</a>
                    <a href="/Client/Factures" class="nav-item active"><span class="nav-icon"><i data-lucide="receipt"></i></span> Factures</a>
                    <a href="/Client/Services" class="nav-item"><span class="nav-icon"><i data-lucide="concierge-bell"></i></span> Services</a>
                </nav>
                <div class="sidebar-section-label">Compte</div>
                <nav class="sidebar-nav">
                    <a href="/Client/Profil" class="nav-item"><span class="nav-icon"><i data-lucide="user"></i></span> Mon profil</a>
                    <a href="/Client/Fidelite" class="nav-item"><span class="nav-icon"><i data-lucide="star"></i></span> Fidélité</a>
                    <a href="/Client/Avis" class="nav-item"><span class="nav-icon"><i data-lucide="message-circle"></i></span> Mes avis</a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar" id="avatarInitial">?</div>
                    <div>
                        <div class="user-name" id="userName">Chargement...</div>
                        <div class="user-role" id="userRole">Client</div>
                    </div>
                </div>
                <button class="btn-logout" onclick="logout()"><i data-lucide="log-out"></i> Déconnexion</button>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="topbar">
                <div class="topbar-left">
                    <h1>Mes <em>factures</em></h1>
                    <p id="dateLabel"></p>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-icon gold"><i data-lucide="receipt"></i></div>
                    <div><div class="stat-val" id="statTotal">—</div><div class="stat-lbl">Factures au total</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green"><i data-lucide="check-circle"></i></div>
                    <div><div class="stat-val" id="statConfirme">—</div><div class="stat-lbl">Paiements confirmés</div></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon teal"><i data-lucide="coins"></i></div>
                    <div><div class="stat-val" id="statMontant">—</div><div class="stat-lbl">Total dépensé</div></div>
                </div>
            </div>

            <!-- TOOLBAR -->
            <div class="toolbar">
                <div class="filter-group">
                    <button class="filter-btn active" onclick="setFilter('all', this)">Tous</button>
                    <button class="filter-btn" onclick="setFilter('Confirme', this)">✓ Confirmé</button>
                    <button class="filter-btn" onclick="setFilter('EnAttente', this)">⏳ En attente</button>
                    <button class="filter-btn" onclick="setFilter('Rembourse', this)">↩ Remboursé</button>
                </div>
                <div class="search-box">
                    <i data-lucide="search"></i>
                    <input type="text" id="searchInput" placeholder="Hôtel, chambre…" oninput="renderTable()">
                </div>
            </div>

            <!-- TABLE -->
            <div class="card">
                <!-- SKELETON -->
                <div id="tableSkeleton">
                    <div class="skeleton" style="height:44px;margin-bottom:8px;"></div>
                    <div class="skeleton" style="height:64px;margin-bottom:6px;border-radius:10px;"></div>
                    <div class="skeleton" style="height:64px;margin-bottom:6px;border-radius:10px;"></div>
                    <div class="skeleton" style="height:64px;border-radius:10px;"></div>
                </div>

                <div class="table-wrap" id="tableWrap" style="display:none;">
                    <table>
                        <thead>
                            <tr>
                                <th>N° Facture</th>
                                <th>Hôtel / Chambre</th>
                                <th>Date paiement</th>
                                <th>Méthode</th>
                                <th>Statut</th>
                                <th>Montant</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tableBody"></tbody>
                    </table>
                    <div class="empty-state" id="emptyState" style="display:none;">
                        <div class="empty-icon">🧾</div>
                        <div class="empty-title">Aucune facture trouvée</div>
                        <div class="empty-sub">Essayez un autre filtre ou effectuez une réservation.</div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- MODAL DÉTAIL FACTURE -->
    <div class="modal-overlay" id="modalDetail">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-header-left">
                    <div class="modal-fac-num" id="modalFacNum">—</div>
                    <div class="modal-fac-date" id="modalFacDate">—</div>
                </div>
                <button class="modal-close" onclick="closeModal()"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <div class="modal-section-title">Détails du séjour</div>
                <div class="modal-row"><span class="modal-lbl">Hôtel</span><span class="modal-val" id="modalHotel">—</span></div>
                <div class="modal-row"><span class="modal-lbl">Chambre</span><span class="modal-val" id="modalChambre">—</span></div>
                <div class="modal-row"><span class="modal-lbl">Réservation</span><span class="modal-val" id="modalResId">—</span></div>
                <div style="margin-top:1.2rem;" class="modal-section-title">Paiement</div>
                <div class="modal-row"><span class="modal-lbl">Date</span><span class="modal-val" id="modalDate">—</span></div>
                <div class="modal-row"><span class="modal-lbl">Méthode</span><span class="modal-val" id="modalMethode">—</span></div>
                <div class="modal-row"><span class="modal-lbl">Statut</span><span class="modal-val" id="modalStatut">—</span></div>
                <div class="modal-total">
                    <span class="modal-total-lbl">Total TTC</span>
                    <span class="modal-total-val" id="modalMontant">— €</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal()"><i data-lucide="x"></i> Fermer</button>
                <button class="btn btn-gold" id="modalDownloadBtn" onclick="downloadFromModal()">
                    <i data-lucide="download"></i> Télécharger la facture
                </button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"><i data-lucide="check-circle" id="toastIcon"></i><span id="toastMsg"></span></div>

    <script>
        /* ══════════════════════════════════════
           SESSION
        ══════════════════════════════════════ */
        const SESSION = {
            TOKEN_KEY: 'pillowfy_token', COOKIE_NAME: 'token', LOGIN_URL: '/Login/Index',
            CLAIMS: {
                name:  'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name',
                email: 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
                role:  'http://schemas.microsoft.com/ws/2008/06/identity/claims/role'
            },
            getToken()  { return this._readCookie(this.COOKIE_NAME) || localStorage.getItem(this.TOKEN_KEY); },
            parseJwt(t) { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); } catch { return null; } },
            clearSession() { localStorage.removeItem(this.TOKEN_KEY); document.cookie = `${this.COOKIE_NAME}=; Max-Age=0; path=/; SameSite=Strict`; },
            redirectLogin(r) { this.clearSession(); window.location.href = this.LOGIN_URL + '?reason=' + r; },
            _readCookie(n) { const m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)')); return m ? decodeURIComponent(m[2]) : null; }
        };

        /* ══════════════════════════════════════
           ÉTAT
        ══════════════════════════════════════ */
        let allPaiements  = [];
        let currentFilter = 'all';
        let currentModal  = null;

        const fmt     = d => new Date(d).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
        const fmtShort= d => new Date(d).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
        const facNum  = p => `FAC-${new Date(p.datePaiement).getFullYear()}-${String(p.id).padStart(4,'0')}`;

        const METHODE_ICONS = {
            CarteBancaire: { ic: '💳', label: 'Carte bancaire' },
            Virement:      { ic: '🏦', label: 'Virement' },
            Especes:       { ic: '💵', label: 'Espèces' },
            PayPal:        { ic: '🅿️', label: 'PayPal' }
        };

        const STATUT_LABELS = {
            Confirme:  { label: '✓ Confirmé',   cls: 'Confirme' },
            EnAttente: { label: '⏳ En attente', cls: 'EnAttente' },
            Echoue:    { label: '✕ Échoué',     cls: 'Echoue' },
            Rembourse: { label: '↩ Remboursé',  cls: 'Rembourse' }
        };

        /* ══════════════════════════════════════
           DATE LABEL
        ══════════════════════════════════════ */
        (function () {
            const now = new Date();
            const j = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
            const m = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
            document.getElementById('dateLabel').textContent = j[now.getDay()] + ' ' + now.getDate() + ' ' + m[now.getMonth()] + ' ' + now.getFullYear();
        })();

        /* ══════════════════════════════════════
           INIT
        ══════════════════════════════════════ */
        async function init() {
            if (typeof lucide === 'undefined') { setTimeout(init, 50); return; }
            lucide.createIcons();

            const token = SESSION.getToken();
            if (!token) { SESSION.redirectLogin('no_token'); return; }
            const p = SESSION.parseJwt(token);
            if (!p)   { SESSION.redirectLogin('invalid'); return; }

            const fn = (p[SESSION.CLAIMS.name] || '').split(' ')[0] || 'Client';
            document.getElementById('userName').textContent      = p[SESSION.CLAIMS.name] || p[SESSION.CLAIMS.email] || '';
            document.getElementById('userRole').textContent      = p[SESSION.CLAIMS.role] || 'Client';
            document.getElementById('avatarInitial').textContent = fn.charAt(0).toUpperCase();

            await loadPaiements(token);
        }

        /* ══════════════════════════════════════
           CHARGER PAIEMENTS
        ══════════════════════════════════════ */
               async function loadPaiements(token) {
            try {
                console.log('🔑 Token:', token ? token.substring(0, 30) + '...' : 'ABSENT');

                const res = await fetch('/api/paiement/mes-paiements', {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });

                console.log('📡 Status:', res.status, res.statusText);

                if (res.status === 401) { SESSION.redirectLogin('unauthorized'); return; }
                if (!res.ok) {
                    const errText = await res.text();
                    console.error('❌ Erreur réponse:', errText);
                    throw new Error(errText);
                }

                const data = await res.json();
                console.log('✅ Données reçues:', data);
                allPaiements = data;
                renderStats();
                renderTable();

            } catch(e) {
                console.error('💥 Exception:', e);
                showToast('Impossible de charger les factures.', 'error');
            } finally {
                document.getElementById('tableSkeleton').style.display = 'none';
                document.getElementById('tableWrap').style.display     = 'block';
                lucide.createIcons();
            }
        }

        /* ══════════════════════════════════════
           STATS
        ══════════════════════════════════════ */
        function renderStats() {
            const confirmes = allPaiements.filter(p => p.statut === 'Confirme');
            const montant   = confirmes.reduce((s, p) => s + p.montant, 0);

            document.getElementById('statTotal').textContent    = allPaiements.length;
            document.getElementById('statConfirme').textContent = confirmes.length;
            document.getElementById('statMontant').textContent  = montant.toLocaleString('fr-FR') + ' €';
        }

        /* ══════════════════════════════════════
           FILTRE
        ══════════════════════════════════════ */
        function setFilter(val, btn) {
            currentFilter = val;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderTable();
        }

        /* ══════════════════════════════════════
           RENDER TABLE
        ══════════════════════════════════════ */
        function renderTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const tbody  = document.getElementById('tableBody');
            const empty  = document.getElementById('emptyState');

            let data = allPaiements;
            if (currentFilter !== 'all') data = data.filter(p => p.statut === currentFilter);
            if (search) data = data.filter(p =>
                (p.hotelName  || '').toLowerCase().includes(search) ||
                (p.chambreName|| '').toLowerCase().includes(search) ||
                facNum(p).toLowerCase().includes(search)
            );

            if (!data.length) {
                tbody.innerHTML = '';
                empty.style.display = 'flex';
                return;
            }
            empty.style.display = 'none';

            const methodeMap = { CarteBancaire:'💳 Carte', Virement:'🏦 Virement', Especes:'💵 Espèces', PayPal:'🅿️ PayPal' };

            tbody.innerHTML = data.map(p => {
                const num    = facNum(p);
                const statut = STATUT_LABELS[p.statut] || { label: p.statut, cls: 'EnAttente' };
                const methode = methodeMap[p.methode] || p.methode;
                return `
                    <tr>
                        <td><div class="facture-num">${num}</div></td>
                        <td>
                            <div class="facture-hotel">${p.hotelName || '—'}</div>
                            <div class="facture-chambre">${p.chambreName || '—'}</div>
                        </td>
                        <td><div class="facture-date">${fmtShort(p.datePaiement)}</div></td>
                        <td><div class="methode-badge">${methode}</div></td>
                        <td><span class="statut-badge ${statut.cls}">${statut.label}</span></td>
                        <td><div class="facture-montant">${p.montant.toLocaleString('fr-FR')} €</div></td>
                        <td style="display:flex;gap:4px;">
                            <button class="action-btn" title="Voir détail" onclick="openModal(${p.id})">
                                <i data-lucide="eye"></i>
                            </button>
                            <button class="action-btn" title="Télécharger" onclick="downloadInvoice(${p.reservationId})">
                                <i data-lucide="download"></i>
                            </button>
                        </td>
                    </tr>`;
            }).join('');

            lucide.createIcons();
        }

        /* ══════════════════════════════════════
           MODAL DÉTAIL
        ══════════════════════════════════════ */
        function openModal(id) {
            const p = allPaiements.find(x => x.id === id);
            if (!p) return;
            currentModal = p;

            const statut  = STATUT_LABELS[p.statut] || { label: p.statut, cls: 'EnAttente' };
            const methode = (METHODE_ICONS[p.methode] || { ic:'💳', label: p.methode });

            document.getElementById('modalFacNum').textContent   = facNum(p);
            document.getElementById('modalFacDate').textContent  = fmt(p.datePaiement);
            document.getElementById('modalHotel').textContent    = p.hotelName   || '—';
            document.getElementById('modalChambre').textContent  = p.chambreName || '—';
            document.getElementById('modalResId').textContent    = '#RES-' + String(p.reservationId).padStart(4,'0');
            document.getElementById('modalDate').textContent     = fmt(p.datePaiement);
            document.getElementById('modalMethode').textContent  = methode.ic + ' ' + methode.label;
            document.getElementById('modalStatut').innerHTML     = `<span class="statut-badge ${statut.cls}">${statut.label}</span>`;
            document.getElementById('modalMontant').textContent  = p.montant.toLocaleString('fr-FR') + ' €';

            document.getElementById('modalDetail').classList.add('show');
            lucide.createIcons();
        }

        function closeModal() {
            document.getElementById('modalDetail').classList.remove('show');
            currentModal = null;
        }

        function downloadFromModal() {
            if (currentModal) downloadInvoice(currentModal.reservationId);
        }

        /* ══════════════════════════════════════
           TÉLÉCHARGER FACTURE
        ══════════════════════════════════════ */
        async function downloadInvoice(reservationId) {
            try {
                const token = SESSION.getToken();
                const res   = await fetch(`/api/reservations/${reservationId}/invoice`, {
                    headers: { 'Authorization': 'Bearer ' + token },
                    credentials: 'include'
                });
                if (!res.ok) { showToast('Facture indisponible.', 'error'); return; }
                const blob = await res.blob();
                const url  = URL.createObjectURL(blob);
                const a    = document.createElement('a');
                a.href = url; a.download = `facture-${reservationId}.txt`; a.click();
                URL.revokeObjectURL(url);
                showToast('Facture téléchargée !', 'success');
            } catch {
                showToast('Erreur lors du téléchargement.', 'error');
            }
        }

        /* ══════════════════════════════════════
           HELPERS
        ══════════════════════════════════════ */
        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            document.getElementById('toastIcon').setAttribute('data-lucide', type === 'success' ? 'check-circle' : 'alert-circle');
            t.className = 'toast ' + type;
            lucide.createIcons();
            requestAnimationFrame(() => t.classList.add('show'));
            setTimeout(() => t.classList.remove('show'), 4000);
        }

        async function logout() {
            try {
                const token = SESSION.getToken();
                if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'include' }).catch(() => {});
            } finally {
                SESSION.clearSession();
                window.location.href = SESSION.LOGIN_URL;
            }
        }

        // Fermer modal en cliquant dehors
        document.getElementById('modalDetail').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    </script>
</body>
</html>